#!/bin/sh
# ============================================================
# pre-commit：编码与完整性闸门（2026-10，E-2026-355 事故防范）
# ============================================================
#
# 为什么放在这里：`docs/ERRORS-LOG.md` 里的"预防"是**给人读的历史**，跨会话不生效——
# 同一个坑（用 shell 原地改写含中文的源码 ⇒ UTF-8 被按 GBK 解码 ⇒ 全文报废）在
# E-2026-159 与 E-2026-355 踩了两次。**提交时机器检查**才是有效的防线：
# 只要有任何文件被这么毁过，本次提交直接被拒。
#
# 检查内容见 scripts/check-encoding.mjs：严格 UTF-8 解码 + 替换字符 U+FFFD + BOM。
# 绕过方式（确有必要时）：`git commit --no-verify`。

node scripts/check-encoding.mjs || {
  echo ""
  echo "❌ 提交被拒绝：源码/文档编码检查未通过（见上方详情）。"
  echo "   常见原因：用 shell（Get-Content | Set-Content 等）原地改写了含中文的文件。"
  echo "   正确做法：只用编辑器/工具改文件；已被破坏的文件立即 git checkout 恢复，不要尝试修复。"
  exit 1
}
