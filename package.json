{
  "name": "ijipu",
  "private": true,
  "version": "0.32.0",
  "license": "AGPL-3.0",
  "author": "蜗牛🐌 <snail.zh@qq.com>",
  "description": "iJipu（爱记谱）—— 下一代代码式简谱制谱引擎。码即成，谱自现。",
  "type": "module",
  "scripts": {
    "gen:info": "node scripts/gen-build-info.mjs",
    "dev": "npm run gen:info && vite",
    "build": "npm run gen:info && tsc -b && vite build && node scripts/stamp-sw.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "vite build --config vite.smoke.config.ts && node dist-smoke/smoke.cjs",
    "release:body": "node scripts/release-body.mjs",
    "preview:render": "vite build --config vite.smoke.config.ts && node dist-smoke/preview.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:installer": "node scripts/check-installer.mjs",
    "postinstall": "node scripts/patch-vite.js"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.14",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
