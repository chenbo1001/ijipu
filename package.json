{
  "name": "ijipu",
  "private": true,
  "version": "0.57.0",
  "license": "AGPL-3.0",
  "author": "蜗牛🐌 <snail.zh@qq.com>",
  "description": "iJipu（爱记谱）—— 下一代代码式简谱制谱引擎。码即成，谱自现。",
  "type": "module",
  "scripts": {
    "gen:info": "node scripts/gen-build-info.mjs",
    "dev": "npm run gen:info && vite",
    "build": "npm run gen:info && tsc -b && vite build && node scripts/stamp-sw.mjs",
    "lint": "oxlint",
    "check:encoding": "node scripts/check-encoding.mjs",
    "preview": "vite preview",
    "verify:site": "node --check scripts/verify-site.mjs && node scripts/verify-site.mjs",
    "smoke": "npm run check:encoding && npm run cli:typecheck && npm run cli:build && vite build --config vite.smoke.config.ts && node dist-smoke/smoke.cjs && node dist-smoke/cli-assert.cjs",
    "release:body": "node scripts/release-body.mjs",
    "build:embed": "npm run gen:info && node scripts/embed-assets.mjs && tsc -b && vite build --config vite.config.embed.mjs",
    "smoke:embed": "node scripts/embed-smoke.mjs",
    "preview:render": "vite build --config vite.smoke.config.ts && node dist-smoke/preview.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:installer": "node scripts/check-installer.mjs",
    "postinstall": "node scripts/patch-vite.js",
    "cli": "npm run cli:build && node packages/ijipu-cli/dist/ijipu.cjs",
    "cli:build": "vite build --config packages/ijipu-cli/vite.config.ts",
    "cli:typecheck": "tsc -p packages/ijipu-cli/tsconfig.json",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "smoke:cli": "vite build --config vite.smoke.config.ts && node dist-smoke/cli-assert.cjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.14",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
