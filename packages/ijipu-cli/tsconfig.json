{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/cli.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@ijipu/engine": ["../ijipu-engine/src/engine/index.ts"],
      "@ijipu/engine/*": ["../ijipu-engine/src/engine/*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
