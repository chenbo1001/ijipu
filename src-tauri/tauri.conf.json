{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iJipu",
  "version": "0.34.0",
  "identifier": "com.ijipu.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "爱记谱 iJipu",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "蜗牛🐌",
    "copyright": "© 蜗牛🐌 · iJipu（爱记谱）· AGPL-3.0",
    "shortDescription": "代码式简谱制谱引擎",
    "fileAssociations": [
      {
        "ext": ["jps"],
        "name": "iJipu.jps",
        "description": "简谱工程文件",
        "role": "Editor",
        "mimeType": "application/x-jps"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll",
      "../resources/soundfonts/generaluser_gs.sf2": "generaluser_gs.sf2"
    }
  }
}
