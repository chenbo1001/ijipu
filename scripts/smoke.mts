      /const withSep = `\$\{prefix\}\/`/.test(wsSrc) &&
      (() => {
        const hits = [
          { name: 'x.jps', relPath: 'A/x.jps', dirSegs: ['A'] },
          { name: 'y.jps', relPath: 'A/B/y.jps', dirSegs: ['A', 'B'] },
