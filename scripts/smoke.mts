   * adj925：真源与文档示例**同键、不同值**——这条改成明写这件事，而不是"两边必须同值"。
   * 真源（`public/samples/茉莉花.jps`）里写着 `3`，那是**用户手上未提交的改动**（本轮不碰）；
   * 文档示例按"末行 2 小节也要贴右"改成 `2`。判据：真源**确实写了这个键**（说明这个设置真的在谱里用着）
   * ＋ 文档示例逐字是 `2`。
   */
  check('adj921/adj925 真源《茉莉花》确实自带 `align_min_bars`（键在、真源值 3 —— 用户未提交的改动，本轮不动）',
    /"align_min_bars"\s*:\s*3/.test(pgRead('public/samples/茉莉花.jps')),
    pgRead('public/samples/茉莉花.jps').match(/# jps-config:.*/)?.[0] ?? '（真源里没有设置行）')
  for (const f of PG_DOCS) {
    const md = pgRead(f)
    const body = pgBodyOf(md)
    check(`adj921/adj925 ${f}：可调示例自带 ${ADJ921_LINE}（新口径下要"末行也贴右"就得写 ≤ 末行小节数 2）`,
      adj921HasLine(body), body.split('\n').filter((l) => l.startsWith('# jps-config')).join(' / ') || '（没有设置行）')
    /** 负对照：只在**字符串**上删掉这一行（不碰文件）⇒ 同一条判据必须为假 */
    const noLine = body.split('\n').filter((l) => l !== ADJ921_LINE).join('\n')
    check(`adj921/adj925 负对照 ${f}：把这一行从字符串里去掉 ⇒ 判据为假（说明它真的在判这一行，不是恒真）`,
      body !== noLine && !adj921HasLine(noLine) && adj921HasLine(body),
      `去掉后仍含这几行：${noLine.split('\n').filter((l) => l.startsWith('# jps-config')).join(' / ') || '（无）'}`)
    const parsed921 = parseJps(body)
    check(`adj921/adj925 ${f}：这段示例**解析零错误零告警**（含设置行自身的校验：顶格 + JSON 对象 + 键名认得）`,
      parsed921.errors.length === 0, JSON.stringify(parsed921.errors.slice(0, 3)))
    /** 行为层：带上 / 去掉这一行，各排一次版 —— 贴右的行数必须**变多** */
    const geomWith = adj921Geom(body)
    const geomWithout = adj921Geom(noLine)
    const stuckWith = adj921StuckRows(geomWith)
    const stuckWithout = adj921StuckRows(geomWithout)
    // 把**每行末线 x** 打出来：判据"过"与"留白多少"都要能被人看到，不只靠一个 ✓
    console.log(`    · ${f} 实测（页右界 ${geomWith.rightEdge.toFixed(2)}）：带这一行 ⇒ 贴右 ${stuckWith}/${geomWith.rights.length} 行，每行末线 x = [${geomWith.rights.map((x) => x.toFixed(2)).join(', ')}]`)
    console.log(`    · ${f} 去掉这一行（退回默认 4）⇒ 贴右 ${stuckWithout}/${geomWithout.rights.length} 行，每行末线 x = [${geomWithout.rights.map((x) => x.toFixed(2)).join(', ')}]`)
    check(`adj921/adj925 ${f}：这一行**真的在起作用**（带上它后末线贴右的行数增多，不是"写了等于没写"）`,
      stuckWith > stuckWithout, `带 ${stuckWith} 行 / 不带 ${stuckWithout} 行`)
    /**
     * adj925 追加：**末行也贴右**（这正是把 3 改成 2 的目的）——5 行全部 ≥ 2 ⇒ 5 行全贴右。
     * 容差 3px（**不能沿用上面 `adj921StuckRows` 的 0.6px**）：末行是 `||` 终止线，
     * 半宽 1.1（`|` 只有 0.55）⇒ 它的钳制落点本来就离右界更远，实测末线 543.30（离右界 1.98px）。
     */
    const nearRight = geomWith.rights.filter((x) => geomWith.rightEdge - x < 3).length
    check(`adj921/adj925 ${f}：新值 2 下**每一行都贴右（含只有 2 小节的末行）**—— 这就是 3 → 2 的目的`,
      geomWith.rights.length >= 5 && nearRight === geomWith.rights.length,
      `贴右 ${nearRight}/${geomWith.rights.length}（末线 x = [${geomWith.rights.map((x) => x.toFixed(2)).join(', ')}]）`)
    /**
     * adj925 追加：**墨迹盒高度不因这一行的值而变**（护住 `verify-site.mjs` 的 `adj916` 阈值
     * 「`v=s` 实测 SVG 视框高度 ≥ 300」）—— 3 与 2 只改**行内横向分配**，行数不变 ⇒ 高度不变。
     * 这里在 Node 里直接量墨迹盒（浏览器那条断言本会话跑不了，用这条等价的机器闸门兜住）。
     */
    const hOf = (src: string): number => {
      const box = inkBoxOfLayout(layoutScore(parseJps(src), mergeJpsConfig(src, defaultPageConfig)))
      return box ? box.h : 0
    }
    const h2 = hOf(body)
    const h3 = hOf(body.replace(ADJ921_LINE, '# jps-config:{"align_min_bars":3}'))
    console.log(`    · ${f} 墨迹盒高实测：align_min_bars=2 ⇒ ${h2.toFixed(2)}pt；=3 ⇒ ${h3.toFixed(2)}pt（adj916 的浏览器阈值量的是同一个高度）`)
    check(`adj921/adj925 ${f}：align_min_bars 只改行内横向分配 —— 墨迹盒高度 2 与 3 逐值相同（adj916 的 ≥300 阈值不受影响）`,
      h2 > 0 && Math.abs(h2 - h3) < 1e-6, `2 ⇒ ${h2.toFixed(4)} / 3 ⇒ ${h3.toFixed(4)}`)
  }

  // ---- adj883：首页示例精简 ----
  const raw = '#===== 描述头定义 =====\nV: 1.0\nB: 试\nQ: 1 2 |\n# jps-config:{"note_size":15}\n'
  const slim = simplifyJps(raw)
  check('adj883 simplifyJps：删掉 `# jps-config:{…}`（新手第一眼最劝退的那行）', !slim.includes('jps-config'))
  check('adj883 simplifyJps：删掉装饰性分隔注释', !slim.includes('====='))
  check('adj883 simplifyJps：**保留**描述头与曲行（不许把正文一起删了）',
    slim.includes('V: 1.0') && slim.includes('B: 试') && slim.includes('Q: 1 2 |'), JSON.stringify(slim))
  for (const s of BRAND_SAMPLES) {
    check(`adj883/adj892 首页示例「${s.label}」：含曲行，且配置里**只留白名单项**`,
      // 曲行判据要认 `Q:` 与 `Q1:` / `Q2:`（多声部示例用的是带编号的形式）
      /^Q\d*\s*:/m.test(s.src) &&
        // 冗长项必须剥掉（否则就不叫"精简"了）
        !s.src.includes('geci_font') && !s.src.includes('metaPos') && !s.src.includes('margin_') &&
        // 除可能保留的那一行 jps-config 外，不许再有别的配置行
        (s.src.match(/# jps-config:/g) ?? []).length <= 1,
      s.src.slice(0, 60).replace(/\n/g, '⏎'))
  }
  /**
   * adj892（用户反馈）：「首页示例的茉莉花应加个 **两端对齐最小小节:3** 的配置，
   * 否则显示不会两边对齐」—— 这条**纠正了 adj883"整行删掉 `# jps-config`"的做法**：
   * `align_min_bars` 决定**末行**会不会两端对齐（adj925 起：非末行恒撑满），删了就退回默认 4，
   * 而首页示例的茉莉花每行各自是一个 `Q:` 组（都是"单行曲部"= 末行）⇒ 那些 3 小节的行会按 4 判、不撑满。
   * ⚠ 首页示例的值来自**真源** `public/samples/茉莉花.jps`（`KEEP_CONFIG_KEYS` 白名单保留）——
   * 真源现在是用户手上**未提交**的 `3`，本轮**不碰**；文档可调示例那一份按 adj925 改成了 `2`（见上）。
   */
  const molySample = BRAND_SAMPLES.find((s) => s.label.startsWith('茉莉花'))
  check('adj892 首页示例「茉莉花」：保留了 `align_min_bars`（删了就不会两端对齐）',
    molySample?.src.includes('"align_min_bars":3') === true,
    molySample?.src.match(/# jps-config:.*/)?.[0] ?? '（没有配置行）')
  check('adj892 保留的是**真源里的真值**（不是我们编的）：茉莉花.jps 原文含 "align_min_bars":3',
    String(readFileSync(join(root, 'public', 'samples', '茉莉花.jps'), 'utf8')).includes('"align_min_bars":3'))
  /**
   * adj893（用户要求）：示例里的描述头 `S:` 去掉 ——
   * 两份原文都写着 `S: 本乐谱使用「爱记谱」编制`，放在示例谱面上是自述冗余。
   * （当时用户口径：`public/samples/*.jps` 原文的 `S:` 由他自己决定留不留，本轮"只精简首页副本"。）
   * ⚠ **adj919 起口径更新**：用户确认"一并去掉"，那两份**原文**（茉莉花 / 送别）的 `S:` 行
   * **已经删掉**了 —— "新建模板 + 两份样例谱都不含描述头 `S:`"由 `adj919` 的组断言统一守着。
   * 本条判据仍然有意义：`simplifyJps` 是**通用过滤器**，日后有人往 `public/samples/*.jps`
   * 里新加一份带 `S:` 的谱时，首页副本仍必须被它滤掉。
   *
   * ⚠ 验证"过滤行为本身"用**构造输入**，**刻意不依赖真源内容**：
   * 原来那版负对照写的是"两份真源里确实有 `S:`"——那是把两件不相干的事绑在一起，
   * 真源那行一被去掉，这条判据就会莫名其妙地红（adj919 这轮正好印证了这个判断）。
   */
  for (const s of BRAND_SAMPLES) {
    check(`adj893 首页示例「${s.label}」：不带描述头 \`S:\``, !/^\s*S\s*:/m.test(s.src),
      s.src.split('\n').filter((l) => /^\s*S\s*:/.test(l)).join(' / ') || '（无）')
  }
  const crafted893 = 'V: 1.0\nB: 试\nS: 本乐谱使用「爱记谱」编制\nQ: 1 2 |\n'
  const craftedOut893 = simplifyJps(crafted893)
  check('adj893 负对照：`simplifyJps` 对**构造输入**确实会滤掉 `S:`（判据在量"过滤"这件事本身）',
    /^\s*S\s*:/m.test(crafted893) && !/^\s*S\s*:/m.test(craftedOut893) &&
      craftedOut893.includes('B: 试') && craftedOut893.includes('Q: 1 2 |'),
    JSON.stringify(craftedOut893))
}

/**
 * adj895（用户要求）：播放跟随滚动的「安全区」——**提前量** + **顺滑**。
 *
 * 用户口径：「试听时如果页面宽于预览视界，色块总是走到视界后再调整页面位置，这是不对的，
 * 要留有余量，在接近右视界时就应调整……另外调整时页面的移动要顺滑些，不要一跳一跳」。
 *
 * 纯函数 `followScrollTargetX` ⇒ 直接在 Node 里断言（不碰 DOM）。
 * 安全带 = 视口宽的 `[25%, 75%]`：带内不动（顺滑的前提）、越界才拉回带内。
 */
{
  console.log('[163] playhead follow-scroll safe zone (adj895)')
  const viewW = 1000
  const base = { viewW, scrollW: 4000, scrollLeft: 0 }
  check('adj895 色块在安全带内 ⇒ **不滚**（返回 null）—— 这是"顺滑"的前提（绝大多数帧走这里）',
    followScrollTargetX({ ...base, xInView: 250 }) === null &&
      followScrollTargetX({ ...base, xInView: 500 }) === null &&
      followScrollTargetX({ ...base, xInView: 750 }) === null)
  check('adj895 色块**越出右界即提前**拉到带内左端（右前方因此空出 3/4 视口的谱）',
    followScrollTargetX({ ...base, xInView: 900 }) === 650, // 0 + (900 − 250)
    String(followScrollTargetX({ ...base, xInView: 900 })))
  check('adj895 越出左界 ⇒ 对称拉回带内右端',
    followScrollTargetX({ ...base, scrollLeft: 650, xInView: 100 }) === 0, // 650 + (100 − 750)
    String(followScrollTargetX({ ...base, scrollLeft: 650, xInView: 100 })))
  check('adj895 内容不比视口宽 ⇒ 永不横滚（越到天边也不滚）',
    followScrollTargetX({ ...base, scrollW: 900, xInView: 2000 }) === null &&
      followScrollTargetX({ xInView: 2000, viewW: 0, scrollW: 4000, scrollLeft: 0 }) === null)
  check('adj895 目标钳在可滚上限内（scrollWidth − clientWidth）',
    followScrollTargetX({ viewW: 1000, scrollW: 4000, scrollLeft: 2990, xInView: 999 }) === 3000, '')
  /**
   * 负对照：**提前量的存在性**由安全带右沿是否小于视口宽决定 ——
   * 若 `FOLLOW_SAFE_HIGH === 1`（贴到最右边才触发），上面"越出右界即提前"那条就退化成原行为。
   */
  check('adj895 负对照：安全带右沿 < 视口宽（< 1 才有提前量；= 1 就回到"贴边才动"的老行为）',
    FOLLOW_SAFE_HIGH < 1 && FOLLOW_SAFE_LOW > 0 && FOLLOW_SAFE_LOW < FOLLOW_SAFE_HIGH,
    `low=${FOLLOW_SAFE_LOW} high=${FOLLOW_SAFE_HIGH}`)
}

/**
 * adj898（用户要求）：首页每个示例谱都必须**规范** ——
 * 用户原话「完整的示例谱要规范，如以 `||` 结束，拍子要对，不能有告警」。
 *
 * 用引擎**逐段解析**（与应用里同一条路）⇒ 有任何 error/warning 就点名是哪一段、哪一条。
 * 这条闸门是"写示例"这件事的**唯一可靠办法**：3 拍还是 4 拍，靠眼睛看不出来。
 */
{
  console.log('[164] 首页示例谱必须零错误零告警（adj898）')
  const bad: string[] = []
  for (const s of BRAND_SAMPLES) {
    const r = parseJpsRaw(s.src)
    if (r.errors.length > 0) {
      bad.push(`「${s.label}」→ ${r.errors.map((e) => e.message).join('；')}`)
    }
  }
  check('adj898 首页每个示例谱都零错误零告警（拍数对得上、没有其它告警）',
    bad.length === 0, bad.slice(0, 6).join(' ｜ '))
  /**
   * 负对照：故意写一段拍数不对的 ⇒ 判据必须能抓出来。
   * ⚠ 必须让**第 2 小节**不合拍号：本引擎对**首小节**只要求"整数拍"（弱起豁免），
   * 所以 `Q: 1 2 3 |` 那种是**抓不到**的（我第一版就栽在这儿）。
   */
  const badCraft = 'B: 坏例子\nP: 4/4\nQ: 1 2 3 4 | 1 2 3 |\n'
  check('adj898 负对照：拍数不对的示例确实会被抓出来',
    parseJpsRaw(badCraft).errors.length > 0,
    JSON.stringify(parseJpsRaw(badCraft).errors.slice(0, 1).map((e) => e.message)))
  /**
   * ⚠ 要看**最后一个曲行（`Q…:` 开头）**，不是"最后一个非注释行" ——
   * 小星星末尾是歌词行（`C: …`）、茉莉花末尾是 `# jps-config`，都会把"未收尾"误判出来。
   */
  const lastMusicLine = (src: string): string =>
    src
      .split('\n')
      .filter((l) => /^\s*Q\d*\s*:/.test(l))
      .pop() ?? ''
  /**
   * ⚠ 允许终止线后面再跟一个**房子收尾** `]`（`… ||]`）——
   * 那是"终止线 + 跳房子结束括号"的合法写法（引擎对它**零告警**）。
   *
   * **用户原话（adj904）**：「`||` 后面的 `]` 是跳房子的结束，**本质上它也是以 `||` 结束乐句的**」
   * —— 所以顺序是「先终止、再关房子」（`||]`），不是我当时写的「先关房子、再终止」（`|] ||`）。
   * 不能因为它最后一个字符不是 `|` 就判成"没收尾"。
   */
  const noEnd = BRAND_SAMPLES.filter((s) => !/\|\|\]?\s*$/.test(lastMusicLine(s.src).trim())).map((s) => s.label)
  check('adj898 每个示例的**最后一行乐谱**都以 `||` 收尾（用户明确要求）',
    noEnd.length === 0, noEnd.length > 0 ? `未收尾：${noEnd.join('、')}` : '')

  /**
   * adj898：首页 `index.html` 里**预置的源码**必须与 `BRAND_SAMPLES[0]` 逐字一致 ——
   * 用户第一眼看到的、和点第一个示例按钮得到的，应当是同一段。
   * 这两处都是手写的（HTML 为 SEO / 首屏而写在文档里、示例表写在 TS 里），
   * 最容易改一边忘一边；verify 是独立脚本读不了 TS 模块，所以闸门放在这里。
   */
  const homeHtml = readFileSync(join(root, 'index.html'), 'utf8')
  const firstSample = BRAND_SAMPLES[0]
  const presetSrc = (firstSample?.src ?? '').replace(/\n$/, '')
  check('adj898 首页预置的示例源码 == BRAND_SAMPLES[0]（小星星），两处逐字一致',
    presetSrc !== '' && homeHtml.includes(presetSrc),
    presetSrc !== '' && homeHtml.includes(presetSrc) ? '' : `HTML 里找不到：${JSON.stringify(presetSrc)}`)
  // 负对照：把预置那段改一个字 ⇒ 上面这条判据就该判假（说明它真的在逐字比对）
  check('adj898 负对照：预置源码改一个字就不再匹配',
    presetSrc !== '' && !homeHtml.includes(presetSrc.replace('小星星', '小星星X')), '')
}

/**
 * adj900（用户决定「用文本串导入功能」）：官网首页把当前示例挂在 `?jps=` 上带进应用。
 *
 * 两个纯函数在 Node 里直接断言 —— 真跑到浏览器里验"应用有没有载入"代价太大，
 * 而真正容易错的恰恰是"取参数 / 抹参数"这两步。
