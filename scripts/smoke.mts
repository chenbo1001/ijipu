check('节拍 = 左栏末行贴左下角（= 号与调式行对齐；右移 6px；adj629u）', tTempo !== null && Math.abs(tTempo.x - (ML + 6 + (11.47 - 13.0))) < 0.5 && Math.abs(tTempo.y - (MT + defaultPageConfig.descAreaH + CORNER_ER.tempo)) < 0.5, JSON.stringify(tTempo))
