  check('adj530 按钮文字/图标不变（renderBtn 仍是同一套结构：iconOf + tool-label + toolDefs 表）',
    /const toolDefs: Record<ToolKey, ToolDef>/.test(top) &&
      /<span className="tool-label">\{t\.label\}<\/span>/.test(top) &&
      /const iconOf = \(key: string\)/.test(top),
    '')
  check('adj530 「支持」独立成组但同样参与折叠（优先级里第 2 + 更多下拉里能出现）',
    /OVERFLOW_ORDER: readonly ToolKey\[\] = \[\.\.\.FN_ORDER, \.\.\.EDIT_ORDER, 'donate'\]/.test(top) &&
      /const hiddenList = OVERFLOW_ORDER\.filter/.test(top),
    '')
  check('adj530 「更多」的出现条件与表现不变（= 确有按钮被折叠，条目按显示顺序列出）',
    /\{hiddenList\.length > 0 && \(/.test(top) &&
      /\{hiddenList\.map\(\(k\) => \(/.test(top) &&
      /<div className="menu-group-title">更多工具<\/div>/.test(top),
    '')
  check('adj530 折叠后的「视图/主题」仍能用（更多下拉里各有条目，与下拉/按钮同一份数据）',
    /renderViewEntries\(\)/.test(top) &&
      /const modes: \{ key: typeof themeMode; label: string \}\[\] = \[/.test(top),
    '')
  check('adj530 「支持」的隐形测量副本在两组框**之外**（进组框会套用组内样式、量窄）',
    /data-tool-key="donate"/.test(top) &&
      /className="topbar-btn topbar-donate"\n\s*ref=\{donateMeasureRef\}/.test(top),
    '')
  // 视图按钮并入工具条后，它的下拉成了「工具条内绝对定位的浮层」——工具条对横向溢出做裁剪
  // （adj453 的安全阀），纵向若也裁就把下拉切没了（字体下拉当年正是这个坑，见 adj386）。
  check('adj530 视图下拉不会被工具条的裁剪切掉（纵向可见 + 打开时整体放开裁剪）',
    /overflow-x: clip;/.test(cssFlat) &&
      /overflow-y: visible;/.test(cssFlat) &&
      /\.topbar-toolbar:has\(\.topbar-views\.open\) \{[\s\S]{0,120}?overflow: visible;/.test(cssFlat) &&
      /className=\{`topbar-views\$\{viewOpen \? ' open' : ''\}`\}/.test(top),
    '')
  // ---- adj563（用户要求"顶栏的字体按钮一旦沉到更多里，就不隐藏" + 附带的两处死接线） ----
  // ① 字体**永远适用**：取消 adj407 的 `k === 'font' ? !isNarrow : true`（那会让它从顶栏与
  //    「更多」里同时消失——因为 hiddenList 也按 isApplicable 过滤）。现在放不下就走正常折叠
  //    进「更多」，在下拉里仍可用。
  check('adj563 `font` 不再被 `isNarrow` 判为"不适用"（放得下留顶栏、放不下进「更多」，不再凭空消失）',
    /const isApplicable = useCallback\(\(k: ToolKey\): boolean => \(k === 'zoom' \? showZoom : true\), \[showZoom\]\)/.test(top) &&
      !/k === 'font' \? !isNarrow/.test(top.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '')),
    '')
  // ② adj573（用户要求）：字体**不再作为「更多」条目出现**——见 OVERFLOW_EXCLUDE 的说明。
  //    这条推翻了 adj563 的做法（当时把它改成"打开设置底栏"）：用户认为那条与「字号」「设置」
  //    都重复、且在下拉里并不能选字体，要求沉下去后干脆不显示。
  //    ⚠ 负向断言前**先剥注释**（注释里故意引用了旧写法，同 E-2026-237 的坑）。
  const topCode = top.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '')
  check('adj573（用户要求）「字体」沉进「更多」后**不再列为菜单项**（仍保留显式 null 分支防"死条目"复发）',
    /const OVERFLOW_EXCLUDE: readonly ToolKey\[\] = \['font'\]/.test(topCode) &&
      /hiddenList = OVERFLOW_ORDER\.filter\([\s\S]{0,160}?!OVERFLOW_EXCLUDE\.includes\(k\)/.test(topCode) &&
      /if \(t\.kind === 'font'\) \{[\s\S]{0,500}?return null/.test(topCode) &&
      // 前提：折叠顺序末两位是 `font, fontSize` ⇒ 字号**先**被收走，字体沉下去时「更多」里还有字号，
      // 按钮不会消失、入口不会断（把 font 挪到 fontSize 之后就会断）
      /font,fontSize\]?\]?$/.test(orderOf('TOOL_PRIORITY')) &&
      // 字体分支里**不再有**转开设置底栏的替身（那是 adj563 的做法，已被本轮推翻）
      !/kind === 'font'\) \{[\s\S]{0,400}?toggleDock\('settings'\)/.test(topCode) &&
      !/openModal\('pageConfig'\)/.test(topCode),
    '')
  // ③ `ModalKind` 只留**真的有渲染分支**的模态——防止同类死调用再次通过类型检查。
  check('adj563 `ModalKind` 已收窄为仍有渲染分支的 6 种（about/pageConfig/playback/export 四个残留已删）',
    /export type ModalKind = 'samples' \| 'shortcuts' \| 'manual' \| 'syntax' \| 'donate' \| 'voicePicker'/.test(
      String(readFileSync('src/store/uiStore.ts', 'utf8')),
    ),
    '')
  // ④ Ctrl+Q 是真快捷键（菜单上印着），原先 `openModal('playback')` 同样是死的 ⇒ 改为开关试听底栏。
  {
    const appCode = String(readFileSync('src/App.tsx', 'utf8'))
      .replace(/\/\*[\s\S]*?\*\//g, '')
      .replace(/\/\/[^\n]*/g, '')
    check('adj563 Ctrl+Q 改为开关「试听」底栏（原 `openModal(\'playback\')` 是死调用）',
      // adj619：底栏入口快捷键统一走 `requestDockPanel`（最小化时先展开到建议高度，见 [144]）
      /toLowerCase\(\) === 'q'\)[\s\S]{0,300}?ui\.requestDockPanel\('tryout'\)/.test(appCode) &&
        !/openModal\('playback'\)/.test(appCode),
      '')
  }
}

