  const pluginGuideMd = readSrc('docs/PLUGIN-GUIDE.md')
  check('adj905x 插件手册把「代码块」与「`.jps` 文件」**分开成两节**独立介绍',
    /## 四、写法 A：/.test(pluginGuideMd) && /## 五、写法 B：/.test(pluginGuideMd) &&
      /## 三、两种编制方式/.test(pluginGuideMd))
  check('adj905x 插件手册写到两者的关键差异（围栏必须 | 只有代码块能调 v=/z= | 文件可用嵌入版 iJipu 独立编辑）',
    pluginGuideMd.includes('必须用围栏围起来') &&
      pluginGuideMd.includes('只有代码块有参数') &&
      pluginGuideMd.includes('用嵌入版 iJipu 独立编辑'))

  /**
   * adj905x（**用户实测纠正**）：手机端点「✎ 编辑」是**借用 Obsidian 自己的编辑器**打开 `.jps` 源码
   * （`setViewState({type:'markdown', state:{mode:'source', source:true}})`）——那时**插件的文件栏不在前台**，
   * 所以它上面那个「📖 看谱」按钮**根本看不到**；回谱面的办法是把页签切 **阅读视图**。
   *
   * ⚠ 我第一版手册与首页都写成了「点『看谱』回到预览」（照抄了更早的首页文案），用户照着手册操作才发现不对。
   * 这条守的就是"**别把平台路径写错**"：讲手机端回谱面时必须出现「阅读视图」，
   * 且不许再出现「点『看谱』回…」这种只有桌面源码态才成立的指令。
   */
  check('adj905x 手册与首页讲"手机端怎么回到谱面"时写的是**阅读视图**（不是插件那个「📖 看谱」按钮）',
    pluginGuideMd.includes('阅读视图') &&
      homeHtml.includes('阅读视图') &&
      !/点「看谱」回/.test(pluginGuideMd) &&
      !/点「看谱」回到预览/.test(homeHtml))

  // ---- ② 首页必须够轻：不引 React、不引引擎（否则"介绍页"要白下几百 KB） ----
  const landingSrc = readSrc('src/landing/main.ts')
  check('adj876 首页脚本不 import react / @ijipu/engine',
    !/from ['"]react['"]|from ['"]@ijipu\/engine/.test(landingSrc))

  // ---- ③ manifest：点图标应当**直接进应用**；但站内导航仍要留在 PWA 窗口里 ----
  const manifest = JSON.parse(readSrc('public/manifest.webmanifest')) as { start_url?: string; scope?: string }
  check('adj876 manifest.start_url = `/app/`（装到桌面/手机后点图标进应用，不是介绍页）',
    manifest.start_url === '/app/', String(manifest.start_url))
  check('adj876 manifest.scope 仍是 `/`（PWA 窗口里点首页/手册不会跳去浏览器）',
    manifest.scope === '/', String(manifest.scope))

  // ---- ④ 桌面壳与嵌入版都必须指向**应用**入口 ----
  const tauri = JSON.parse(readSrc('src-tauri/tauri.conf.json')) as {
    build?: { devUrl?: string }
    app?: { windows?: { url?: string }[] }
  }
  check('adj876 Tauri 桌面壳窗口 url 指向应用入口 `app/index.html`（否则桌面端打开是介绍页）',
    tauri.app?.windows?.[0]?.url === 'app/index.html', String(tauri.app?.windows?.[0]?.url))
  check('adj876 Tauri devUrl 指到 `/app/`（`npm run tauri:dev` 打开的应当是应用）',
