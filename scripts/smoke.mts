  )
  check(
    'adj622 `formatDocLocation` 工作区分支渲染「工作区/路径/文件名」形式',
    /renderWorkspacePath/.test(docLocSrc) &&
      /const parts = \[b\.wsName, \.\.\.dirs, file\]\.filter/.test(docLocSrc) &&
      /parts\.join\(SEP\)/.test(docLocSrc),
    '',
  )
  check(
    'adj622 `EditorFootBar` 改用 `formatDocLocation` 并订阅 binding/nativePath/fileHandle 三处来源',
    /import \{ formatDocLocation \} from '\.\/docLocation'/.test(footBarSrc) &&
      /const binding = useDocStore\(\(s\) => s\.binding\)/.test(footBarSrc) &&
      /const nativePath = useDocStore\(\(s\) => s\.nativePath\)/.test(footBarSrc) &&
      /const fileHandle = useDocStore\(\(s\) => s\.fileHandle\)/.test(footBarSrc) &&
      /formatDocLocation\(\{ binding, nativePath, fileHandle, fileName \}\)/.test(footBarSrc),
    '',
  )
  check(
    'adj622 `.footer-file` 加 ellipsis + max-width（避免长路径撑爆状态栏）',
    /\.footer-file\s*\{[^}]*text-overflow:\s*ellipsis/.test(String(readFileSync('src/index.css', 'utf8'))) &&
      /\.footer-file\s*\{[^}]*max-width:\s*50%/.test(String(readFileSync('src/index.css', 'utf8'))),
    '',
  )
  // adj622c（用户口径"紧凑形式"）：状态栏行/列/总行数从「行5,列10/共123行」改成 `[5,10/123]`
  // ——只留三个数字 + 三个分隔符；title 仍保留中文「行 X / 列 Y / 共 Z 行」可读形式（鼠标悬停看）。
  check(
    'adj622c 状态栏行/列/总行数渲染为 `[i,j/k]` 形式（同时 title 保留中文）',
    // 注意两处的表达式语法**不一样**：
    //   · line 79 的 `title` 是 **JSX attribute 里的 template literal**（反引号）⇒ 用 `${...}`
    //   · line 80 的正文是 **JSX 文本节点**（不是字符串）⇒ 用裸 `{...}`，**不加 `$`**
    //     （写 `${...}` 会让 `$` 变成字面字符，渲染出 `[$5,$10/123]`）
    /className="footer-cursor"\s+title=\{`\u884c \$\{cursor\.line\} \/ \u5217 \$\{cursor\.col \+ 1\} \/ \u5171 \$\{totalLines\} \u884c`\}/.test(footBarSrc) &&
      // JSX 文本：`[{cursor.line},{cursor.col + 1}/{totalLines}]`（裸花括号，无 `$`）
      /\[\{cursor\.line\},\{cursor\.col \+ 1\}\/\{totalLines\}\]/.test(footBarSrc) &&
      // 反向 ①：JSX 文本里**不许**出现 `${`（会渲染成字面 `$`）
      !/\[\$\{cursor\.line\}/.test(footBarSrc) &&
      // 反向 ②：旧的长格式（行 X,列 Y/共 Z 行）不能残留
      !/\u884c\{cursor\.line\},\u5217\{cursor\.col \+ 1\}\/\u5171\{totalLines\}\u884c/.test(footBarSrc),
    '',
  )
  // adj622d（用户口径"直接输出 n告警..."）：状态栏告警文本去"个"，整体更紧凑；
  // 单等级时退化为「5 告警」「3 错误」，两等级时为「5问题 (3错误/2告警)」；
  // ProblemPanel 头部不受影响（仍走 problemCopy.title() 完整形式）。
  check(
    'adj622d 状态栏告警紧凑形式：单等级直接「N错误/告警」、两等级「N问题 (N错误/N告警)」',
    (() => {
      // 负向断言前先**剥注释**：源码注释里为说明"去掉了什么"会原样写出
      // 「X 个问题（Y 个错误 / Z 个告警）」（E-2026-237 同款坑，adj620 也踩过）
      const code = footBarSrc.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '').replace(/\{\/\*[\s\S]*?\*\/\}/g, '')
      return (
        // 1) 渲染处用了 problemsBadge（不再直调 problemCopy.title()）
        /const problemsBadge[\s\S]{0,800}?problems\.total === 0[\s\S]{0,200}?problemCopy\.clean/.test(code) &&
        /\$\{problems\.errorCount\}\u9519\u8bef/.test(code) &&
        /\$\{problems\.warnCount\}\u544a\u8b66/.test(code) &&
        // 两等级形式：「N问题 (N错误/N告警)」—— join 的实参 `'/'` 是引号+斜杠+引号三个字符
        /\$\{problems\.total\}\u95ee\u9898 \(\$\{parts\.join\(['"`]\/['"`]\)\}\)/.test(code) &&
        // 单等级形式：**只输出 `parts[0]`**（它已含数字，如「5告警」）——
        // 不能再前缀 `${problems.total}`，否则「总数 == 该档数」会渲染成「55告警」（真机实测踩到）
        /return parts\.length === 1\s*\?\s*parts\[0\]/.test(code) &&
        // 反向：不许出现 `${problems.total}${parts[0]}`
        !/\$\{problems\.total\}\$\{parts\[0\]\}/.test(code) &&
        // 2) 反向：状态栏代码里不再有「X 个错误 / Y 个告警 / Z 个问题」（剥注释后）
        !/\u4e2a\u9519\u8bef|\u4e2a\u544a\u8b66|\u4e2a\u95ee\u9898/.test(code) &&
        // 3) ProblemPanel 头部仍走完整 problemCopy.title（不受影响）
        String(readFileSync('src/ui/dock/ProblemPanel.tsx', 'utf8')).includes('problemCopy.title')
      )
    })(),
    '',
  )

  // ----- ② 试听热键 -----
  check(
    // adj622b（用户口径"按相应热键可操作按钮即可"）：去 `&`，只留 `(A)`——告诉用户字母就是触发它的热键。
    // Chromium 系 accessKey 是 Alt+字母直接激活按钮（不走"按 Alt 看到下划线再按字母"的两步）；
    // `&` 的存在反而让人误以为需要"先按 Alt 看下划线"，所以去掉更直白。
    'adj622b 播放按钮 `(A)` mnemonics（两态共用字母 A，去 `&`）+ accessKey="a"',
    /accessKey="a"/.test(playbackSrc) &&
      /播放\(A\)/.test(playbackSrc) &&
      /暂停\(A\)/.test(playbackSrc) &&
      /继续\(A\)/.test(playbackSrc) &&
      // 反向：旧的 `&A` 不能残留（避免"看着像快捷键，实际没接 accessKey"的双标）
      !/播放\(&A\)/.test(playbackSrc) &&
      !/暂停\(&A\)/.test(playbackSrc) &&
      !/继续\(&A\)/.test(playbackSrc),
    '',
  )
  check(
    'adj622b 停止按钮 `(S)` mnemonics（去 `&`）+ accessKey="s"（disabled 时浏览器不响应 accessKey，符合直觉）',
    /accessKey="s"/.test(playbackSrc) &&
      /停止\(S\)/.test(playbackSrc) &&
      !/停止\(&S\)/.test(playbackSrc),
    '',
  )
  check(
    'adj622 播放按钮的 title 提示带上 Alt+A 热键说明（与菜单 kbd 角标口径一致）',
    /开始试听（或按空格 \/ Alt\+A）/.test(playbackSrc) &&
      /暂停（或按空格 \/ Alt\+A）/.test(playbackSrc) &&
      /继续播放（或按空格 \/ Alt\+A）/.test(playbackSrc),
    '',
  )

  // ----- ③ 工作区右栏顺序 -----
  // `.ws-side` 是 `flex-direction: column`，DOM 顺序 = 视觉顺序。
  // 截取"非 moving"那一支的右栏（操作按钮 → 过滤框 → * 按钮 → x 按钮 → 提示），
  // 断言五块的相对位置：操作按钮 < 过滤框 < `*` 按钮 < x 按钮 < ws-side-label。
  // 注意：源码里 "moving" 分支也含一个 ws-side-label（"actMove·N"），要取"非 moving"分支那一份，
  // 即**第二次**出现的位置（或者：在 ws-side-group 那块之后的 ws-side-label）。
  check(
    'adj622 工作区右栏顺序：操作按钮 → 过滤框 → `*` 按钮 → x 按钮 → "匹配 n 个" 提示',
    (() => {
      const iGroup = wsPanelSrc.indexOf('ws-side-group')
      // 锚到 ws-side-group 之后的那一份 ws-side-label
      const iLabel = wsPanelSrc.indexOf('ws-side-label', iGroup)
      const iInput = wsPanelSrc.indexOf('ws-filter"', iGroup)
      const iAll = wsPanelSrc.indexOf('ws-filter-all', iGroup)
      const iClear = wsPanelSrc.indexOf('ws-filter-clear', iGroup)
      const ok =
        iGroup > 0 &&
        iInput > iGroup &&
        iAll > iInput &&
        iClear > iAll &&
        iLabel > iClear
      if (!ok) {
        console.log('    debug: iGroup=', iGroup, 'iInput=', iInput, 'iAll=', iAll, 'iClear=', iClear, 'iLabel=', iLabel)
      }
      return ok
    })(),
    '',
  )
  check(
    'adj622 第一个右栏元素是 `操作▾` 下拉（ws-side-btn ws-side-group），不是 ws-side-label',
    /<div className="ws-side"[^>]*>[\s\S]{0,200}?<button[\s\S]*?ws-side-group/.test(wsPanelSrc) ||
      // 兼容换行 / 注释写法：操作按钮块在 ws-side-label 块之前
      (() => {
        const idxLabel = wsPanelSrc.indexOf('ws-side-label"')
        const idxGroup = wsPanelSrc.indexOf('ws-side-group"')
        return idxGroup > 0 && idxGroup < idxLabel
      })(),
    '',
  )
}


