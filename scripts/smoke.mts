/**
 * adj919（**用户要求**）：**别在谱面上自带"本乐谱使用…编制"这类自述说明** ——
 * 「模板文件中去掉描述头 `S:` 这行」，用户确认后**一并去掉**两份样例谱（茉莉花 / 送别）里的同类行。
 *
 * ### 改动前的真实红灯与原因（**跑出来的，不是猜**）
 * 把 `S:` 行从 `src/samples/未命名.jps` 删掉后，`npm run smoke` 报 **2 条**失败，
 * 原文与原因**同源**：
 *  · `✗ adj765 应用新建模板文件 === 引擎 \`DEFAULT_NEW_JPS_TEMPLATE\`（逐字节）` ——
 *    **"样本没了"**：这条不是测 `S:` 的渲染，而是测"模板**文件**与引擎**常量**是同一份"。
 *    文件把 `S:` 行删了、引擎 `engine/samples/template.ts` 的常量里那行还在 ⇒ 逐字节必然不等。
 *  · `✗ adj767 模板/色板的真源在引擎（B5/B7）` —— **同一个根因的连带**：
 *    这条把"模板逐字节等于引擎常量"和"色板数字等于引擎 `JPS_HIGHLIGHT_COLORS`"**挤在一条**里，
 *    前半句红就整条红（色板那半句本来是绿的）。
 *  ⇒ 两条都**不是"口径变了"**，而是"只改了一边"。收尾做法是**把引擎常量（真源）也改掉**，
 *  而不是放宽比对。
 *
 * ### 新口径（为什么）
 * 「新建」空白谱与**内置示例谱**都只带**最小描述头**（版本/标题/署名/调号/拍号），
 * **不再自带"本乐谱使用…编制"的自述说明**；用户想在谱尾写说明，自己加 `S:` 即可。
 * 依据是用户早先对**首页示例**的同类裁定（`src/landing/samples.ts` 的 adj893：
 * 「去掉描述头 `S:`（示例里那句"本乐谱使用「爱记谱」编制"是自述冗余）」）——
 * 首页展示副本当年靠 `simplifyJps()` **运行时**过滤掉了，这两份**原文**当时只是漏改。
 *
 * ⚠ **这不是删功能**：`S:` 谱尾说明的**文字链接化**是另一个功能
 * （`engine/render/links.ts` 的 `findUrls`/`linkifyText`，落在 adj652），它**照旧**被测 ——
 * 只是样本从"默认模板那行"换成 adj652 断言里**就地构造的最小源码**
 * （模板不再含 `S:` 行，再拿模板当样本就测不到这个功能了）。
 * 两条合起来算：**"不该自带 S: 行"由本条锁住，"S: 行里的 URL 可点"由 adj652 锁住**，
 * 互不牵连、也没有哪一条被弱化。
 *
 * 判据写成 `(s: string) => boolean` 的纯谓词，是为了能拿它去判**注入 `S:` 行的对照样本**
 * （负对照在下面，判据必须为真**且**真源上必须为假）。
 */
{
  const hasSLine = (s: string) => /^\s*S\s*:/m.test(s)
  /** 被判的三份真源：模板（应用文件 + 引擎常量）与两份内置样例谱 */
  const sources919: [string, string, string][] = [
    ['新建模板原文', 'src/samples/未命名.jps', readFileSync('src/samples/未命名.jps', 'utf8')],
    ['引擎真源常量（新建模板 = DEFAULT_NEW_JPS_TEMPLATE）', '(engine/samples/template.ts)', DEFAULT_NEW_JPS_TEMPLATE],
    ['示例谱原文', 'public/samples/茉莉花.jps', readFileSync('public/samples/茉莉花.jps', 'utf8')],
    ['示例谱原文', 'public/samples/送别.jps', readFileSync('public/samples/送别.jps', 'utf8')],
  ]
  /**
   * 负对照样本：在**引擎常量**的 `P: 4/4` 之后塞回模板原来那行 `S:`
   * （只在**字符串**上注入，不碰任何文件），用来证明 `hasSLine` 这个名字里说的"判 S 行"
   * 是真的在判它，而不是一条恒假的空断言。
   */
  const withSLine = DEFAULT_NEW_JPS_TEMPLATE.replace(
    'P: 4/4\n',
    'P: 4/4\nS: 本乐谱使用「爱记谱 https://ijipu.pages.dev」编制\n',
  )
  check('adj919 判据自身可信：负对照样本确实比模板多了一行 `S:`（否则下面的负对照是空跑）',
    withSLine !== DEFAULT_NEW_JPS_TEMPLATE && (withSLine.match(/^\s*S\s*:/gm) ?? []).length === 1 &&
      /^S: /m.test(withSLine))
  check('adj919 负对照：把 `S:` 行塞回模板 ⇒ 判据为**真**（所以下面几条的"为假"是真的在判这行）',
    hasSLine(withSLine) === true)
  // 每条真源都单独成一条断言：哪份文件被塞回 `S:` 行，失败信息里直接点名
  for (const [what, file, src] of sources919) {
    check(`adj919 ${what} \`${file}\` **不含**描述头 \`S:\`（用户要求）`, !hasSLine(src),
      src.split('\n').filter((l) => /^\s*S\s*:/.test(l)).join(' / ') || '（无 S: 行）')
  }
  /** 明写"这三份文件真的被读到了"（读空串 / 路径写错也会"不含 S: 行" ⇒ 必须排除这种假绿） */
  const nonEmpty = sources919.every(([, , src]) => src.trim().length > 60)
  const musicLines = sources919.every(([, , src]) => /^\s*Q\s*:/m.test(src))
  check('adj919 上面 4 条不是"读空文件"式的假绿：每份真源都非空且带曲行 `Q:`',
    nonEmpty && musicLines,
    sources919.map(([what, file, src]) => `${what}${file}=${src.length}字符${/^\s*Q\s*:/m.test(src) ? '' : '(无 Q: 行!)'}`).join(' | '))
}

/**
 * adj770（清单 B 的收口闸门之二）：**引擎零 DOM / 零 React** 从"注释里的承诺"变成机器闸门。
 *
 * 为什么需要它：B1–B8 往引擎里新增了 9 个模块（色块/问题/音源/模型/色板/时钟/模板/分层…），
 * 而"引擎纯 TS、零 React/DOM"此前**只写在 `src/AGENTS.md` 与文件头注释里**，
 * 一旦有人（包括我）在引擎里写下 `document.`，要到某个宿主炸掉才会发现。
 *
 * 口径：剥离块注释与整行 `//` 注释后判定；
 *  · 禁止 `import … from 'react' | 'react-dom'`；
 *  · 禁止触碰宿主全局（`document`/`window`/`localStorage`/`HTMLElement`/`querySelector`/`createElement`）；
 *  · `requestAnimationFrame`/`cancelAnimationFrame`/`performance` **允许**，但必须与 `typeof` 守卫同行
 *    （`clock.ts` 就是这样把 `now`/`raf` 做成"宿主可注入、缺省回退"的 —— 引擎仍可在 Node 里跑）。
 */
{
  const engineRoot = 'packages/ijipu-engine/src/engine'
  const walk = (dir: string): string[] =>
    readdirSync(dir).flatMap((n) => {
      const p = `${dir}/${n}`
      return statSync(p).isDirectory() ? walk(p) : p.endsWith('.ts') ? [p] : []
    })
  const strip = (s: string) =>
    s
      .replace(/\/\*[\s\S]*?\*\//g, '')
      .split('\n')
      .filter((l) => !l.trim().startsWith('//'))
      .join('\n')
  const bannedImports: [string, RegExp][] = [
    ["'react'", /from\s+['"]react['"]/],
    ["'react-dom'", /from\s+['"]react-dom['"]/],
  ]
  const bannedGlobals: [string, RegExp][] = [
    ['document', /\bdocument\b/],
    ['localStorage', /\blocalStorage\b/],
    ['HTMLElement', /\bHTMLElement\b/],
    ['querySelector', /\bquerySelector\b/],
    ['createElement', /\bcreateElement\b/],
  ]
  /**
   * 这些**允许**，但必须带 `typeof` 守卫（守卫可同行或上两行内）：
   *  · `window`：adj772 起用于"宿主全局走 member 表达式"（`host.requestAnimationFrame?.()`，
   *    审核要求 `window.` 前缀；Node 里回退 `globalThis`）；
   *  · rAF / `performance`：`clock.ts` 的 `now`/`raf` 注入缺省值。
   */
  const needGuard: [string, RegExp][] = [
    ['window', /\bwindow\b/],
    ['requestAnimationFrame', /\brequestAnimationFrame\b/],
    ['cancelAnimationFrame', /\bcancelAnimationFrame\b/],
    ['performance', /\bperformance\b/],
  ]
  const files = walk(engineRoot)
  const bad: string[] = []
  for (const f of files) {
    const code = strip(readFileSync(f, 'utf8'))
    for (const [name, re] of bannedImports) if (re.test(code)) bad.push(`${f}: 禁止导入 ${name}`)
    for (const [name, re] of bannedGlobals) if (re.test(code)) bad.push(`${f}: 触碰宿主全局 ${name}`)
    code.split('\n').forEach((line, i) => {
      // 守卫可以写在同一处，也可以写在上两行内（如 `typeof window !== 'undefined' ?\n … \n : globalThis`）
      const lines = code.split('\n')
      const near = [lines[i - 2] ?? '', lines[i - 1] ?? '', line].join('\n')
      for (const [name, re] of needGuard) {
        if (!re.test(line)) continue
        /**
         * adj772：只判**裸标识符**是否带守卫。
         * `host.requestAnimationFrame(cb)` 这种**成员表达式**不算"触碰宿主全局"——
         * 它正是审核要求的写法（`window.` 前缀 / 取宿主对象后调用），而且引擎里那份 host
         * 本身就是在 `typeof window !== 'undefined'` 守卫下取的。
         * ⚠ 这里也不用 lookbehind（全仓口径：任何地方都不引入 lookbehind 依赖）。
         */
        const bareHits = [...line.matchAll(new RegExp(`${name}\\b`, 'g'))].some(
          (m) => !/[.\w]/.test(line[(m.index ?? 0) - 1] ?? ''),
        )
        if (bareHits && !/typeof/.test(near)) bad.push(`${f}:${i + 1}: ${name} 未用 typeof 守卫`)
      }
    })
  }
  check('adj770 引擎零 DOM / 零 React（新增 9 个模块后仍成立；宿主全局只允许 typeof 守卫下的用法）',
    bad.length === 0 && files.length > 20,
    bad.length === 0 ? `扫描 ${files.length} 个文件` : `违规 ${bad.length} 处：${bad.slice(0, 6).join(' | ')}`)
  // 负对照：把一段"违反规则"的假源码喂给同一套规则，必须判违规（证明闸门真的在判）
  {
    const probe = strip("import { useState } from 'react'\nconst el = document.createElement('div')\nconst t = performance.now()\n")
    const hit = bannedImports.some(([, re]) => re.test(probe)) && bannedGlobals.some(([, re]) => re.test(probe)) &&
      needGuard.some(([, re]) => re.test(probe) && !/typeof/.test(probe))
    check('adj770 引擎纯净性闸门负对照：违规样本会被判出', hit)
  }
}

/**
 * adj766（清单 B8）：设置分层的**判定规则**在引擎（`configValuesEqual` / `isDefaultConfigValue` /
 * `changedConfigKeys`）。分层优先本身早就共用 `mergeJpsConfig`（L0 < L1 < L2）；
 * 这里钉住"是否等于默认 / 改了哪些键"的规则 —— 应用与 Obsidian 插件都调这几个函数。
 */
{
  check('adj766 configValuesEqual：标量严格相等、对象按结构比较、跨 null/undefined 不等',
    configValuesEqual(1, 1) && configValuesEqual('a', 'a') &&
      configValuesEqual({ a: 1 }, { a: 1 }) && configValuesEqual([1, 2], [1, 2]) &&
      !configValuesEqual({ a: 1 }, { a: 2 }) && !configValuesEqual(null, undefined) &&
      !configValuesEqual(0, false))
  // 可选字段约定（E-2026-294）：默认"未设置"时 undefined 与 false 都算默认
  check('adj766 isDefaultConfigValue：可选字段默认"未设置"时 undefined/false 都算默认',
    isDefaultConfigValue(undefined, undefined) && isDefaultConfigValue(undefined, false) &&
      !isDefaultConfigValue(undefined, true) &&
      isDefaultConfigValue(4, 4) && !isDefaultConfigValue(4, 5) &&
      // 有默认值时 value=undefined 不算默认（"没设置"≠"等于默认"，要显式写回）
      !isDefaultConfigValue(4, undefined))
  check('adj766 changedConfigKeys：只报真正变了的键（含新增）',
    JSON.stringify(changedConfigKeys({ a: 1, b: 2 }, { a: 1, b: 3, c: 4 })) === '["b","c"]' &&
      JSON.stringify(changedConfigKeys({ a: 1 }, { a: 1 })) === '[]' &&
      JSON.stringify(changedConfigKeys({ a: { x: 1 } }, { a: { x: 1 } })) === '[]')
}

/**
 * adj767（清单 B 的收口闸门）：B1–B8 的落地要求里有一条是「**删除各自的重复实现**」——
 * 光删一次不够，得让它**不能被悄悄加回来**。这里逐文件核对"应用侧不再自带这些实现、
 * 而是从引擎导入"。断言按"代码"判（注释里提到函数名是正常的，先剥离块注释）。
 */
{
  const code = (p: string) => readFileSync(p, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '')
  const preview = code('src/preview/PreviewPane.tsx')
  check('adj767 应用不再自带色块分组/定位/配色（B1）——只从引擎导入',
    !/const PLAYHEAD_COLORS/.test(preview) && !/function trackKeysOf/.test(preview) &&
      !/function playheadPosIn/.test(preview) && !/function instrumentColorMap/.test(preview) &&
      !/function playheadBaseOf/.test(preview) && !/function segVoiceColor/.test(preview) &&
      /trackKeysOf,/.test(preview) && /playheadPosIn,/.test(preview) && /instrumentColorMap,/.test(preview) &&
      /playheadBaseOf,/.test(preview),
    'PreviewPane 仍有本地实现')
  const editor = code('src/editor/EditorPane.tsx')
  const hl = code('src/editor/highlight.ts')
  check('adj767 应用不再自己攒"错误块/问题行集合"（B4）——改用引擎高亮模型',
    /highlightModel\(code, parseResult\.errors\)/.test(editor) &&
      /groupBlocksByLine\(hlModel\.blockMarks\)/.test(editor) &&
      !/const blockMarks = useMemo/.test(editor) &&
      /highlightLineModel\(raw, lineNo, markByLine\?\.get\(lineNo\) \?\? \[\]\)/.test(hl) &&
      // 块区间的换算已在模型内部，渲染层不再自己调 jpsBlockSpan
      !/jpsBlockSpan/.test(hl))
  const problems = code('src/ui/problems.ts')
  check('adj767 `ui/problems.ts` 保持**转发层**（分级/排序/文案都在引擎，B2）',
    /summarizeProblems as summarize/.test(problems) && /APP_PROBLEM_LABELS/.test(problems) &&
      !/SEVERITY_ORDER/.test(problems) && !/\.sort\(/.test(problems) &&
      problems.split('\n').length <= 60,
    `行数=${problems.split('\n').length}`)
  const backend = code('src/playback/spessaSynthBackend.ts')
  const cache = code('src/playback/spessaCache.ts')
  check('adj767 应用不再自带音源库清单/失败文案（B3）——从引擎导入并走 planHqBankLoad',
    !/const HQ_LIBRARIES/.test(backend) && !/function hqBankFailureText/.test(backend) &&
      !/function getHqLibrary/.test(backend) &&
      /export \{ HQ_LIBRARIES, getHqLibrary, planHqBankLoad, hqBankFailureText \} from '@ijipu\/engine'/.test(backend) &&
      /planHqBankLoad\(\{ cache: !!cached, builtin: !!builtin \}\)/.test(cache))
  const dlg = code('src/dialogs/PlaybackDialog.tsx')
  check('adj767 应用不再自带时钟（B6）——只用引擎 createPlaybackClock',
    !/timeBaseRef/.test(dlg) && !/startTimeRef/.test(dlg) && !/rafLoop/.test(dlg) &&
      /createPlaybackClock\(\{ onTick/.test(dlg))
  const theme = readFileSync('src/styles/theme.css', 'utf8')
  /**
   * adj919：**口径拆分**（原来的写法把两件事挤在一条 `check` 里）。
   *
   * 原样是：
   *   `check('adj767 模板/色板的真源在引擎（B5/B7）', 模板文件 === 引擎常量 && 色板两处命中)`
   * ⇒ 前半句一红整条就红，**看不出到底是模板漂移还是色板漂移**。
   * adj919 去掉模板里的 `S:` 行时，这条就是这么红的（真正的红灯是 adj765，这条是连带）。
   * 现在拆成三条：模板一条（**与 adj765 同一个判据**，是刻意重复的冗余闸门 ——
   * 它是"应用文件 vs 引擎真源"的跨文件十字锁，adj765 那份将来若被改动/挪走，
   * 这里仍能拦住漂移）、色板两条（深色 / 浅色各一条，失败信息里直接写清是谁不对）。
   */
  check('adj767 应用不另带一份新建模板（B5）——`src/samples/未命名.jps` 逐字节 === 引擎 `DEFAULT_NEW_JPS_TEMPLATE`',
    readFileSync('src/samples/未命名.jps', 'utf8') === DEFAULT_NEW_JPS_TEMPLATE,
    readFileSync('src/samples/未命名.jps', 'utf8') === DEFAULT_NEW_JPS_TEMPLATE
      ? ''
      : `文件与引擎常量不等（长度 ${readFileSync('src/samples/未命名.jps', 'utf8').length} vs ${DEFAULT_NEW_JPS_TEMPLATE.length}）`)
  /**
   * adj919：顺手把"色板数字对得上"从 `theme.includes(...)` 的**子串命中**升级为
   * **按模式块**判定。原因：深浅两处**变量名相同**（都叫 `--jp-hl-note`），
   * 子串命中**无法区分是哪一块**——只要文件里任何地方出现过这两个色值就通过，
   * 浅色块被写成深色值也照样绿（= 一条形同虚设的断言）。
   * 现在把 `:root`（品牌默认 = 深色）与 `…[data-mode='light']` 的规则体各自切出来，
   * 在**各自的块里**要求命中 `JPS_HIGHLIGHT_COLORS` 对应模式的值。
   */
  const blockOf = (css: string, selectorRe: RegExp): string => {
    // 从选择器开始吃到该规则的 `{ … }`（括号不嵌套，`[^}]*` 足够），只取第一个匹配
    const m = new RegExp(`${selectorRe.source}\\s*\\{[^}]*\\}`).exec(css)
    return m ? m[0] : ''
  }
  const darkBlock = blockOf(theme, /:root/)
  const lightBlock = blockOf(theme, /\[data-mode='light'\]/)
  const darkHit = darkBlock.includes(`--jp-hl-note: ${JPS_HIGHLIGHT_COLORS.dark.note};`)
  const lightHit = lightBlock.includes(`--jp-hl-note: ${JPS_HIGHLIGHT_COLORS.light.note};`)
  check('adj767 色板真源在引擎（B7）：**深色**块 `:root` 的 `--jp-hl-note` === 引擎 `JPS_HIGHLIGHT_COLORS.dark.note`',
    darkBlock.length > 0 && darkHit,
    darkBlock.length === 0 ? '（没切到 `:root { … }` 规则体 —— 选择器换写法了？）' : `期望 ${JPS_HIGHLIGHT_COLORS.dark.note}；块内=${(darkBlock.match(/--jp-hl-note:[^;]*;/) ?? ['(无)'])[0]}`)
  check('adj767 色板真源在引擎（B7）：**浅色**块 `[data-mode=\'light\']` 的 `--jp-hl-note` === 引擎 `JPS_HIGHLIGHT_COLORS.light.note`',
    lightBlock.length > 0 && lightHit,
    lightBlock.length === 0 ? "（没切到 `[data-mode='light'] { … }` 规则体 —— 选择器换写法了？）" : `期望 ${JPS_HIGHLIGHT_COLORS.light.note}；块内=${(lightBlock.match(/--jp-hl-note:[^;]*;/) ?? ['(无)'])[0]}`)
}

