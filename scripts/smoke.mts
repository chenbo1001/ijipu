      check('adj905o 负对照：把"真实右界"按**实测最小余量再多缩 2px**（模拟墨迹真的越格）⇒ 上面那条立刻为假',
        Number.isFinite(minMargin) && cellViolationsOf(Math.ceil(minMargin) + 2).length > 0,
        `实测最小余量=${Number.isFinite(minMargin) ? minMargin.toFixed(2) : '∞'}px`)

      /**
       * adj905p（用户：「**段层末小节无小节线的末尾与主旋律的小节一对齐**，主旋律一定是要有的」）：
       * 段层那一侧可能没有收尾小节线，但它的内容右端必须落在主旋律同一小节的右端上。
       *
       * 只对"该小节两层都有音"的**最末小节**成立（`{dsb}`/`{bz}` 段若不在曲末则不适用）。
       */
      const endIssues: string[] = []
      for (const sample of BRAND_SAMPLES) {
        const r = parseJps(sample.src)
        const lay = layoutScore(r, DUR_CFG)
        const all = lay.pages.flatMap((p) => p.notes)
        const mel = all.filter((n) => !n.segment)
        const seg = all.filter((n) => n.segment)
        if (mel.length === 0 || seg.length === 0) continue
        const lastBar = Math.max(...all.map((n) => n.barIndex))
        const melEnd = mel.filter((n) => n.barIndex === lastBar)
        const segEnd = seg.filter((n) => n.barIndex === lastBar)
        if (melEnd.length === 0 || segEnd.length === 0) continue
        const melR = Math.max(...melEnd.map((n) => n.rightX ?? n.x + n.width))
        const segR = Math.max(...segEnd.map((n) => n.rightX ?? n.x + n.width))
        if (Math.abs(melR - segR) > 0.6) {
          endIssues.push(`「${sample.label}」末小节 段层右端=${segR.toFixed(1)} vs 主旋律右端=${melR.toFixed(1)}`)
        }
      }
      console.log(`    【全部示例】段层末小节右端对齐检查：不合规 ${endIssues.length} 处`)
      for (const p of endIssues.slice(0, 6)) console.log(`      · ${p}`)
      check('adj905p 全部示例：段层末小节（可无小节线）右端与主旋律那一小节右端对齐',
        endIssues.length === 0, endIssues.slice(0, 4).join(' ｜ '))

      /**
       * adj905q（用户提议的调试开关）：`computeDebugBounds` 的几何必须**与布局同源** ——
       * 它算出的 `cell` 边界必须**逐个等于** `segments` 给出的值（不是"接近"）；
       * 且"左边界画上半部 / 右边界画下半部"的半高区间必须有效（`yTop < yMid < yBottom`）。
       * 负对照：不传音符时输出为空（默认不画任何东西）。
       */
      {
        const rQ = parseJps(BRAND_SAMPLES.find((s) => s.label.includes('铃儿响叮当'))?.src ?? '')
        const layQ = layoutScore(rQ, DUR_CFG)
        const notesQ = layQ.pages.flatMap((p) => p.notes)
        const boundsQ = computeDebugBounds(notesQ, 13)
        const cellL = boundsQ.filter((b) => b.kind === 'note' && b.side === 'L')
        const mismQ = cellL.filter((b, i) => {
          const sg = notesQ[i]?.segments ?? []
          return sg.length === 0 || Math.abs(b.x - sg[0].x) > 0.05
        })
        check('adj905q 调试边界：`note`（音符时值）左缘逐项等于 `segments[0].x`（与布局同源）',
          cellL.length === notesQ.length && mismQ.length === 0,
          `cellL=${cellL.length} notes=${notesQ.length} 不齐=${mismQ.length}`)
        /**
         * 用户追加：「**增时线也要标出边界**」⇒ 每条 `-` 的左右缘都要有边界。
         * 用「末小节 `3 - - -`」核对：该音符 4 段，除首段（数字本体）外 3 段都是增时线
         * ⇒ `aug` 类至少 3 条 L + 3 条 R。
         */
        const augL = boundsQ.filter((b) => b.kind === 'aug' && b.side === 'L')
        const augR = boundsQ.filter((b) => b.kind === 'aug' && b.side === 'R')
        check('adj905q 调试边界：**增时线边界**（每条 `-` 的左右缘都标出）',
          augL.length > 0 && augL.length === augR.length,
          `L=${augL.length} R=${augR.length}`)
        check('adj905q 调试边界：左右边界各画半高（`yTop < yMid < yBottom`）',
          boundsQ.length > 0 && boundsQ.every((b) => b.yTop < b.yMid && b.yMid < b.yBottom),
          JSON.stringify(boundsQ[0] ?? null))
        /**
         * adj905q 修正（用户看图后报「长度长了些，且左右虚线没有以音符中间为分界线」）：
         * **虚线只到音符本体上下各 4px**，且 **`yMid` 落在本体竖向的中点**。
         * ⚠ 只用边界自身的量验（`yBottom − yTop = noteSize + 8`、`yMid` 为中点）——
         * 我第一版按 `indexOf(b)/2` 回查音符，**错**：一个音符产出 2~4 条边界，不是恒定 2 条。
         */
        const specQ = boundsQ.filter(
          (b) =>
            Math.abs(b.yBottom - b.yTop - (13 + 8)) > 0.05 ||
            Math.abs(b.yMid - (b.yTop + b.yBottom) / 2) > 0.05,
        )
        check('adj905q 调试边界：长度 = 音符本体上下各 4px、分界在本体竖向中点',
          boundsQ.length > 0 && specQ.length === 0, `不合规 ${specQ.length} 条`)
        check('adj905q 负对照：没有音符时不产出任何边界（默认不画）',
          computeDebugBounds([], 13).length === 0)
        /**
         * adj905t（用户给截图、我读数）：**用调试几何直接定量** —— 把这几个最小对照谱的
         * 「主旋律每拍格列（`beat`）」与「段层音符列（`segment`）」的**步进**打印出来。
         * 步进不同 ⇒ 逐拍累积错开（就是截图里"越往后越偏"的读数）。
         */
        const probesT: [string, string][] = [
          ['例1 段层4音 vs 增时线', 'Q: {bz 1, 3, 5, 3,} 3 - - - ||'],
          ['例2 对照（两边同构）', 'Q: {bz 1 - - -, } 3 - - - ||'],
          ['例3 多声部 Q1/Q2', 'Q1: | 1 2 3 4 ||\nQ2: | 1 - - - ||'],
          ['例4 附点 vs 等分', "Q: {bz 1, 3, 5, 3,} 3. 5 1' 2' ||"],
          ['例5 两拍最小', 'Q: {bz 1, 3,} 3 - ||'],
          ['例6 弱起', 'Q: {bz 5, | 1, 3, 5, 3,} 5 | 3 - - - ||'],
        ]
        for (const [labelT, qT] of probesT) {
          const rT = parseJps(`V: 1.0\nB: t\nD: C\nP: 4/4\n${qT}\n`)
          const layT = layoutScore(rT, DUR_CFG)
          const bT = computeDebugBounds(layT.pages.flatMap((p) => p.notes), 13)
          /** adj905t：**按层分组**（`isSeg`）—— 否则两层的线混在一起，读数会出现"成对的列" */
          const stepsT = (kind: 'beat' | 'segment', seg: boolean) => {
            const xs = bT
              .filter((v) => v.kind === kind && v.side === 'L' && v.isSeg === seg)
              .map((v) => v.x)
            const uniq = [...new Set(xs.map((v) => Math.round(v * 10) / 10))].sort((a, b) => a - b)
            const ds = uniq.slice(1).map((v, i) => Math.round((v - uniq[i]) * 10) / 10)
            return `列=${uniq.slice(0, 6).join(',')} 步进=${ds.slice(0, 5).join(',')}`
          }
          console.log(`    [${labelT}]`)
          console.log(`      主旋律拍列(beat/main)  : ${stepsT('beat', false)}`)
          console.log(`      主旋律音符列(note/main): ${stepsT('note', false)}`)
          console.log(`      段层音符列(segment)    : ${stepsT('segment', true)}`)
          console.log(`      段层拍列(beat/seg)     : ${stepsT('beat', true)}`)
        }
        /**
         * **adj905v（【用户裁定 ①】的验收闸门）** —— `docs/ALIGNMENT-PRINCIPLES.md` §五之四 的验收方式：
         * 「**主旋律拍列步进 == 段层拍列步进**」。做成两条可执行判据：
         *
         * ① **逐拍落格**：对「给用户截图的 6 个最小对照谱」× **两条布局路径**，逐个段层音符检查
         *    `段层 x == 覆盖该拍位的主旋律音的格起点 + off`（`off = m.x − m.segments[0].x`）；
         * ② **步进相等（例 1 = 用户截图里"越往后越偏"的那条）**：段层拍列步进必须等于主旋律拍列步进
         *    （修前实测 `25` vs `29`）。
         * 两条都带**负对照**：同一份数据在旧口径（`[n.x, zoneEnd]` 内按本音时值线性摊）下
         * 给出的位置与"格 + off"**必然不同**（否则这两条测不到口径）。
         */
        const v5Issues: string[] = []
        let v5Exact = 0
        let v5Mid = 0
        let v5LinearDiff = 0
        for (const [label5, q5] of probesT) {
          for (const [cfgNm5, cfg5] of [
            ['时值优先', DUR_CFG],
            ['空间优先', { ...DUR_CFG, noteSpaceLayout: 'space' as const }],
          ] as const) {
            const lay5 = layoutScore(parseJps(`V: 1.0\nB: t\nD: C\nP: 4/4\n${q5}\n`), cfg5)
            const all5 = lay5.pages.flatMap((p) => p.notes)
            const mel5 = all5.filter((n) => !n.segment)
            for (const sn of all5.filter((n) => n.segment)) {
              const sb = sn.beatPos ?? 0
              const m = mel5.find(
                (n) =>
                  n.id.group === sn.id.group &&
                  n.barIndex === sn.barIndex &&
                  sb >= (n.beatPos ?? 0) - 1e-6 &&
                  sb < (n.beatPos ?? 0) + (n.duration ?? 0) - 1e-9,
              )
              const cells = m?.segments ?? []
              if (!m || cells.length === 0) continue
              const off = m.x - cells[0].x
              let acc = m.beatPos ?? 0
              let ci = cells.length - 1
              let atStart = false
              for (let k = 0; k < cells.length; k++) {
