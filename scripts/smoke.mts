// adj203：& 修饰符提示按上下文区分——小节线后提示小节线修饰符（含 &hs/&ty）
{
  check('adj203 小节线后 & 前缀非空 → 小节线修饰符池', isBarlineModifierContext('Q: 1 2 3 4 | &h') && isBarlineModifierContext('Q: 1 2 3 4 :| &'), '')
  check('adj203 音符后 & → 音符修饰符池', !isBarlineModifierContext('Q: 1 2 3 4 5 &') && !isBarlineModifierContext('Q: 1 2 3 4 5 &t'), '')
  const fh = filterModifierHints('h', true)
  check('adj203 | &h → hs（花 S，1 项）', fh.length === 1 && fh[0].code === 'hs', fh.map((h) => h.code).join(','))
  const ft = filterModifierHints('t', true)
  check('adj203 | &t → ty（大跳跃，1 项）', ft.length === 1 && ft[0].code === 'ty', ft.map((h) => h.code).join(','))
  const fAll = filterModifierHints('', true)
  check('adj203 小节线后空前缀 → 全部小节线修饰符（fine/dc/ds/ty/hs）', fAll.length === BARLINE_MODIFIER_HINTS.length && fAll.some((h) => h.code === 'hs') && fAll.some((h) => h.code === 'ty') && fAll.some((h) => h.code === 'fine'), fAll.map((h) => h.code).join(','))
  const fn = filterModifierHints('', false)
  check('adj203 音符后空前缀 → 音符修饰符池（含 tr/cy，不含 hs）', fn.some((h) => h.code === 'tr') && !fn.some((h) => h.code === 'hs'), '')
  // 力度修饰符：曲部输入 &（空前缀 / 已输字母）时应能弹出并过滤出力度编码
  const DYN_CODES = ['pp', 'p', 'mp', 'mf', 'f', 'ff', 'fff', 'sf', 'fp', 'sfp', 'rit']
  check('力度编码全部在音符修饰符池', DYN_CODES.every((c) => NOTE_MODIFIER_HINTS.some((h) => h.code === c)), NOTE_MODIFIER_HINTS.map((h) => h.code).join(','))
  check('曲部输入 & 空前缀 → 弹列表含力度 pp/mp/rit', fn.some((h) => h.code === 'pp') && fn.some((h) => h.code === 'mp') && fn.some((h) => h.code === 'rit'), '')
  const ffilt = filterModifierHints('f', false)
  check('输入 &f 前缀 → 过滤出 f/ff/fff（力度）', ['f', 'ff', 'fff'].every((c) => ffilt.some((h) => h.code === c)), ffilt.map((h) => h.code).join(','))
  // adj334：吐音/打音/叠音修饰符在音符修饰符池
  check('adj334 音符修饰符池含 tu/ku/da/die', ['tu', 'ku', 'da', 'die'].every((c) => NOTE_MODIFIER_HINTS.some((h) => h.code === c)), NOTE_MODIFIER_HINTS.map((h) => h.code).join(','))
  // adj632/adj633：**倚音括号内**的 & 提示单独收窄（其余写在括号里会被解析器告警）
  check('adj632 倚音括号内 & → 倚音专属候选池（tu/die/da/shy/xhy + adj633 的 4 个波音，共 9 项）',
    isGraceModifierContext('Q: 6/[5/&') && isGraceModifierContext('Q: 3[h5/&s') &&
      isGraceModifierContext('Q: 2[3/&sb') && !isGraceModifierContext('Q: 6/[5/] &') &&
      !isGraceModifierContext('Q: 1 2 3 &') && !isGraceModifierContext('Q: 1 2 3 | &'),
    '')
  const fg632 = filterModifierHints('', false, true)
  check('adj633 倚音候选池 = tu/die/da/shy/xhy/sby/xby/sby+/xby+（不含仍会告警的 tr/mp/zkh）',
    fg632.length === GRACE_MODIFIER_HINTS.length && fg632.length === 9 &&
      ['tu', 'die', 'da', 'shy', 'xhy', 'sby', 'xby', 'sby+', 'xby+'].every((c) => fg632.some((h) => h.code === c)) &&
      !fg632.some((h) => h.code === 'tr' || h.code === 'mp' || h.code === 'zkh'),
    fg632.map((h) => h.code).join(','))
  check('adj632 倚音候选池内按前缀过滤（&sh → shy）', filterModifierHints('sh', false, true).length === 1 && filterModifierHints('sh', false, true)[0].code === 'shy', '')
  // 候选池顺序随 `MODIFIER_SYMBOLS` 字典序（UI 与主音符池同一份来源），故只比**同一组编码**
  check('adj633 倚音候选池与引擎 GRACE_MARK_CODES 是**同一组**编码（不会两处漂移）',
    JSON.stringify([...GRACE_MARK_CODES].sort()) === JSON.stringify(fg632.map((h) => h.code).sort()),
    `engine=${[...GRACE_MARK_CODES].join(',')} ui=${fg632.map((h) => h.code).join(',')}`)
}
// adj165：当前行背景 + 当前音符区块背景（光标行/列；Q: 为 3 字符，rest 从 col=3 起）
// adj171：当前行整行背景由 EditorPane 铺满层渲染，highlightCode 不再输出 hl-current-line
const hlCur = highlightCode('V: 1.0\nB: t\nQ: 1 2 3 4 |\n', undefined, { line: 3, col: 3 })
check('adj171 highlightCode 不再含 hl-current-line（整行背景移入组件铺满层）', !hlCur.includes('hl-current-line'), '')
check('adj165 光标所在音符区块带 hl-current-block', hlCur.includes('hl-current-block'), '')
check('adj165 当前行无错误时不叠加 hl-error-line', !hlCur.includes('hl-error-line'), '')
const hlCur2 = highlightCode('V: 1.0\nB: t\nQ: 1 2 3 4 |\n', undefined, { line: 3, col: 11 })
check('adj165 光标在小节线区块高亮（| 段）', hlCur2.includes('hl-current-block'), '')
// adj204：光标在块后紧邻（空白处紧贴块末 / 行尾）也应高亮该块——
// 继续输入的 & 修饰符针对该块（格式化后块间以单空格分隔，可区分块间隔）
const hlCur3 = highlightCode('V: 1.0\nB: t\nQ: 1 2 3 4 |\n', undefined, { line: 3, col: 10 })
check('adj204 光标在块后紧邻空格 → 高亮前一块（4）', hlCur3.includes('hl-current-block') && hlCur3.includes('hl-note">4<'), '')
const hlCur4 = highlightCode('V: 1.0\nB: t\nQ: 1 2 3 4 |\n', undefined, { line: 3, col: 12 })
check('adj204 光标在行尾紧邻 → 高亮最后一块（|）', hlCur4.includes('hl-current-block') && hlCur4.includes('hl-barline">|<'), '')
const hlCur5 = highlightCode('V: 1.0\nB: t\nQ: 1 2 3  4 |\n', undefined, { line: 3, col: 9 })
check('adj204 光标在块后远隔空白（col-1 为空格）→ 不高亮', !hlCur5.includes('hl-current-block'), '')
// adj243/762：高亮层按折行点分行，错误/告警块以单线外框包裹
//   adj762 起，第五个参数改为**引擎模型的块区间**（`JpsBlockMark`，相对整行原文）——
//   与应用里 `EditorPane` 的传参完全一致（`groupBlocksByLine(highlightModel(...).blockMarks)`）
{
  const src243 = 'V: 1.0\nB: t\nQ: 1 2 3 4 |\n'
  // 行 3 = `Q: 1 2 3 4 |`：`|` 块 = [11,12)、`2` 块 = [5,6)
  const blk = (from: number, to: number, severity: 'error' | 'warning'): JpsBlockMark => ({ line: 3, from, to, severity })
  const hlErr243 = highlightCodeWrapped(src243, undefined, null, [], new Map([[3, [blk(11, 12, 'error')]]]))
  check('adj243 错误块（小节线）包 hl-err-block', hlErr243.includes('hl-err-block') && hlErr243.includes('hl-barline'), '')
  const hlWarn243 = highlightCodeWrapped(src243, undefined, null, [], new Map([[3, [blk(5, 6, 'warning')]]]))
  check('adj243 告警块（音符）包 hl-warn-block', hlWarn243.includes('hl-warn-block') && hlWarn243.includes('hl-note'), '')
  const hlNone243 = highlightCodeWrapped(src243, undefined, null, [])
  check('adj243 无错误/告警时不加外框', !hlNone243.includes('hl-err-block') && !hlNone243.includes('hl-warn-block'), '')
  // 同一块既有错误又有告警时优先红框（不叠加橙框）
  const hlBoth243 = highlightCodeWrapped(src243, undefined, null, [], new Map([[3, [blk(11, 12, 'error'), blk(11, 12, 'warning')]]]))
  check('adj243 同块错误优先红框', hlBoth243.includes('hl-err-block') && !hlBoth243.includes('hl-warn-block'), '')
}

/**
 * adj757（用户要求：「预览渲染、播放、源码格式化、源码高亮、**错误信息显示提示**等共性的功能
 * 都可以独立到引擎层面」，且"应用端也应同样处理"）：
 * 「把错误的 `col` 归到它所在的**音符块**」这套换算已抽到引擎（`jpsBlockSpan` / `jpsBlockMarks`），
 * 应用编辑器与 Obsidian 插件共用同一份口径。这里把它的语义钉住。
 */
{
  const q = 'Q: 1 2 3 4 |'
  /**
   * ⚠ 坐标口径（与 `ParseError.col` / 应用 `BlockMarks` 一致）：col 相对**行头之后的那段内容**，
   * 即 `Q: 1 2 3 4 |` 里 `1` 是 col 0（行头 `Q:` 与其后的空白都由引擎在内部抵消）。
   */
  check('adj757 jpsBlockSpan：命中首个音符（content col=0 → `1`）',
    JSON.stringify(jpsBlockSpan(q, 0)) === JSON.stringify([3, 4]), JSON.stringify(jpsBlockSpan(q, 0)))
  check('adj757 jpsBlockSpan：命中中间音符（content col=4 → `3`）',
    JSON.stringify(jpsBlockSpan(q, 4)) === JSON.stringify([7, 8]), JSON.stringify(jpsBlockSpan(q, 4)))
  check('adj757 jpsBlockSpan：命中末尾块（content col=8 → `|`）',
    JSON.stringify(jpsBlockSpan(q, 8)) === JSON.stringify([11, 12]), JSON.stringify(jpsBlockSpan(q, 8)))
  // ⚠ 负对照：落在**空白**上不属于任何块（与应用 `c >= bs && c < be` 的判据逐字等价）
  check('adj757 jpsBlockSpan：落在空白/越界 → null（不吸附到相邻块）',
    jpsBlockSpan(q, 1) === null && jpsBlockSpan(q, 999) === null && jpsBlockSpan('   ', 0) === null)
  const issues = [
    { line: 3, col: 8, message: 'e1', severity: 'error' as const },
    { line: 3, col: 8, message: 'w1', severity: 'warning' as const },
  ]
  const marks = jpsBlockMarks('V: 1.0\nB: t\nQ: 1 2 3 4 |\n', issues)
  check('adj757 jpsBlockMarks：同块错误优先、重复块只留一条',
    marks.length === 1 && marks[0].line === 3 && marks[0].severity === 'error',
    JSON.stringify(marks))
}
/**
 * adj758（清单 B1：用户要求「播放及色块显示……共性的功能都可以独立到引擎层面」，且"应用端也应同样处理"）：
 * 色块的**分组 / 定位 / 配色**已在引擎（`engine/playback/playhead.ts`）—— 应用与 Obsidian 插件共用，
 * 两端只做"把块画出来"。这里把口径钉在引擎侧（此前这些断言只存在于插件仓库）。
 */
{
  const seg = (over: Record<string, unknown>): Record<string, unknown> => ({
    atMs: 0,
    durationMs: 500,
    pageIndex: 0,
    x: 10,
    y: 100,
    width: 20,
    voice: 1,
    group: 1,
    ...over,
  })
  // ① 分组键必须含 playVoice —— 否则重叠区上下两层（音色相同）会被并成一组、只画一个色块（E-2026-171）
  const track = [
    seg({ instrument: '手风琴', playVoice: undefined }),
    seg({ instrument: '手风琴', playVoice: 'accomp', atMs: 0 }),
  ] as never
  check('adj758 trackKeysOf 的分组键含 playVoice（音色相同的两层也各成一组）',
    trackKeysOf(track).size === 2, `组数=${trackKeysOf(track).size}`)
  check('adj758 trackKeysOf 按 track 引用缓存（同引用不重建）', trackKeysOf(track) === trackKeysOf(track))
  // ② 配色：先给 voice 1 的音色排第 1 位（单声部仍是红块）；声部角色有固定色
  const cmap = instrumentColorMap(track)
  check('adj758 instrumentColorMap：voice 1 的音色拿第 1 个色（红）', cmap.get('手风琴') === 0, String(cmap.get('手风琴')))
  check('adj758 playheadBaseOf：声部角色固定色优先于音色推断',
    playheadBaseOf({ voice: 1, instrument: '手风琴', playVoice: 'accomp' }, cmap) === 'rgba(87, 170, 255,' &&
      playheadBaseOf({ voice: 1, instrument: '手风琴', playVoice: 'second' }, cmap) === 'rgba(63, 122, 46,' &&
      playheadBaseOf({ voice: 1, instrument: '手风琴', playVoice: 'main' }, cmap) === 'rgba(255, 93, 108,')
  // ③ 定位：动态边界优先；段间空隙不残留；不是本页不显示
  const withBounds = [seg({ atMs: 0, yTopMin: 80, yBottomMax: 120 })] as never
  const p1 = playheadPosIn(withBounds, 1, 0, 16)
  check('adj758 playheadPosIn：有 yTopMin/yBottomMax 时按引擎定界', p1 !== null && p1.yTop === 80 && p1.yBottom === 120)
  const plainSeg = [seg({ atMs: 0 })] as never
  const p2 = playheadPosIn(plainSeg, 1, 0, 16)
  check('adj758 playheadPosIn：无定界时回退 [y−1.6n, y+1.1n]（上下各留 0.5 字号延伸）',
    p2 !== null && Math.abs(p2.yTop - (100 - 16 * 1.6)) < 1e-9 && Math.abs(p2.yBottom - (100 + 16 * 1.1)) < 1e-9,
    p2 ? `${p2.yTop}/${p2.yBottom}` : 'null')
  check('adj758 playheadPosIn：段间空隙 / 非本页 / 未播放 → null',
    playheadPosIn(plainSeg, 501, 0, 16) === null &&
      playheadPosIn(plainSeg, 1, 9, 16) === null &&
      playheadPosIn(plainSeg, 0, 0, 16) === null)
}

/**
 * adj762（清单 B4：用户要求「预览渲染、**源码高亮**、错误信息显示提示等共性的功能都可以独立到引擎层面」，
 * 且"应用端也应同样处理"）：**整篇/逐行高亮模型** —— token + 行头 + 错误块 + 行级级别一次算好，
 * 应用（`EditorPane`/`highlight.ts`）与 Obsidian 插件都只做"模型 → 渲染"的映射。
 */
{
  const src = 'V: 1.0\nB: t\nQ: 1 2 3 4 |\n'
  const model = highlightModel(src)
  check('adj762 highlightModel：逐行 token 覆盖整行（拼接 === 原文）',
    model.lines.every((l) => l.tokens.map((t) => t.text).join('') === l.text) && model.lines[2].text === 'Q: 1 2 3 4 |',
    `行数=${model.lines.length}`)
  check('adj762 highlightLineModel：行头识别（Q → cmd 与 headLen；注释行无行头）',
    highlightLineModel('Q: 1 2 3', 3).header?.cmd === 'Q' && highlightLineModel('Q: 1 2 3', 3).header?.headLen === 2 &&
      highlightLineModel('# 注释', 1).header === null)
  check('adj762 lineLevelOf：错误优先、无问题为 null',
    lineLevelOf([{ line: 1, from: 0, to: 1, severity: 'warning' }, { line: 1, from: 2, to: 3, severity: 'error' }]) === 'error' &&
      lineLevelOf([{ line: 1, from: 0, to: 1, severity: 'warning' }]) === 'warning' &&
      lineLevelOf([]) === null)
  const issues = [{ line: 3, col: 8, message: 'e', severity: 'error' as const, hint: 'h' }]
  const m2 = highlightModel(src, issues)
  check('adj762 highlightModel：块/行集合齐备（blockMarks + errorLines/problemLines + 行级级别）',
    m2.blockMarks.length === 1 && m2.blockMarks[0].from === 11 && m2.blockMarks[0].to === 12 &&
      m2.errorLines.has(3) && m2.problemLines.has(3) && !m2.warningLines.has(3) &&
      m2.lines[2].level === 'error' && m2.lines[2].blocks.length === 1,
    JSON.stringify(m2.blockMarks))
  check('adj762 groupBlocksByLine：按行分组（逐行渲染入口）',
    groupBlocksByLine([{ line: 1, from: 0, to: 1, severity: 'error' }, { line: 3, from: 2, to: 3, severity: 'warning' }]).get(3)?.length === 1,
    '')
  check('adj762 模型块区间与渲染命中一致（错误块包 hl-err-block）',
    highlightCodeWrapped(src, undefined, null, [], groupBlocksByLine(m2.blockMarks)).includes('hl-err-block'))
}

/**
 * adj763（清单 B5：用户要求「源码高亮、错误信息显示提示等共性的功能都可以独立到引擎层面」）：
 * 配色的**唯一来源**在引擎（`engine/highlight/palette.ts`）。应用侧这套色值写在
 * `src/styles/theme.css` 的 `--jp-hl-*` / `--jp-hl-plain`（深色在基础块、浅色在 `.theme-light` 块），
 * 这里用断言把 CSS 与引擎常量**钉在一起** ⇒ 以后改配色只改引擎常量，两边 CSS 谁没跟上就红灯。
 */
{
  const css = readFileSync('src/styles/theme.css', 'utf8')
  const themes = ['dark', 'light'] as const
  const missing: string[] = []
  for (const mode of themes) {
    for (const [cls, color] of Object.entries(JPS_HIGHLIGHT_COLORS[mode])) {
      const v = JPS_HL_CSS_VAR[cls as keyof typeof JPS_HL_CSS_VAR]
      if (!css.includes(`${v}: ${color};`)) missing.push(`${mode}:${v}=${color}`)
    }
    if (!css.includes(`--jp-hl-plain: ${JPS_PLAIN_COLORS[mode]};`)) missing.push(`${mode}:--jp-hl-plain`)
  }
  check('adj763 theme.css 的高亮配色与引擎色板逐项一致（深/浅两套 + plain）',
    missing.length === 0, `不一致：${missing.join(' / ')}`)
  check('adj763 浅色一套确实在浅色作用域里（`[data-mode=\'light\']`，不是覆盖了深色）',
    /\[data-mode='light'\][\s\S]{0,1400}?--jp-hl-line-header:/.test(css) &&
      css.indexOf('--jp-hl-note: #ffb86c') < css.indexOf('--jp-hl-note: #b35900'))
}

/**
 * adj764（清单 B6：用户要求「播放及色块显示等共性的功能都可以独立到引擎层面」，且"应用端也应同样处理"）：
 * **试听时钟**的语义用**假时钟**钉死 —— 推进 / 暂停续播 / 取消后不再回调 / 到点恰好一次。
 * 两端（应用 `PlaybackDialog`、插件 `scorePane`）都用这一份。
 */
{
  const mk = (totalMs = 100) => {
    let t = 0
    const queued: ((t: number) => void)[] = []
    const ticks: number[] = []
    let ends = 0
    const clock = createPlaybackClock({
      totalMs,
      now: () => t,
      raf: (cb) => {
        queued.push(cb)
        return queued.length
      },
      cancelRaf: () => undefined,
      onTick: (ms) => ticks.push(ms),
      onEnd: () => {
        ends += 1
      },
    })
    /** 走一帧：把时间推到 `at`，执行最近一次排队的帧回调 */
    const frame = (at: number) => {
      t = at
      const cb = queued.shift()
      if (cb) cb(t)
    }
    return { clock, ticks, frame, endCount: () => ends, pending: () => queued.length }
  }
  {
    const { clock, ticks, frame, endCount, pending } = mk()
    clock.start()
    check('adj764 时钟：start 后 playing=true 且排了一帧', clock.playing && pending() === 1)
    frame(30)
    check('adj764 时钟：帧回调带时间轴位置，并自动续排下一帧',
      JSON.stringify(ticks) === '[30]' && pending() === 1, JSON.stringify(ticks))
    // 暂停：返回暂停点，且时间流逝不再回调
    const paused = clock.pause()
    frame(90)
    check('adj764 时钟：pause 返回暂停点、之后不再回调', paused === 30 && !clock.playing && ticks.length === 1,
      `paused=${paused} ticks=${JSON.stringify(ticks)}`)
    // 续播：从暂停点继续（40 = 30 + (100-90)）
    clock.resume()
    frame(100)
    check('adj764 时钟：resume 从暂停点续算（不是从 0、也不丢失已播时间）',
      JSON.stringify(ticks) === '[30,40]', JSON.stringify(ticks))
    // 到点：onTick(totalMs) + onEnd 恰好一次，且不再续排
    frame(200)
    check('adj764 时钟：到点触发 onTick(totalMs) 与 onEnd（恰好一次），并停止排帧',
      JSON.stringify(ticks) === `[30,40,${100}]` && endCount() === 1 && pending() === 0 && !clock.playing,
      `${JSON.stringify(ticks)} ends=${endCount()} pending=${pending()}`)
    frame(260)
    check('adj764 时钟：到点之后再来帧也不会重复触发 onEnd', endCount() === 1, String(endCount()))
  }
  {
    // 取消：置回 0、不再回调（含 onEnd）；seek 可跳位
    const { clock, ticks, frame, endCount } = mk()
    clock.start()
    frame(20)
    clock.cancel()
    frame(90)
    check('adj764 时钟：cancel 后 ms=0 且不再回调、不触发 onEnd',
      clock.ms() === 0 && !clock.playing && ticks.length === 1 && endCount() === 0,
      `ms=${clock.ms()} ticks=${JSON.stringify(ticks)} ends=${endCount()}`)
    clock.seek(60)
    check('adj764 时钟：seek 跳到指定位置（钳制在 [0, totalMs]）', clock.ms() === 60 && clock.ms() <= clock.totalMs)
  }
}

/**
 * adj765（清单 B7：用户要求共性的功能都独立到引擎）：
 * **新建空白谱的模板**真源在引擎（`DEFAULT_NEW_JPS_TEMPLATE`）。
 * 应用侧保留 `src/samples/未命名.jps` 这份**文件**（adj481 文件驱动约定：改文件即改模板），
 * 但必须与引擎常量**逐字节一致** —— 这条断言就是那把锁。
 */
{
