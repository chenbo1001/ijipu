  return s.noteDur * (1 + s.augCount) + s.dotDur
}
for (const [dc, aug, dots] of [[0, 0, 0], [0, 2, 0], [0, 0, 1], [0, 1, 1], [1, 0, 0], [0, 0, 2], [1, 1, 1], [2, 0, 0], [0, 3, 1]] as const) {
