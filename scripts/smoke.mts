      const lay = layoutScore(pr, DUR_CFG)
      return computeRowGuides(lay, { quci: DUR_CFG.height_quci, geci: DUR_CFG.geci_size }, DUR_CFG.note_size)[0] ?? []
    }
    const bzRows = rowGuidesOf(bz432)
