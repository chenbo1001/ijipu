{
  console.log('[165] URL 文本串导入源码（adj900）')
  const src = 'B: 试\nQ: 1 2 |\n'
  check('adj900 `?jps=` 能取回源码（中文与换行都在；首尾空白按设计**有意**去掉）',
    readJpsFromSearch('?jps=' + encodeURIComponent(src)) === src.trim() &&
