  const m = [...svg.matchAll(new RegExp(`<circle cx="([\\d.]+)" cy="[\\d.]+" r="${DOT_RD_S}"`, 'g'))][k]
  return m ? Number(m[1]) : NaN
}
// 1.：附点圆心 = 主段右端（1.5 倍时值宽 2/3 处，adj288），时值占位宽仍增半（0.5×前音符宽，见 [43]）
