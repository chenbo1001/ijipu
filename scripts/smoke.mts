  const plain = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  const bzSrc = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {bz 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  const dsbSrc = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {dsb 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  type Ev = {
    atMs: number
    durationMs: number
    gain?: number
    instrument?: string
    pitch?: string | null
    playheadSegs?: { instrument?: string }[]
    placed: { segment?: unknown; playVoice?: string; audioPitch: string | null }
  }
  const seqOf = (src: string) => {
    const rr = parseJps(src)
    return buildPlaySequence(rr, layoutScore(rr, DUR_CFG), 120, undefined, '大钢琴')
  }
  const sPlain = seqOf(plain)
  const sBz = seqOf(bzSrc)
  const sDsb = seqOf(dsbSrc)
  const evs = (s: { events: unknown[] }): Ev[] => s.events as Ev[]
  check('T1 含 bz 段时 buildPlaySequence 不抛异常', sBz.events.length > 0, `events=${sBz.events.length}`)
  check('T2 含 dsb 段时 buildPlaySequence 不抛异常', sDsb.events.length > 0, `events=${sDsb.events.length}`)
  // 主旋律事件（非段层）的**时刻与音高**必须与无段时完全一致——段不占主旋律拍位
  const sigMel = (s: { events: unknown[] }): string =>
    evs(s)
      .filter((e) => !e.placed.segment)
      .map((e) => `${e.atMs}:${e.pitch ?? e.placed.audioPitch}`)
      .join(',')
  check('T3 bz 段不改变主旋律事件的时刻与音高', sigMel(sBz) === sigMel(sPlain), `bz=${sigMel(sBz).slice(0, 80)}`)
  check('T4 dsb 段不改变主旋律事件的时刻与音高', sigMel(sDsb) === sigMel(sPlain), `dsb=${sigMel(sDsb).slice(0, 80)}`)
  check('T5 无段时 12 个可发声事件', evs(sPlain).filter((e) => e.placed.audioPitch !== null).length === 12, `got ${evs(sPlain).filter((e) => e.placed.audioPitch !== null).length}`)

  // ---- Z：段层真正发声 + 声部/音色/力度 ----
  const bzSeg = evs(sBz).filter((e) => e.placed.segment)
  const dsbSeg = evs(sDsb).filter((e) => e.placed.segment)
  check('Z1 bz 段层补发 8 个发声事件', bzSeg.length === 8, `got ${bzSeg.length}`)
  check('Z2 dsb 段层补发 8 个发声事件', dsbSeg.length === 8, `got ${dsbSeg.length}`)
  {
    const mel = evs(sBz).filter((e) => !e.placed.segment)
    const ok = bzSeg.every((e, i) => Math.abs(e.atMs - mel[2 + i].atMs) < 1e-6)
    check('Z3 bz 段层与主旋律同拍位**同刻发声**', ok, `seg=${bzSeg.map((e) => e.atMs).join(',')} mel=${mel.slice(2, 10).map((e) => e.atMs).join(',')}`)
  }
  check('Z4 bz 段层音高 = C4 D4 E4 F4 G4 A4 B4 C5（与所写一致）', bzSeg.map((e) => e.placed.audioPitch).join(',') === 'C4,D4,E4,F4,G4,A4,B4,C5', bzSeg.map((e) => e.placed.audioPitch).join(','))
  check('Z5 bz 段层用**第 2 可用音色**（无 Y: 时回退手风琴）', bzSeg.every((e) => e.instrument === '手风琴'), `inst=${bzSeg[0]?.instrument}`)
  check('Z6 bz 段层力度 = 0.75', bzSeg.every((e) => e.gain === 0.75), `gain=${bzSeg[0]?.gain}`)
  check('Z7 bz 下层主旋律力度 = 1、音色 = 主声部（大钢琴）', evs(sBz).filter((e) => !e.placed.segment).every((e) => e.gain === 1 && e.instrument === '大钢琴'), `inst=${evs(sBz).find((e) => !e.placed.segment)?.instrument} gain=${evs(sBz).find((e) => !e.placed.segment)?.gain}`)
  check('Z8 adj722 dsb 段层（上排）= 副声部：第二音色 + 力度 0.75', dsbSeg.every((e) => e.instrument === '手风琴' && e.gain === 0.75), `inst=${dsbSeg[0]?.instrument} gain=${dsbSeg[0]?.gain}`)
  /**
   * Z8b/Z8c（**adj722**，用户口径）：**主副声部对换后，显示不变、演奏与色块对调**。
   *
   * 判据（同一条 `{dsb}` 上）：
   *  · **包络外主旋律 = 主声部** —— 视觉在**下排**（y 更大），音色 = 主音色、力度 1、
   *    色块 `playVoice` 未设（⇒ 预览层按音色取色 = **与单声部同色**）；
   *  · **段内容 = 副声部** —— 视觉在**上排**，音色 = 第二音色、力度 0.75、色块 `playVoice === 'second'`。
   *  · **显示不变**：两层 y 差 = `dy`、色块分界相接（上一块底 == 下一块顶）。
   */
  {
    const pr722 = parseJps('V: 1.0\nB: t\nD: C\nP: 4/4\nQ: {dsb 1 2 3 4 } 5 6 7 1\' |\n')
    const lay722 = layoutScore(pr722, defaultPageConfig)
    const pg722 = lay722.pages[0]
    const seq722 = buildPlaySequence(pr722, lay722, 120)
    const content = seq722.events.find((e) => e.placed.segment?.layer === 'upper' && e.placed.segment.type === 'dsb')
    const outside = seq722.events.find((e) => isDsbOutside(e.placed))
    const cb = (content?.playheadSegs ?? [])[0]
    const ob = (outside?.playheadSegs ?? [])[0]
    check('Z8b adj722 段内容（上排）= 副声部：第二音色 + 力度 0.75 + 色块 playVoice=second',
      content !== undefined && content.instrument === '手风琴' && content.gain === 0.75 && cb?.playVoice === 'second',
      `inst=${content?.instrument} gain=${content?.gain} blockRole=${cb?.playVoice}`)
    /**
     * 主声部的 `instrument` 在本用例里是**空串**（谱面无 `Y:` ⇒ 路由到音色库第一音色 = 钢琴），
     * 而不是 `'大钢琴'`——`'大钢琴'` 只在**显式指定**时才出现（见 `Z7` 的用例带 `Y:`）。
     */
    check('Z8c adj722 包络外主旋律（下排）= 主声部：主音色（空=库第一音色）+ 力度 1 + 色块不设角色（⇒ 与单声部同色）',
      outside !== undefined &&
        (outside.instrument === '' || outside.instrument === '大钢琴') &&
        outside.gain === 1 &&
        ob?.playVoice === undefined &&
        (outside.placed as unknown as { y: number }).y > (content!.placed as unknown as { y: number }).y,
      `inst=${outside?.instrument} gain=${outside?.gain} blockRole=${ob?.playVoice ?? '(未设)'} ` +
        `outsideY=${(outside?.placed as unknown as { y: number })?.y} contentY=${(content?.placed as unknown as { y: number })?.y}`)
    check('Z8d adj722 显示不变：两块上下相接（上块底 == 下块顶）',
      cb?.yBottomMax !== undefined && ob?.yTopMin !== undefined && Math.abs(cb.yBottomMax - ob.yTopMin) < 0.01,
      `contentBot=${cb?.yBottomMax} outsideTop=${ob?.yTopMin}`)
    void pg722
  }
  /**
   * Z8g（**adj723f**，用户报「点 `{dsb}` **下声部**只演奏该声部，点第一声部才是多声部演奏」）：
   * **点上下任何一排的音符，从该处起播都必须是"多声部"（两声部事件都在）。**
   *
   * 根因：`{dsb}` 里"一个音"在事件流里是**一对**（段内容 = 副声部 + 包络外主旋律 = 主声部），
   * 两条事件 `atMs` 相同，但在**事件数组里不相邻**（交错排列）。旧实现 `events.slice(from)` 的
   * `from` 直接落在被点的那一条上 ⇒ 点**下排**时，位于它之前的**整段段内容事件全被切掉**
   * ⇒ 只剩主声部（实测：点下排首个原为 **7** 个事件，修后 **14** 个）。
   *
   * 修法：`from` 回退到"**所有与之同刻的事件中最小的下标**"（不能用相邻比较——
   * 实测 `atMs` 序列是 `0,214,…,1714` 再 `0,214,…,1714` 的**两遍/交错**，
   * 相邻比较会在前一条恰好是更长音时提前停下）。
   */
  {
    const pr8g = parseJps(
      "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: [\"1.\" {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1'// 7// 6//) (6// 6/) 5/ 6- |]\n",
    )
    const lay8g = layoutScore(pr8g, defaultPageConfig)
    const bpm8g = 120
    const full8g = buildPlaySequence(pr8g, lay8g, bpm8g)
    const pg8g = lay8g.pages[0]
    const cnt = (e: { placed: { segment?: unknown } }) => (e.placed.segment ? 'seg' : 'main')
    const segCnt = (seq: { events: unknown[] }) => seq.events.filter((e) => cnt(e as { placed: { segment?: unknown } }) === 'seg').length
    const mainCnt = (seq: { events: unknown[] }) => seq.events.filter((e) => cnt(e as { placed: { segment?: unknown } }) === 'main').length
    const content8g = pg8g.notes.filter((n) => n.segment?.type === 'dsb' && n.segment.layer === 'upper')
    const outside8g = pg8g.notes.filter((n) => !n.segment && n.parentY !== undefined)
    check('Z8g 用例成立：`{dsb}` 上下两排都取到音符、全曲两层事件数相等',
      content8g.length === 7 && outside8g.length === 7 && segCnt(full8g) === 7 && mainCnt(full8g) === 7,
      `内容=${content8g.length} 包络外=${outside8g.length} seg=${segCnt(full8g)} main=${mainCnt(full8g)}`)
    // 点**下排**首个音符：必须与"从头播"一致（两层都在）
    const fromOut8g = buildPlaySequence(pr8g, lay8g, bpm8g, String(outside8g[0].id.index))
    check('Z8g 点下排（主声部）音符 ⇒ 仍是**多声部**起播（段内容事件不能被切掉）',
      segCnt(fromOut8g) === 7 && mainCnt(fromOut8g) === 7,
      `seg=${segCnt(fromOut8g)} main=${mainCnt(fromOut8g)} 共=${fromOut8g.events.length}`)
    // 点**上排**首个音符：同样两层都在
    const fromIn8g = buildPlaySequence(pr8g, lay8g, bpm8g, String(content8g[0].id.index))
    check('Z8g 点上排（副声部）音符 ⇒ 同样是多声部起播',
      segCnt(fromIn8g) === 7 && mainCnt(fromIn8g) === 7,
      `seg=${segCnt(fromIn8g)} main=${mainCnt(fromIn8g)} 共=${fromIn8g.events.length}`)
    // 点下排**中间**那个音（第 3 个）：从该拍起，两层都从同一刻开始
    const fromMid8g = buildPlaySequence(pr8g, lay8g, bpm8g, String(outside8g[2].id.index))
    const firstMs8g = fromMid8g.events[0]?.atMs ?? -1
    check('Z8g 点下排中间音符 ⇒ 段内容与主声部**都从该刻开始**（无"第一拍只有单声部"）',
      segCnt(fromMid8g) > 0 &&
        mainCnt(fromMid8g) > 0 &&
        firstMs8g === 0 &&
        // 起播那一刻必须同时存在两条（上下各一）
        fromMid8g.events.filter((e) => e.atMs === 0).length >= 2,
      `seg=${segCnt(fromMid8g)} main=${mainCnt(fromMid8g)} 首刻事件数=${fromMid8g.events.filter((e) => e.atMs === 0).length}`)
  }
  /**
   * Z8f（**adj722b**，用户报「`(1'// 7// 6//) (6// 6/)` 这部分没有色块显示」）：
   * **任何可发声事件的色块段宽必须 > 0**——宽度为 0 等于"这块根本画不出来"。
   *
   * 根因：段层右界钳制（`adj439`）取的是 `(页|组|声部)` 下**所有段右界的最小值**，
   * 本意"别越出任何一段"，实际成了"别越出**最窄**那段"。实测该行三段 `{dsb}` 的
   * `blockRight` = `151.5 / 303.5 / 530.1` ⇒ 取 min = **151.5**，
   * 而第 2、3 段包络外的主旋律 x 已在 `197.6` 之后 ⇒ `width = max(0, 151.5 − 197.6) = **0**`，
   * 实测 **21 个段宽度为 0**（用户截图里"这一段没有色块"就是这个）。
   * 现改为按**本音符所属段**取 `blockRight`（`dsbSegmentOf`，与 `adj720` 同一口径）。
   *
   * 用例：用户原谱第 1 行（三段 `{dsb}`，右界差别很大）——旧实现必红。
   */
  {
    const pr8f = parseJps(
      'V: 1.0\nB: t\nD: C\nP: 4/4\n' +
        'Q: 6, 0/ 3\'/ 7 {dsb 0/ 1// 2// } 0/ 6// 7// |["1." {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1\'// 7// 6//) (6// 6/) 5/ 6- | 0 0 0 1/ 2/ :|]\n',
    )
    const lay8f = layoutScore(pr8f, defaultPageConfig)
    const seq8f = buildPlaySequence(pr8f, lay8f, 120)
    const zero8f: string[] = []
    let total8f = 0
    for (const e of seq8f.events) {
      const p8f = e.placed as unknown as { playable?: boolean; token: { raw?: string } }
      if (!p8f.playable) continue
      for (const s8f of e.playheadSegs ?? []) {
        total8f++
        if (s8f.width <= 0.01) {
          zero8f.push(`${JSON.stringify(p8f.token.raw)}@${(e.atMs / 1000).toFixed(2)}s(x=${s8f.x.toFixed(1)})`)
        }
      }
    }
    check('Z8f adj722b 可发声事件的色块段宽都 > 0（旧实现被"最窄那段"钳成 0 宽）',
      total8f > 0 && zero8f.length === 0,
      `总段=${total8f} 零宽=${zero8f.length}：${zero8f.slice(0, 6).join(' | ')}`)
  }
  /**
   * Z8e（**adj722**，用户复报「下面声部色块不正确（跑到后面音符上）」）：
   * **`{dsb}` 包络外主旋律的色块，右缘不得超过自己音符的槽右缘**。
   *
   * 根因：色块右界曾取 `max(edge, 自己右缘)`，其中 `edge` = **下一个音符的块左缘**——
   * 它含"槽尾留白"与"布置网格的间隙"（实测下层 `5/` 墨迹到 `140.7`、下一个 `6-` 从 `151.5` 起，
   * 空 **9.7px**）⇒ 色块宽 19.8px、比自己的音符宽出 **10.8px**、盖到后面那个音符上。
   * 现改为以**本音符墨迹**为准（`AGENTS` 五·9「区间一律用墨迹算」）。
   *
   * 容差 1.2px：「数字槽右缘」比"数字墨迹右缘"天然宽约 1px（`rightX` 的既有口径）。
   */
  {
    const pr8e = parseJps("V: 1.0\nB: t\nD: C\nP: 4/4\nQ: [\"1.\" {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1'// 7// 6//) (6// 6/) 5/ 6- |]\n")
    const lay8e = layoutScore(pr8e, defaultPageConfig)
    const seq8e = buildPlaySequence(pr8e, lay8e, 120)
    const bad8e: string[] = []
    /**
     * adj905c（用户口径）：判据从「不越出**本音符墨迹槽**」改成
     * 「**不压下一个时值元素的左边界**」。
     *
     * 用户原话：「右边界除了**不压下一个时值元素**外，**还要不压小节线和无时值元素**」。
     * 旧口径用 `max(rightX, x + width)` —— 而 `x + width` **不含**音符之间的布置间隙
     * （实测下层 `5/` 的 `x+width` 到 `141.8`，而下一个 `6-` 从 `151.5` 起，中间 9.7px）。
     * 按新口径，色块右界**应当**是"下一个时值元素的 x"（151.5），这正是它守着的那个值。
     */
    const lowerNotes8e = seq8e.events
      .filter((e) => isDsbOutside(e.placed))
      .map((e) => e.placed as unknown as { x: number; barIndex: number; beatPos: number })
    for (const e of seq8e.events) {
      if (!isDsbOutside(e.placed)) continue
      const segs8e = e.playheadSegs ?? []
      if (segs8e.length === 0) continue
      const p8e = e.placed as unknown as {
        x: number
        width: number
        rightX?: number
        barIndex: number
        beatPos: number
        duration?: number
        token: { raw?: string }
      }
      const blockR8e = segs8e[segs8e.length - 1].x + segs8e[segs8e.length - 1].width
      /** 「下一个时值元素」= 同一小节里、beatPos 紧接本音终点的那个音 */
      const nEnd8e = p8e.beatPos + (p8e.duration ?? 0)
      const next8e = lowerNotes8e.filter(
        (m) => m.barIndex === p8e.barIndex && Math.abs(m.beatPos - nEnd8e) < 1e-6,
      )
      const limitR8e =
        next8e.length > 0
          ? Math.min(...next8e.map((m) => m.x))
          : Math.max(p8e.rightX ?? 0, p8e.x + p8e.width)
      if (blockR8e > limitR8e + 1.2) {
        bad8e.push(
          `${JSON.stringify(p8e.token.raw)}: 块右 ${blockR8e.toFixed(1)} > 下一时值左界 ${limitR8e.toFixed(1)}（+${(blockR8e - limitR8e).toFixed(1)}）`,
        )
      }
    }
    check('adj905c 下层色块的右界不压**下一个时值元素**（用户口径；也不越小节线）',
      bad8e.length === 0, `越出 ${bad8e.length} 处：${bad8e.slice(0, 5).join(' | ')}`)
  }
  {
    const lower = evs(sDsb).filter((e) => isDsbOutside(e.placed))
    /**
     * adj722（用户口径翻转）：**包络外主旋律 = 主声部**（主音色「大钢琴」+ 力度 1），
     * **段内容 = 副声部**（第二音色「手风琴」+ 力度 0.75）。
     * 这两条断言原先写反了（旧口径：段内容=主声部、包络外=第二声部）。
     */
    check('Z9 adj722 dsb 重叠区**包络外主旋律 = 主声部**（主音色 + 力度 1）',
      lower.length === 8 && lower.every((e) => e.instrument === '大钢琴' && e.gain === 1),
      `n=${lower.length} inst=${lower[0]?.instrument} gain=${lower[0]?.gain}`)
    const dsbContent = evs(sDsb).filter((e) => e.placed.segment?.layer === 'upper' && e.placed.segment.type === 'dsb')
    check('Z9b adj722 dsb **段内容 = 第二声部**（第二音色 + 力度 0.75）',
      dsbContent.length === 8 && dsbContent.every((e) => e.instrument === '手风琴' && e.gain === 0.75),
      `n=${dsbContent.length} inst=${dsbContent[0]?.instrument} gain=${dsbContent[0]?.gain}`)
    const others = evs(sDsb).filter((e) => !e.placed.segment && e.placed.parentY === undefined)
    check('Z10 dsb 重叠区外的主旋律仍为主声部（音色/力度不变）', others.length === 4 && others.every((e) => e.instrument === '大钢琴' && e.gain === 1), `n=${others.length}`)
  }
  check('Z11 段层色块轨道已生成且带 instrument（手风琴）', bzSeg.every((e) => (e.playheadSegs?.length ?? 0) > 0 && e.playheadSegs!.every((s) => s.instrument === '手风琴')), '')
  check('Z12 主旋律色块轨道也带上 instrument（大钢琴）', evs(sPlain).every((e) => e.playheadSegs?.every((s) => s.instrument === '大钢琴')), '')
  {
    const lastSeg = Math.max(...bzSeg.map((e) => e.atMs + e.durationMs))
    check('Z13 totalMs ≥ 段层事件末刻', sBz.totalMs >= lastSeg, `totalMs=${sBz.totalMs} segEnd=${lastSeg}`)
  }
  {
    const repSrc = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: |: 3 4 | {bz 1 2} 5 6 :| 7 |\n"
    const rr = parseJps(repSrc)
    const s = buildPlaySequence(rr, layoutScore(rr, DUR_CFG), 120, undefined, '大钢琴')
    const seg = (s.events as Ev[]).filter((e) => e.placed.segment)
    check('Z14 反复段落内的段：两遍各发声一次（4 个事件）', seg.length === 4, `got ${seg.length} at=${seg.map((e) => e.atMs).join(',')}`)
    check('Z15 第二遍的段事件晚于第一遍', seg.length === 4 && seg.slice(2).every((e) => e.atMs > seg[0].atMs), `at=${seg.map((e) => e.atMs).join(',')}`)
  }
  // Z16/Z17：**色块层的分组前提**——重叠区同一时刻有两条轨道：同页同曲行、音色不同 ⇒ 画两块
  //（既有 Q1/Q2 多声部是靠"不同 group"显示多块；段层与主旋律同 group，故必须靠"音色"再分一组）
  {
    const seg0 = bzSeg[0]
    const melSame = evs(sBz).filter((e) => !e.placed.segment && Math.abs(e.atMs - seg0.atMs) < 1e-6)
    const a0 = seg0.playheadSegs?.[0]
    const b0 = melSame[0]?.playheadSegs?.[0]
    check(
      'Z16 bz 重叠区同刻两条轨道：同 (page,group)、**音色不同** → 色块画两块',
      melSame.length >= 1 && a0 !== undefined && b0 !== undefined && a0.pageIndex === b0.pageIndex && a0.group === b0.group && a0.instrument !== b0.instrument,
      `seg=${a0?.pageIndex}/${a0?.group}/${a0?.instrument} mel=${b0?.pageIndex}/${b0?.group}/${b0?.instrument}`,
    )
  }
  {
    const seg0 = dsbSeg[0]
    const melSame = evs(sDsb).filter((e) => !e.placed.segment && Math.abs(e.atMs - seg0.atMs) < 1e-6)
    const a0 = seg0.playheadSegs?.[0]
    const b0 = melSame[0]?.playheadSegs?.[0]
    check(
      'Z17 dsb 重叠区同刻两条轨道且**上下分层**（y 不同）',
      melSame.length >= 1 && a0 !== undefined && b0 !== undefined && a0.group === b0.group && a0.instrument !== b0.instrument && Math.abs(a0.y - b0.y) > 1,
      `seg y=${a0?.y} inst=${a0?.instrument} mel y=${b0?.y} inst=${b0?.instrument}`,
    )
  }
  // Z18（回归）：段层**不得影响主旋律色块宽度**——段层音符与主旋律**同 x**，若混入 adj320 的
  //   「下一个时值元素」计算，边界会退化为小节线 ⇒ 主旋律色块被拉长到**整个小节**（用户报的现象）
  {
    const segsSig = (s: { events: unknown[] }): string =>
      evs(s)
        .filter((e) => !e.placed.segment)
        .map((e) => (e.playheadSegs ?? []).map((x) => `${x.x.toFixed(1)}:${x.width.toFixed(1)}`).join('|'))
        .join(';')
    // adj439：**bz 不改主旋律几何**（bz 只在上方叠加，主旋律色块应与无段时逐段一致）；
    // **dsb 下层**则按用户要求"以段层右界（大括号 `}`）为界限定占宽"——包络内最后一音的色块
    // 会被收到大括号之内，故不再与无段时一致（下面 Z18c 单独断言"不越过大括号"）。
    check(
      'Z18 有段时 bz 的主旋律色块与无段时**逐段一致**（bz 不污染右边界）',
      segsSig(sBz) === segsSig(sPlain),
      `bz=${segsSig(sBz).slice(0, 70)} plain=${segsSig(sPlain).slice(0, 70)}`,
    )
    {
      // Z18c（adj439，E-2026-179）：dsb 下层色块**不跨过段层右界（大括号）**
      const layDsb = layoutScore(parseJps(dsbSrc), DUR_CFG)
      const sbX2 = (layDsb.pages[0].segmentBrackets ?? [])[0]?.x2 ?? Number.POSITIVE_INFINITY
      const dsbBlocks = evs(sDsb).filter((e) => !e.placed.segment).flatMap((e) => e.playheadSegs ?? [])
      const crosses = dsbBlocks.some((s) => s.x < sbX2 - 1e-3 && s.x + s.width > sbX2 + 1e-3)
      check('Z18c dsb 下层色块不跨过段层右界（大括号 `}`）',
        Number.isFinite(sbX2) && dsbBlocks.length > 0 && !crosses,
        `x2=${sbX2.toFixed(1)} blocks=${dsbBlocks.map((s) => `${s.x.toFixed(1)}~${(s.x + s.width).toFixed(1)}`).join(' ')}`)
    }
    // 且主旋律色块不覆盖整小节：末块右缘应落在该小节线之前（留出间距）
    const melEv = evs(sDsb).filter((e) => !e.placed.segment)
    const w = melEv.flatMap((e) => e.playheadSegs ?? []).map((x) => x.width)
    check('Z18b 主旋律单个色块宽不超过一个音符槽（无"整小节"色块）', w.every((v) => v < 60), `max=${Math.max(...w).toFixed(1)}`)
  }
  // Z19/Z20：声部角色带到事件上；音色路由确实不同（program 与 channel 都不同）
  check('Z19 事件带 playVoice（bz=accomp / dsb 下层=second）', bzSeg.every((e) => e.playVoice === 'accomp') && evs(sDsb).filter((e) => e.placed.playVoice === 'second').length === 8, `bz=${bzSeg[0]?.playVoice}`)
  check(
    'Z20 音色路由：手风琴(program 21 / organ 通道) 与 大钢琴(0 / piano 通道) 都不同',
    instrumentToProgram('手风琴') === 21 && instrumentToProgram('大钢琴') === 0 && matchInstrument('手风琴') !== matchInstrument('大钢琴'),
    `手风琴=${instrumentToProgram('手风琴')}/${matchInstrument('手风琴')} 大钢琴=${instrumentToProgram('大钢琴')}/${matchInstrument('大钢琴')}`,
  )
  /**
   * Z21（adj710，用户报「`{dsb}` 的**前两拍没有按双声部演奏**」）：
   * **`{dsb}` 的每个段层音符都必须有起奏事件**——`{dsb}` 是"两个声部逐音一一对应"，
   * 连音合并一旦吞掉某个音的起奏点，两层音符数就不再对应、听感不再是双声部。
   *
   * 实测（用户原谱 `(3// 2// 1//) (1// 1/) 7,/ 1-`）：上层 `(1// 1/)` 同音高同连音线
   * 被合成 `0.643s` 一个音 ⇒ 31 个上层音里 3 个丢起奏点。本断言按"逐音都在事件里"守它。
   */
  {
    const srcDsb =
      'V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 6, 0/ 3\'/ 7 {dsb 0/ 1// 2// } 0/ 6// 7// |["1." {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1\'// 7// 6//) (6// 6/) 5/ 6- |\n'
    /** ⚠️ **只解析一次**：布局与播放必须消费同一份解析结果，否则段层 token 是两份不同对象、
     *  下面按"对象身份"比对会永远失败（自己踩过一次）。 */
    const parsedDsb = parseJps(srcDsb)
    const layDsb = layoutScore(parsedDsb, defaultPageConfig)
    const seqDsb = buildPlaySequence(parsedDsb, layDsb, 96)
    /**
     * ⚠️ 比对必须用**对象身份**（`e.placed === 布局音符`）——`events[].placed.id.index` 与
     * 布局音符的 `id.index` 不是同一套编号（段层音符的 index 是 `1000000004000` 这种命名空间值，
     * 而事件里存的是解码后的序号）⇒ 按 index 比对会把"全都有事件"误判成"全都没有"。
     */
    const evSet = new Set(seqDsb.events.map((e) => e.placed))
    const upper = layDsb.pages[0].notes.filter((n) => n.segment?.layer === 'upper' && n.segment.type === 'dsb')
    const lower = layDsb.pages[0].notes.filter((n) => isDsbOutside(n))
    const missUpper = upper.filter((n) => !evSet.has(n)).map((n) => (n.token as { raw?: string }).raw)
    const missLower = lower.filter((n) => !evSet.has(n)).map((n) => (n.token as { raw?: string }).raw)
    check('Z21 adj710 `{dsb}` 上下两层**每个音都有起奏事件**（连音合并不吞起奏点）',
      upper.length > 0 && lower.length === upper.length && missUpper.length === 0 && missLower.length === 0,
      `上层 ${upper.length} / 下层 ${lower.length}；缺事件：上=${missUpper.join(',') || '无'} 下=${missLower.join(',') || '无'}`)
  }
  /**
   * Z22（**adj719**，用户复报「这几处 `{dsb}` 还是没能实现多声部演奏」）：
   * **两层必须"同刻成对且音高不同"**——这才是"听起来是双声部"的充分条件。
   *
   * 为什么单看"每个音都有事件"不够（`Z21` 的口径）：两层若被合并到同一刻且**同音高**，
   * 听感仍是一个音（同度叠音）。本断言逐时刻核对：
   *  · 每个上层音的起点时刻，**必须**存在同刻的下层音；反之亦然；
   *  · 该时刻两层的**实际发声音高必须不同**。
   *
   * 用**用户原谱的完整两行**（含 `["1."`/`["2."`/`["3."` 反复与跳房子 `&ds`）——
   * 早前的排查正是"只在单行无反复的最小用例里正常"，所以断言必须覆盖反复/跳转走查。
   */
  {
    const src719 =
      'V: 1.0\nB: t\nD: C\nP: 4/4\n' +
      "Q: 6, 0/ 3'/ 7 {dsb 0/ 1// 2// } 0/ 6// 7// |[\"1.\" {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1'// 7// 6//) (6// 6/) 5/ 6- | 0\"间奏略\" 0 0 1/ 2/ :|][\"2.\" {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1'// 7// 6//) (6// 6/) 5/ 6- ||/]&ds\n" +
      'Q :|/["3." {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1\'// 7// 6//) (6// 6/) 5/ 6- |"p:2/4" 0 0/ 3\'/ |]/"p:4/4" 6 0/ 3/ 7, {dsb 0/ 1// 2// } 0/ 6// 7// |"p:2/4" {dsb (3// 2// 1//) 1// } (1\'// 7// 6//) 6// 0/ 5/ |"p:4/4" 6--- ||\n'
    const parsed719 = parseJps(src719)
    const lay719 = layoutScore(parsed719, defaultPageConfig)
    const seq719 = buildPlaySequence(parsed719, lay719, inferBpm(parsed719))
    const soundOf = (e: (typeof seq719.events)[number]): string | null =>
      e.pitch ?? ((e.placed as unknown as { audioPitch?: string | null }).audioPitch ?? null)
    /** 只取**真正发声**的事件（休止符 `playable=false` 不参与） */
    const sound = seq719.events.filter((e) => e.placed.playable && soundOf(e))
    const upperEv = sound.filter((e) => e.placed.segment?.layer === 'upper' && e.placed.segment.type === 'dsb')
    const lowerEv = sound.filter((e) => isDsbOutside(e.placed))
    /** 同刻（`atMs` 相同）两层并发且音高不同 */
    const pair = (a: (typeof sound)[number], b: (typeof sound)[number]) =>
      Math.abs(a.atMs - b.atMs) < 1e-6 && soundOf(a) !== soundOf(b)
    const upperPaired = upperEv.filter((u) => lowerEv.some((l) => pair(u, l)))
    const lowerPaired = lowerEv.filter((l) => upperEv.some((u) => pair(l, u)))
    check('Z22 adj719 用户原谱（含反复/跳房子）`{dsb}` 两层**同刻成对且音高不同**',
      upperEv.length > 0 &&
        lowerEv.length > 0 &&
        upperPaired.length === upperEv.length &&
        lowerPaired.length === lowerEv.length,
      `上层 ${upperPaired.length}/${upperEv.length}、下层 ${lowerPaired.length}/${lowerEv.length} 成对；` +
        `未配对上层=${upperEv.filter((u) => !upperPaired.includes(u)).map((u) => `${JSON.stringify((u.placed.token as { raw?: string }).raw)}@${u.atMs}`).join(',') || '无'}`)
    /**
     * Z23（**adj719**）：**导出的 MIDI 里 `{dsb}` 两层必须各占一条轨/一个通道**。
     *
     * 根因：`eventsToMidi` 原先只按 `id.voice` 分轨，而 `{dsb}` 上下两层**共用同一个声部号**
     * （靠 `playVoice` 区分）⇒ 两层被塞进同一条轨、同一个 MIDI 通道，而该轨只在音色变化处
     * 发一次 Program Change ⇒ 后一个音色覆盖前一个，**导出的 MIDI/音频听起来只有一个声部**
     * （实时试听走 `schedulePlay` + `GmChannelAllocator`，所以"试听正常、导出不对"）。
     *
     * 判据：轨数 = `声部号 × 声部角色` 的**不同组合数**；且每轨首个 Program Change 与
     * 该层音色一致（上层钢琴 0、下层手风琴 21）。
     */
    {
      const midi = eventsToMidi(seq719.events, { bpm: inferBpm(parsed719), title: 't' })
      /** 解析 MThd：nTracks 在 0x0A~0x0B */
      const nTracks = (midi[10] << 8) | midi[11]
      const combos = new Set(
        seq719.events.filter((e) => e.placed.playable).map((e) => `${e.placed.id.voice}|${e.playVoice ?? 'main'}`),
      )
      check('Z23 adj719 导出的 MIDI：`{dsb}` 两层各占一条轨（轨数 = 声部×角色组合数 + 1 元数据轨）',
        nTracks === combos.size + 1,
        `轨数=${nTracks} 组合数=${combos.size}（期望 ${combos.size + 1}）；组合=${[...combos].join(',')}`)
    }
    /**
     * Z24（**adj720**，用户看图报「图2 里下层没有绿色块」）：**两层色块必须都存在且垂直不重叠**。
     *
     * 色块由 `playheadSegs` 携带：上层（`main`）取 `[y−1.1ns, midEqual]`、
     * 下层（`second`）取 `[midEqual, y+0.6ns]`（`adj429` 的"严格等高"口径）。
     * 判据（用**用户原谱逐字**，含反复/跳房子）：
     *  · 每个 `{dsb}` 的**上层音与下层音都必须有至少一个色块**（无色块 = 用户看到"缺一块"）；
     *  · 每个色块的 `yTopMin < yBottomMax`（定界有效、高度为正，否则渲染端会隐藏）；
     *  · 同拍上下两块的**分界必须吻合**（上层 `yBottomMax` == 下层 `yTopMin`，误差 < 0.01）
     *    ——不吻合就会出现缝或重叠。
     */
    {
      const seg = seq719.events.filter((e) => e.placed.segment?.layer === 'upper' && e.placed.segment.type === 'dsb')
      const low = seq719.events.filter((e) => isDsbOutside(e.placed))
      const noSeg = (arr: typeof seg) => arr.filter((e) => (e.playheadSegs ?? []).length === 0)
      /**
       * `{dsb}` 两层的色块**必须带动态定界**（`adj429`：上层 `[y−1.1ns, midEqual]`、
       * 下层 `[midEqual, y+0.6ns]`）——没有定界时渲染端走"单声部默认"，两块会**互相压住**。
       * 只查 `{dsb}` 的上下层（别的层走默认是合规的）。
       */
      const badSeg = seg.filter((e) =>
        (e.playheadSegs ?? []).some((s) => !(s.yTopMin !== undefined && s.yBottomMax !== undefined && s.yTopMin < s.yBottomMax)),
      )
      const badLow = low.filter((e) =>
        (e.playheadSegs ?? []).some((s) => !(s.yTopMin !== undefined && s.yBottomMax !== undefined && s.yTopMin < s.yBottomMax)),
      )
      /** 同拍上下分界吻合：同刻配对后，上层 `yBottomMax` == 下层 `yTopMin` */
      const mid = (e: (typeof seg)[number]) => (e.playheadSegs ?? [])[0]
      let mismatch = 0
      let paired = 0
      for (const u of seg) {
        const l = low.find((x) => Math.abs(x.atMs - u.atMs) < 1e-6)
        const mu = mid(u)
        const ml = l ? mid(l) : undefined
        if (mu && ml) {
          paired++
          if (Math.abs((mu.yBottomMax ?? 0) - (ml.yTopMin ?? -1)) > 0.01) mismatch++
        }
      }
      check('Z24 adj720 用户原谱：`{dsb}` 上下两层**都有色块**、定界有效、同拍分界吻合',
        seg.length > 0 &&
          low.length > 0 &&
          noSeg(seg).length === 0 &&
          noSeg(low).length === 0 &&
          badSeg.length === 0 &&
          badLow.length === 0 &&
          paired > 0 &&
          mismatch === 0,
        `上层无色块 ${noSeg(seg).length} / 下层无色块 ${noSeg(low).length} / ` +
          `上层定界无效 ${badSeg.length} / 下层定界无效 ${badLow.length} / 配成 ${paired} 对、分界不吻合 ${mismatch}`)
    }
  }
}

// ---- adj429：色块按曲行几何动态定界（多声部/临时段不再互相覆盖、不压歌词）----
// 旧实现 `y−1.6×字号 ~ y+0.6×字号` 在三类场景出问题（用户报）：
//  ① 多声部 Q1↔Q2 各自 28.6 px 高、基线仅差 ~22 px ⇒ 重叠 3.6 px；
//  ② dsb 上下层基线差 dy=22、各自 28.6 px ⇒ 重叠 17.6 px；
//  ③ bz 上层与主旋律相隔 dy=22、各自 28.6 px ⇒ 重叠 ~6.6 px；
// 修复：playheadSegs 携带 `yTopMin`/`yBottomMax`（按 voiceBlock.voiceCenters 中线 / 段层对侧基线分块）。
console.log('[adj429] playheadSegs color-block bounds (no overlap, no lyric press)')
{
  const ns = DUR_CFG.note_size
  // V1：单声部 → 不设 yTopMin/yBottomMax（走渲染端默认；保持 adj299 既有观感零回归）
  {
    const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 1 2 3 4 | 5 6 7 1' |\n"
    const parseResult = parseJps(src)
    const seq = buildPlaySequence(parseResult, layoutScore(parseResult, DUR_CFG), 120, undefined, '大钢琴')
    const segs = seq.events.flatMap((e) => e.playheadSegs ?? [])
    const withBounds = segs.filter((s) => s.yTopMin !== undefined || s.yBottomMax !== undefined)
    check('V1 单声部 playheadSegs 不带 yTopMin/yBottomMax（默认定界、零回归）', withBounds.length === 0, `withBounds=${withBounds.length}`)
  }
  // V2：多声部 Q1+Q2 → Q1 底部 ≤ Q1/Q2 中线、Q2 顶部 ≥ Q1/Q2 中线（互不重叠）
  {
    const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ1: 1 2 3 4 | 5 6 7 1' |\nQ2: 5 6 5 3 | 1 2 3 4 |\n"
    const parseResult = parseJps(src)
    const lay = layoutScore(parseResult, DUR_CFG)
    const seq = buildPlaySequence(parseResult, lay, 120, undefined, '大钢琴')
    // 取 Q1 和 Q2 各自的某个事件（来自 page.voiceBlocks）
    const q1Seg = seq.events.find((e) => e.placed.id.voice === 1 && !e.placed.segment)?.playheadSegs?.[0]
    const q2Seg = seq.events.find((e) => e.placed.id.voice === 2 && !e.placed.segment)?.playheadSegs?.[0]
    check('V2 多声部：Q1 段带 yTopMin/yBottomMax', q1Seg !== undefined && q1Seg.yTopMin !== undefined && q1Seg.yBottomMax !== undefined, `q1Seg=${JSON.stringify(q1Seg)}`)
    check('V2 多声部：Q2 段带 yTopMin/yBottomMax', q2Seg !== undefined && q2Seg.yTopMin !== undefined && q2Seg.yBottomMax !== undefined, `q2Seg=${JSON.stringify(q2Seg)}`)
    if (q1Seg?.yBottomMax !== undefined && q2Seg?.yTopMin !== undefined) {
      check('V2 多声部 Q1 底部 ≤ Q2 顶部（不重叠）', q1Seg.yBottomMax <= q2Seg.yTopMin + 0.01, `q1.bot=${q1Seg.yBottomMax.toFixed(2)} q2.top=${q2Seg.yTopMin.toFixed(2)}`)
    }
  }
  // V3：dsb 上下层 → 上层底部 ≤ 上下层中线、下层顶部 ≥ 中线
  {
    const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {dsb 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
    // 重要：parseJps 只调一次，layout 和 sequence 共用同一个 ParseResult（否则段层 token 与
    // placed 的 token 对象身份不同 → segPlacedByToken.get(t) 查不到，段层事件根本不补发）。
    const parseResult = parseJps(src)
    const lay = layoutScore(parseResult, DUR_CFG)
    const seq = buildPlaySequence(parseResult, lay, 120, undefined, '大钢琴')
    const upperSeg = seq.events.find((e) => e.placed.segment?.type === 'dsb' && e.placed.segment?.layer === 'upper')?.playheadSegs?.[0]
    const lowerSeg = seq.events.find((e) => isDsbOutside(e.placed))?.playheadSegs?.[0]
    check('V3 dsb upper 带 yTopMin/yBottomMax', upperSeg?.yTopMin !== undefined && upperSeg?.yBottomMax !== undefined, `up=${JSON.stringify(upperSeg)}`)
    check('V3 dsb lower 带 yTopMin/yBottomMax', lowerSeg?.yTopMin !== undefined && lowerSeg?.yBottomMax !== undefined, `lo=${JSON.stringify(lowerSeg)}`)
    const upH = (upperSeg?.yBottomMax ?? 0) - (upperSeg?.yTopMin ?? 0)
    const loH = (lowerSeg?.yBottomMax ?? 0) - (lowerSeg?.yTopMin ?? 0)
    if (upperSeg?.yBottomMax !== undefined && lowerSeg?.yTopMin !== undefined) {
      check('V3 dsb upper 底部 ≤ lower 顶部（不重叠）', upperSeg.yBottomMax <= lowerSeg.yTopMin + 0.01, `up.bot=${upperSeg.yBottomMax.toFixed(2)} lo.top=${lowerSeg.yTopMin.toFixed(2)}`)
      // adj429b：用户建议——dsb 上下色块**严格等高**（用 0.25×ns 中线偏移消化 TOP/BOT 不对称）
      check('V3b dsb 上下色块**严格等高**（误差 < 0.1 px）', Math.abs(upH - loH) < 0.1, `upH=${upH.toFixed(2)} loH=${loH.toFixed(2)} 差=${(upH - loH).toFixed(2)}`)
    }
    // V3c：色块高度 ≥ 4 px（不到则隐藏；这里默认 dy=22 ⇒ 两层各约 22 px，满足）
    check('V3c dsb 上下色块高度 ≥ 4 px（最小可见）', upH >= 4 && loH >= 4, `upH=${upH.toFixed(2)} loH=${loH.toFixed(2)}`)
  }
  // V4：bz 上层 → 底部 ≤ 主旋律色块顶（不重叠）
  {
    const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {bz 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
    const parseResult = parseJps(src)
    const lay = layoutScore(parseResult, DUR_CFG)
    const seq = buildPlaySequence(parseResult, lay, 120, undefined, '大钢琴')
    const bzSeg = seq.events.find((e) => e.placed.segment?.type === 'bz')?.playheadSegs?.[0]
    const melodySeg = seq.events.find((e) => !e.placed.segment && e.placed.id.voice === 1)?.playheadSegs?.[0]
    check('V4 bz upper 带 yTopMin/yBottomMax', bzSeg?.yTopMin !== undefined && bzSeg?.yBottomMax !== undefined, `bz=${JSON.stringify(bzSeg)}`)
    // bz 主旋律是普通主声部 → melodySeg 默认无 bounds；用 melodySeg.y 推它的色块顶（−1.6×字号）
    if (bzSeg?.yBottomMax !== undefined && melodySeg) {
      const melodyBlockTop = melodySeg.y - ns * 1.6
      check('V4 bz upper 底部 ≤ 主旋律色块顶（不重叠）', bzSeg.yBottomMax <= melodyBlockTop + 0.01, `bz.bot=${bzSeg.yBottomMax.toFixed(2)} melody.top=${melodyBlockTop.toFixed(2)}`)
    }
    // V4b：bz 色块高度 ≥ 4 px（默认 dy=22 ⇒ 22 − 1.1×字号 + 1.1×字号 − 0.5 = 21.5 px ≥ 4 ✓）
    const h = (bzSeg?.yBottomMax ?? 0) - (bzSeg?.yTopMin ?? 0)
    check('V4b bz 色块高度 ≥ 4 px（最小可见）', h >= 4, `h=${h.toFixed(2)}`)
  }
  // V5：把 dsb dy 调到 60 → 上下色块应更高（动态定界确实响应设置）
  {
    const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {dsb 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
    const parseResult = parseJps(src)
    const cfg = { ...DUR_CFG, segmentRowGap: { dsb: 60 } }
    const lay = layoutScore(parseResult, cfg)
    const seq = buildPlaySequence(parseResult, lay, 120, undefined, '大钢琴')
    const upperSeg = seq.events.find((e) => e.placed.segment?.type === 'dsb' && e.placed.segment?.layer === 'upper')?.playheadSegs?.[0]
    const lowerSeg = seq.events.find((e) => isDsbOutside(e.placed))?.playheadSegs?.[0]
    const upH = (upperSeg?.yBottomMax ?? 0) - (upperSeg?.yTopMin ?? 0)
    const loH = (lowerSeg?.yBottomMax ?? 0) - (lowerSeg?.yTopMin ?? 0)
    // adj429b：dsb 上下色块**严格等高**（不依赖 dy 大小）——用户建议，视觉更均衡
    check('V5 dsb dy=60 → 上下色块**严格等高** + 均 ≥ 30 px', upH > 30 && loH > 30 && Math.abs(upH - loH) < 0.1, `upH=${upH.toFixed(2)} loH=${loH.toFixed(2)} 差=${(upH - loH).toFixed(2)}`)
  }
}

// ---- adj430：段内音 bx0/bx1 拍位映射 + 整体按比例缩到段宽内（不丢失段内容） ----
// 用户原例：`|"p:2/4" {bz 8 &zkh 2'/ 3'/ } 6, - |` —— 段内 8(1 拍) + 2'/(0.5 拍) + 3'/(0.5 拍) 共 2 拍，
// 与主旋律 `6, -`（2 拍）拍数一致。但 `beatToX(envStart+1)` 走 spans[1]=下一小节音符插值，落在
// 主旋律 `|` 右侧 ⇒ 旧实现下 `2'/ 3'/` 的 bx0 > xContent1 ⇒ `bx1 ≤ bx0` 跳过，**两个音不显示**。
// 修复：拍位自然映射总宽 > xContent1 − xContent0 时**整体按比例缩放到段宽内**，段首/段末仍
// 对齐 xContent0/xContent1（U8a/U8b），中间按比例（段内音不丢失）。
console.log('[adj430] segment note beat-anchor + scale-fit within envelope')
{
  const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 6,/ 3// (2// 2) 2/&rit 3/ 6,/ 5,/&yc |\"p:2/4\" {bz 8 &zkh 2'/ 3'/ } 6, - | 6 5 |\n"
  const parseResult = parseJps(src)
  const lay = layoutScore(parseResult, defaultPageConfig)
  const page = lay.pages[0]
  const segNotes = page.notes.filter((n) => n.segment).sort((a, b) => a.x - b.x)
  // W6a：段层至少 3 个 placedToken（rest 8 + 2'/ + 3'/）——`2'/ 3'/` 不丢失
  check('W6a 用户原例 {bz 8 &zkh 2\'/ 3\'/ } → 段层 3 个 placedToken（不丢失 2\'/ 3\'/）', segNotes.length === 3, `got ${segNotes.length}: ${segNotes.map((n) => n.token.kind).join(',')}`)
  // W6b：每个段层音宽度 > 0（不缩成 0 宽）
  check('W6b 段层每个音宽度 > 0（不缩成 0 宽）', segNotes.every((n) => n.width > 0.5), `widths=${segNotes.map((n) => n.width.toFixed(2)).join(',')}`)
  // W6c：段层三个音按拍位顺序排列（bx0 单调递增）
  check('W6c 段层三个音 bx0 单调递增（按拍位顺序）', segNotes[0].x < segNotes[1].x && segNotes[1].x < segNotes[2].x, `x=${segNotes.map((n) => n.x.toFixed(2)).join(',')}`)
  // W6d：段层最右音 bx1 ≤ 主旋律包络后小节线 x（不溢出段右界）
  const melodyBarAfter = page.barlines.find((b) => !b.segment && b.x > segNotes[0].x + 5)?.x ?? 0
  check('W6d 段层最右音 bx1 ≤ 主旋律包络后小节线（不溢出）',
    (segNotes[2].rightX ?? 0) <= melodyBarAfter + 0.5,
    `rightX=${(segNotes[2].rightX ?? 0).toFixed(2)} nextBar=${melodyBarAfter.toFixed(2)}`)
  // W6e：段层音总宽 = 段内容宽（用户原例只有 &zkh 无 &ykh ⇒ tailPad=0，段铺到小节线）
  const totalW = (segNotes[2].rightX ?? segNotes[2].x + segNotes[2].width) - segNotes[0].x
  check('W6e 段层音总宽 = 段内容宽（合理范围 60~130，bz 有 lead bracket 时更宽）',
    totalW > 60 && totalW < 130,
    `totalW=${totalW.toFixed(2)}`)

  // adj431：zkh 必须**靠近 2'/（第一个发声音）**而不是 hidden rest（8）的左缘——
  // 例：`{bz 8 &zkh 2'/ 3'/}` 的 `&zkh` 应该紧贴 `2'/`（= 第一个发声音），而不是紧贴 `8`（= xContent0）。
  const zk = page.brackets.find((b) => b.code === 'zkh')
  const firstPlayed = segNotes.find((n) => !(n.token.kind === 'rest' && (n.token as { hidden?: boolean }).hidden))
  check('W6f &zkh 靠近段内第一个发声音（不在 hidden rest 8 之前）',
    zk !== undefined && firstPlayed !== undefined &&
      Math.abs(zk.x - firstPlayed.x) < 20,  // zkh 中心离 2'/ 中心 < 20 px
    `zkh.x=${zk?.x.toFixed(2)} firstPlayed.x=${firstPlayed?.x.toFixed(2)} firstPlayed.kind=${firstPlayed?.token.kind}`)
}

// ---- adj432：色块按声部角色着色（bz upper 蓝 / dsb upper 红 / dsb lower 绿）+ 段层拖动虚线 ----
console.log('[adj432] segment color-block voice colors + segment row guides')
{
  const ns432 = DUR_CFG.note_size
  const bz432 = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {bz 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  const dsb432 = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {dsb 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  // X1：§PlayheadSeg.playVoice 透传到事件（bz upper = accomp）
