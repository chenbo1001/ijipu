check('adj460 <++--- 拆为 <++ ---（渐强抬升后 augment）', formatLine('Q: <++---') === 'Q: <++ ---', formatLine('Q: <++---'))
check('adj460 >+-- 拆为 >+ --', formatLine('Q: >+--') === 'Q: >+ --', formatLine('Q: >+--'))
