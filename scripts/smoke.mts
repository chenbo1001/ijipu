 *  · `repeatCountAt` 统计：记完 `:|:` 自己的遍数后**段内计数归零**（否则紧随的 `:|`
 *    被算成"本段第 2 个"、count 偏大 ⇒ 该段多奏一遍）；
 *  · 走查里的 `repeatStart`：`:|:` 的**最后一次回跳**要把段落起点推进到**它自己**。
 */
{
  const H = 'V: 1.0\nB: t\nD: C\nP: 4/4\n'
  const order = (q: string) => {
    const lay = layoutScore(parseJps(H + `Q: ${q}\n`), defaultPageConfig)
    const byIdx = new Map<number, string>()
    for (const pg of lay.pages) for (const n of pg.notes) if (!n.segment) byIdx.set(n.id.index, String(n.token.raw ?? ''))
    return buildPlaySequence(parseJps(H + `Q: ${q}\n`), lay, 60)
      .events.filter((e) => !e.placed.segment)
      .sort((a, b) => a.atMs - b.atMs)
      .map((e) => byIdx.get(e.placed.id.index) ?? '?')
      .join(' ')
  }
  // 用户报的那条：`12` 修前奏 3 遍
  // ⚠ `11` 在本引擎里是**两个音**（`1` `1`），故期望写成单音展开
  check('adj723x 用户例 `11:\\|: 12:\\| 13\\|: 14 :\\|` ⇒ `1 1 · 1 1 · 1 2 · 1 2 · 1 3 · 1 4 · 1 4`',
    order('11:|: 12:| 13|: 14 :|') === '1 1 1 1 1 2 1 2 1 3 1 4 1 4', order('11:|: 12:| 13|: 14 :|'))
