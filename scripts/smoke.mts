// ---- adj672（用户要求）：歌词注释（`C: 一"注释" 二`）不得与歌词重叠 ----
console.log('[adj672] lyric comment avoidance')
{
  const H = 'V: 1.0\nB: t\nD: C\nP: 4/4\n'
  const D = defaultPageConfig
  const cfs = lyricCommentFontSize(D.geci_size)
  const mk = (lyric: string) => H + "Q: 1 2 3 4 | 5 6 7 1' |\nC: " + lyric + '\n'
  /** 墨迹盒（与布局避让同一口径：高 = 字号 × 1.1，中心在基线上方 0.3 字号处） */
  const boxOf = (x: number, y: number, w: number, h: number) => ({ x1: x, x2: x + w, y1: y - h * 0.85, y2: y + h * 0.25 })
  const overlap = (a: ReturnType<typeof boxOf>, b: ReturnType<typeof boxOf>): boolean =>
    a.x1 < b.x2 - 0.01 && a.x2 > b.x1 + 0.01 && a.y1 < b.y2 - 0.01 && a.y2 > b.y1 + 0.01
  /**
   * L1（adj672 历史口径 + **adj701 修订**）：注释水平位置**恒为"右缘贴锚字左缘"**
   * （`l.x − w − LYRIC_COMMENT_GAP`，即"靠近后面的歌词"）；
   * 竖直方向：该水平线放得下就同基线，**放不下（压到字/标点/曲部音符）就上/下错开**，
   * 且**不允许靠横向挪开**去躲——那会变成"离后面的歌词很远"（用户口径明确否掉）。
   */
  {
    const pg = layoutScore(parseJps(mk('一"略"二 三 四')), D).pages[0]
    const l = pg.lyrics.find((x) => x.char.note)
    const w = lyricCommentWidth(l?.char.note ?? '', cfs)
    check('L1 adj672/708 放得下时：注释**右缘贴锚字左缘**（=`right − w`，靠近后面的歌词）',
      l !== undefined && l.noteX !== undefined && Math.abs(l.noteX - (l.x - w - LYRIC_COMMENT_GAP)) < 0.11,
      `noteX=${l?.noteX} want=${l ? (l.x - w - LYRIC_COMMENT_GAP).toFixed(1) : '-'}`)
    const cb = boxOf(l?.noteX ?? 0, l?.noteY ?? 0, w, cfs)
    const hit =
      pg.lyrics.some((o) => o !== l && overlap(cb, boxOf(o.x, o.y, D.geci_size, D.geci_size))) ||
      pg.notes.some((n) => overlap(cb, boxOf(n.x, n.y - D.note_size * 0.8, D.note_size, D.note_size * 1.5)))
    check('L1b adj701 注释竖直方向**不压任何墨迹**（本用例被第 2 个音符占位 ⇒ 正确地上/下错开）',
      l !== undefined && !hit, `noteX=${l?.noteX} noteY=${l?.noteY} y=${l?.y} hit=${hit}`)
  }
  // L2/L3：挤在一起 ⇒ ① 不与任何歌词字/曲部音符重叠 ② 确实上下错开了
  for (const [nm, lyric] of [['一注释', '一二三四"副歌部分"五'], ['两注释', '一"甲注释"二"乙注释"三']] as const) {
    const pg = layoutScore(parseJps(mk(lyric)), D).pages[0]
    const mine = pg.lyrics.filter((x) => x.char.note)
    const bad = mine.filter((l) => {
      const wl = lyricCommentWidth(l.char.note ?? '', cfs) * (l.noteSx ?? 1)
      const cb = boxOf(l.noteX ?? 0, l.noteY ?? 0, wl, cfs)
      return pg.lyrics.some((o) => o !== l && overlap(cb, boxOf(o.x, o.y, D.geci_size, D.geci_size)))
    })
    check(`L2[${nm}] adj672/677 歌词注释（压缩后）不与**歌词字**重叠`, mine.length > 0 && bad.length === 0,
      `n=${mine.length} bad=${bad.map((l) => l.char.note).join(',')}`)
    check(`L3[${nm}] adj683 容不下时注释**移到后字的上/下位置**（不再压缩、不动歌词字）`,
      mine.length > 0 && mine.every((l) => Math.abs((l.noteY ?? 0) - l.y) > 1 && (l.noteSx ?? 1) >= 0.999),
      JSON.stringify(mine.map((l) => ({ t: l.char.note, dy: (l.noteY ?? 0) - l.y, sx: l.noteSx }))))
  }
  /**
   * L7（adj700，用户报「`知否，@"女."知否` 里的 `女.` 与前面的歌词重叠」）：
   * 障碍集必须含**后缀标点**（`，。` 等不占音符位、由渲染端紧跟本字独立画出，但**是墨迹**）。
   *
   * 原实现只量到邻居**字本体**右缘，于是"空档"看起来放得下 ⇒ 注释就地画下去、正好压在后缀标点上
   * （实测「否」本体 251.9~262.9、`，` 263.9~274.9，注释右缘 264.6 压在 `，` 上）。
   */
  {
    const pg = layoutScore(parseJps(mk('否，@"男."知否，@应是绿@@肥@红瘦')), D).pages[0]
    /** 字 + 其后缀标点 的墨迹盒 */
    const withTrail = (o: (typeof pg.lyrics)[number]) => {
      const trail = o.char.trailing ?? ''
      const w = D.geci_size + (trail ? D.geci_size : 0)
      return boxOf(o.x, o.y, w, D.geci_size)
    }
    const mine = pg.lyrics.filter((x) => x.char.note)
    const bad = mine.filter((l) => {
      const wl = lyricCommentWidth(l.char.note ?? '', cfs) * (l.noteSx ?? 1)
      const cb = boxOf(l.noteX ?? 0, l.noteY ?? 0, wl, cfs)
      return pg.lyrics.some((o) => o !== l && overlap(cb, withTrail(o)))
    })
    check('L7 adj700 歌词注释不与"歌词字 + 其后缀标点"重叠（`知否，@"女."知否`）',
      mine.length > 0 && bad.length === 0, `n=${mine.length} bad=${bad.map((l) => l.char.note).join(',')}`)
  }
  // L4：渲染端**直接用**布局给的锚点（否则"布局避让一套、渲染画另一套"）
  {
    const code = mk('一二三四"副歌部分"五')
    const pg = layoutScore(parseJps(code), D).pages[0]
    const l = pg.lyrics.find((x) => x.char.note)
    const svg = renderScoreToSvg(layoutScore(parseJps(code), D))[0]
    check('L4 adj672/683 渲染直接采用布局锚点（注释 x/y 与布局一致，位置只有布局一个来源）',
      l !== undefined && svg.includes(`y="${l.noteY}"`) && svg.includes(`x="${l.noteX}"`),
      `noteX=${l?.noteX} noteY=${l?.noteY} y=${l?.y}`)
    /**
     * L5（**adj708 修订**，用户口径）：「注释**不与歌词重叠**；水平方向放得下就**靠近后面的歌词**；
     * 放不下则放在后面歌词的**上/下**位置」。
     *
     * 判据（适用于所有用例）：每个注释要么
     *  · 与锚字**同基线**且右缘贴锚字左缘（`l.x − LYRIC_COMMENT_GAP`，= 最靠近后字）；要么
     *  · 已**上/下错开**（同基线的位置放不下，按规范退到后字的上/下）。
     * 两种都合规；**不允许**出现"停在同基线、却被挤到撞上别的字"的落点。
     */
    check('L5 adj708 注释：同基线则**右缘贴锚字左缘**，否则**上/下错开**（不与歌词重叠）',
      pg.lyrics.filter((x) => x.char.note).length > 0 &&
        pg.lyrics
          .filter((x) => x.char.note)
          .every((l) => {
            const wl = lyricCommentWidth(l.char.note ?? '', cfs) * (l.noteSx ?? 1)
            const sameLine = Math.abs((l.noteY ?? 0) - l.y) < 0.11
            if (!sameLine) return true // 已按规范上/下错开
            return Math.abs((l.noteX ?? 0) + wl - (l.x - LYRIC_COMMENT_GAP)) < 0.11
          }),
      JSON.stringify(
        pg.lyrics.filter((x) => x.char.note).map((l) => ({ t: l.char.note, noteX: l.noteX, noteY: l.noteY, y: l.y, 锚x: l.x })),
      ))
    /**
     * L9（**adj711**，用户看图定标）：「同水平放不下时，注释应放在**后面**歌词的正上/下方，
     * 而不是**前面**歌词的正上/下方」。
     *
     * 判据：凡**已上/下错开**的注释，横向**必须中心对齐锚字**
     * （`noteX + w/2 === 锚x + geci_size/2`，容差 0.6px）——
     * 旧候选顺序把"靠右 + 错开"排在"锚字中心 + 错开"之前，错开后横向仍贴右边，
     * 于是飘到**前一字**正上方（用户截图：`女.` 在「否」上面而不是「知」上面）。
     */
    check('L9 adj711 上/下错开的注释**中心对齐其后字**（不飘到前一字上方）',
      pg.lyrics.filter((x) => x.char.note).length > 0 &&
        pg.lyrics
          .filter((x) => x.char.note)
          .every((l) => {
            if (Math.abs((l.noteY ?? 0) - l.y) < 0.11) return true // 同水平的不在此断言范围
            const wl = lyricCommentWidth(l.char.note ?? '', cfs) * (l.noteSx ?? 1)
            return Math.abs((l.noteX ?? 0) + wl / 2 - (l.x + D.geci_size / 2)) < 0.6
          }),
      JSON.stringify(
        pg.lyrics
          .filter((x) => x.char.note)
          .map((l) => {
            const wl = lyricCommentWidth(l.char.note ?? '', cfs) * (l.noteSx ?? 1)
            return { t: l.char.note, 注中心: Number(((l.noteX ?? 0) + wl / 2).toFixed(1)), 锚中心: Number((l.x + D.geci_size / 2).toFixed(1)), dy: Number(((l.noteY ?? 0) - l.y).toFixed(2)) }
          }),
      ))
  }
  /**
   * L6/L7/L8（adj683，用户最终规则）：
   *  · 注释**只能**在前后两字之间调整 ⇒ 不许推动音符（`L6`）也不许推动歌词字；
   *  · 容不下时**移到后字的上/下位置**、不再横向压缩（`L7`）；
   *  · **同一个 `C:` 行的歌词字始终在同一水平线上**（含临时多声部里的歌词，`L8`）。
   */
  {
    const noC = layoutScore(parseJps(mk('一二三四五')), D).pages[0]
    const hasC = layoutScore(parseJps(mk('一二三四"副歌部分"五')), D).pages[0]
    const nSig = (p: typeof noC) => p.notes.filter((n) => !n.segment).map((n) => `${n.x.toFixed(2)}/${n.width.toFixed(2)}`).join(',')
    check('L6 adj683 歌词注释**不影响音符位置**（不占音符位：带注释与不带注释逐音符一致）',
      nSig(noC) === nSig(hasC),
      `无注释=${nSig(noC).slice(0, 60)} 有注释=${nSig(hasC).slice(0, 60)}`)
    const lc = hasC.lyrics.find((l) => l.char.note)
    check('L7 adj683 空档放不下时注释**移到后字的上/下位置**（不压缩）',
      lc !== undefined && Math.abs((lc.noteY ?? 0) - lc.y) > 1 && (lc.noteSx ?? 1) >= 0.999,
      `dy=${lc ? ((lc.noteY ?? 0) - lc.y).toFixed(1) : '-'} sx=${lc?.noteSx}`)
    // L8：同一 `C:` 行（同一 line）的歌词字 y 必须完全一致——含临时多声部里的歌词
    const dsb = layoutScore(parseJps(H + 'Q: {dsb 1 2 3 4 } 5 6 7 1\' |\nC: 一二三"注"四 五 六\n'), D).pages[0]
    const byLine = new Map<number, number[]>()
    for (const l of dsb.lyrics) {
      const k = l.line ?? -1
      byLine.set(k, [...(byLine.get(k) ?? []), l.y])
    }
    check('L8 adj683 同一 `C:` 行（含临时多声部）的歌词字**同一水平线**',
      byLine.size > 0 && [...byLine.values()].every((ys) => Math.max(...ys) - Math.min(...ys) < 0.11),
      JSON.stringify([...byLine.entries()].map(([k, ys]) => [k, [...new Set(ys.map((y) => y.toFixed(1)))] ])))
  }
}
console.log('[adj427] per-beat width uniform across measures')
{
  const src = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {bz 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  const srcDsb = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {dsb 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  const SPC2 = { ...defaultPageConfig, noteSpaceLayout: 'space' as const }
  const diffs = (code: string, cfg: typeof DUR_CFG): number[] => {
    const pg = layoutScore(parseJps(code), cfg).pages[0]
    const bars = [...new Set(pg.notes.filter((n) => !n.segment).map((n) => n.barIndex))]
    const out: number[] = []
    for (const bi of bars) {
      const ns2 = pg.notes.filter((n) => !n.segment && n.barIndex === bi).sort((a, b) => a.x - b.x)
      for (let i = 1; i < ns2.length; i++) out.push(ns2[i].x - ns2[i - 1].x)
    }
    return out
  }
  for (const [nm, cfg] of [['空间优先(默认)', SPC2], ['时值优先', DUR_CFG]] as const) {
    for (const [tag, code] of [['bz', src], ['dsb', srcDsb]] as const) {
      const d = diffs(code, cfg)
      const lo2 = Math.min(...d)
      const hi2 = Math.max(...d)
      /**
       * adj674（用户选择方案 B）：`{dsb}` 现在会**为它的大括号预留横向空间**（从本行富余里匀），
       * 于是"包络边界所在的那一拍"必然比其他拍宽一些——这是用户明确接受的代价。
       * 所以含 `{dsb}` 的行阈值放宽到 1.2（`{bz}` 无大括号、仍是 1.05 的严格口径）。
       */
      const limit = tag === 'dsb' ? 1.2 : 1.05
      check(
        `Y1[${nm}/${tag}] 各小节每拍占宽均匀（max/min ≤ ${limit}）`,
        d.length >= 6 && hi2 / lo2 <= limit,
        `每拍占宽=${d.map((v) => v.toFixed(1)).join(',')} 比值=${(hi2 / lo2).toFixed(3)}`,
      )
    }
  }
  // Y2：段内拍与「3 4」小节的每拍占宽**逐一相等**（同一行内不得有差异）
  {
    const pg = layoutScore(parseJps(src), SPC2).pages[0]
    const d = diffs(src, SPC2)
    check('Y2 空间优先：段内拍与 `3 4` 小节每拍占宽一致', Math.max(...d) - Math.min(...d) < 0.6, `差=${(Math.max(...d) - Math.min(...d)).toFixed(2)}px`)
  }
}

// ---- adj428：临时段上下层纵向间距 `segmentRowGap` 可调（bz/dsb 分别独立）----
// 用户原例：硬编码 `note_size × 1.7 ≈ 22.1px`（ns=13）。允许在设置面板里改 `segmentRowGap.{bz,dsb}`。
// 几何期望：
//   - bz：主旋律行基线 yRow 不动；段层 yUpper = yRow − segmentRowGap.bz。
//   - dsb：包络内主旋律 yIn = yRow + segmentRowGap.dsb / 2；段层 yUpper = yRow − segmentRowGap.dsb / 2；
//         两层中线 = yRow（整块居中不变）。
console.log('[adj428] segmentRowGap (bz/dsb) configurable')
{
  const srcBz = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {bz 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  const srcDsb = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 3 4 | {dsb 1 2 3 4 | 5 6 7 1'} 5 6 7 1' | 1' 7 6 5 | 5 5\n"
  // 取主旋律包络外的音作为「行基线 yRow」参考（不受段影响）
  const rowYOf = (pg: ReturnType<typeof layoutScore>['pages'][number]): number => {
    const mains = pg.notes.filter((n) => !n.segment)
    const ys = [...new Set(mains.map((n) => n.y))].sort((a, b) => a - b)
    return ys[0]
  }
  // Y3：bz 默认间距 = 22 px（与 adj427 原值 ≈`note_size × 1.7` 一致，零回归）
  {
    const pg = layoutScore(parseJps(srcBz), DUR_CFG).pages[0]
    const yRow = rowYOf(pg)
    const segY = pg.notes.find((n) => n.segment)?.y
    check('Y3 bz 默认间距 = 22 px（adj428 零回归）', segY !== undefined && Math.abs((yRow - segY) - 22) < 0.11, `gap=${(yRow - (segY ?? 0)).toFixed(2)}`)
  }
  // Y4：dsb 默认间距 = 22 px（包络内主旋律下移 11、段层上移 11）
  {
    const pg = layoutScore(parseJps(srcDsb), DUR_CFG).pages[0]
    const yRow = rowYOf(pg)
    const mains = pg.notes.filter((n) => !n.segment)
    const ys = [...new Set(mains.map((n) => n.y))].sort((a, b) => a - b)
    const yIn = ys[1]
    const segY = pg.notes.find((n) => n.segment)?.y
    /**
     * Y4（adj670 改写）：dsb 的层间距是 `max(22, 放得下两层内容所需的最小值)`——
     * 本例段内是 `(3// 2// 1//)` 等（2 条减时线）且下层有连音线 ⇒ **会超过 22**。
     * 断言语义改为"整块仍与行基线居中 + 间距 ≥ 22"。
     */
    const gapY = yIn !== undefined && segY !== undefined ? yIn - segY : 0
    check('Y4 adj670 dsb 层间距 ≥ 22 px（按需撑开仍整块居中）',
      yIn !== undefined && segY !== undefined && gapY >= 22 - 0.11 && Math.abs((yIn - yRow) - gapY / 2) < 0.11 && Math.abs((yRow - segY) - gapY / 2) < 0.11,
      `yRow=${yRow.toFixed(2)} yIn=${yIn?.toFixed(2)} segY=${segY?.toFixed(2)} gap=${gapY.toFixed(2)}`,
    )
  }
  // Y5：bz 把 segmentRowGap.bz 改成 40 → 段层 y = yRow − 40（主旋律 yRow 不动）
  {
    const cfg = { ...DUR_CFG, segmentRowGap: { bz: 40 } }
    const pg = layoutScore(parseJps(srcBz), cfg).pages[0]
    const yRow = rowYOf(pg)
    const segY = pg.notes.find((n) => n.segment)?.y
    check('Y5 bz segmentRowGap=40 → 段层 y = yRow − 40（主旋律不动）',
      segY !== undefined && Math.abs((yRow - segY) - 40) < 0.11,
      `gap=${(yRow - (segY ?? 0)).toFixed(2)}`,
    )
  }
  // Y6：dsb 把 segmentRowGap.dsb 改成 50 → 段层 / 包络内主旋律 各偏移 25
  {
    const cfg = { ...DUR_CFG, segmentRowGap: { dsb: 50 } }
    const pg = layoutScore(parseJps(srcDsb), cfg).pages[0]
    const yRow = rowYOf(pg)
    const mains = pg.notes.filter((n) => !n.segment)
    const ys = [...new Set(mains.map((n) => n.y))].sort((a, b) => a - b)
    const yIn = ys[1]
    const segY = pg.notes.find((n) => n.segment)?.y
    check('Y6 dsb segmentRowGap=50 → 上移/下移各 25（整块居中仍成立）',
      yIn !== undefined && segY !== undefined
        && Math.abs((yIn - yRow) - 25) < 0.11
        && Math.abs((yRow - segY) - 25) < 0.11
        && Math.abs(((segY + yIn) / 2) - yRow) < 0.11,
      `yRow=${yRow.toFixed(2)} yIn=${yIn?.toFixed(2)} segY=${segY?.toFixed(2)} mid=${((segY ?? 0) + (yIn ?? 0)) / 2}`,
    )
  }
}

