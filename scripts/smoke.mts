        pv: (e.playheadSegs ?? []).map((s) => s.playVoice ?? '-').join(','),
      }))
    console.log('    角色 | 段 | 层 | 音色 | 总拍 | 段数 | 各段宽 | 各段playVoice')
    for (const x of rows.slice(0, 14)) {
