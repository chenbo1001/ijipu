  const embedCfg = readSrc('vite.config.embed.mjs')
  check('adj876 嵌入版（Obsidian）入口也是 `app/index.html`（否则笔记里渲染出的是介绍页）',
    /input:\s*fileURLToPath\(new URL\(['"]\.\/app\/index\.html['"]/.test(embedCfg))
  check('adj876 嵌入版入口与网页版应用入口是**同一个文件**（都指 app/index.html ⇒ 不会各改各的）',
    embedCfg.includes('./app/index.html') && readSrc('vite.config.ts').includes("entry('./app/index.html')"))

  // ---- ⑤ SW 导航回退：把 sw.js 里的 fallbackFor **原文**抠出来直接跑 ----
  // 为什么不"抄一份逻辑到测试里"：抄一份测的是测试自己。而这段代码的失败模式（离线白屏）
  // 又只在断网时出现，靠人工基本测不到 ⇒ 必须让断言跑的就是线上那份源码。
  const swSrc = readSrc('public/sw.js')
  const region = swSrc.match(/\/\/ #region fallbackFor\r?\n([\s\S]*?)\/\/ #endregion/)
  check('adj876 sw.js 的 fallbackFor 带 `#region` / `#endregion` 标记（断言要靠它抠原文）', !!region)
  if (region) {
    const fallbackFor = new Function(`${region[1]}\nreturn fallbackFor`)() as (p: string) => string
    const cases: [string, string][] = [
      ['/', '/index.html'],
      ['/index.html', '/index.html'],
      ['/app', '/app/index.html'],
      ['/app/', '/app/index.html'],
      ['/app/index.html', '/app/index.html'],
      ['/manual/', '/manual/index.html'],
      ['/syntax/', '/syntax/index.html'],
      ['/plugin/', '/plugin/index.html'],
      ['/plugin', '/plugin/index.html'],
      ['/whatever', '/index.html'],
    ]
    const bad = cases
      .filter(([input, want]) => fallbackFor(input) !== want)
      .map(([input, want]) => `${input} → ${fallbackFor(input)}（应为 ${want}）`)
    check('adj876 SW 导航回退按路径分派（`/app/` 不再被喂成首页 HTML ⇒ 离线不白屏）',
      bad.length === 0, bad.join('；'))
    // 负对照：证明这条判据真的在量东西——退化成"一律回首页"必须判红
    const naive = () => '/index.html'
    check('adj876 负对照：回退逻辑若退化成"一律 /index.html" ⇒ 判据为假',
      cases.some(([input, want]) => naive() !== want))
  }
  check('adj876 SW 缓存名升到 v4（`/index.html` 这个键的含义变了，必须换名清掉旧应用缓存）',
    swSrc.includes("'jps-shell-v4'"))
  check('adj876 SW 预缓存含 PWA 启动页 `/app/index.html`（离线打开要能用）',
    swSrc.includes("'/app/index.html'"))

  // ---- ⑥ 文档页与应用内帮助同源：渲染器抽成了纯模块，且目录锚点与标题 id 逐个一致 ----
  const mdSrc = readSrc('src/help/markdown.ts')
  check('adj876 渲染器已从组件文件抽出（`src/help/markdown.ts` 导出 mdToHtml / extractToc）',
    mdSrc.includes('export function mdToHtml') && mdSrc.includes('export function extractToc'))
  check('adj876 DocDialog 不再自带渲染器（改为 import help/markdown ⇒ 不会再各写一份）',
    readSrc('src/dialogs/DocDialog.tsx').includes("from '../help/markdown'") &&
      !readSrc('src/dialogs/DocDialog.tsx').includes('function mdToHtml'))

  // 玩具用例：中文 + 标点 + 重复标题
  const toyMd = '# 一级标题\n\n正文\n\n## 1.1 带标点的标题（含括号）\n\n再正文\n\n## 1.1 带标点的标题（含括号）\n'
  const toyToc = extractToc(toyMd)
  const toyHtml = mdToHtml(toyMd)
  check('adj876 玩具用例：extractToc 只认标题行、且中文 slug 去掉了标点',
    toyToc.length === 3 && toyToc[1].id === '1-1-带标点的标题-含括号',
    toyToc.map((t) => `${t.level}:${t.id}`).join(' | '))
  check('adj876 玩具用例：重名标题自动去重（第二个加 `-2`，否则后一个锚点点不动）',
    toyToc[2].id === '1-1-带标点的标题-含括号-2', toyToc[2].id)

  // 真实文档：这才是要紧的——两份 .md 的**目录锚点与正文标题 id 必须逐个相同**
  for (const doc of ['docs/USER-GUIDE.md', 'docs/SYNTAX.md']) {
    const realMd = readSrc(doc)
    const realToc = extractToc(realMd)
    const realHtml = mdToHtml(realMd)
    const htmlIds = [...realHtml.matchAll(/<h[1-6] id="([^"]+)"/g)].map((m) => m[1])
    check(`adj876 ${doc}：目录锚点与正文标题 id 逐个相同（目录才点得动）`,
      realToc.length > 0 && JSON.stringify(realToc.map((t) => t.id)) === JSON.stringify(htmlIds),
      `目录 ${realToc.length} 条 / 正文 ${htmlIds.length} 个：${realToc.map((t) => t.id).slice(0, 3).join(',')}…`)
    check(`adj876 ${doc}：标题 id 无重复`, new Set(realToc.map((t) => t.id)).size === realToc.length)
    // 代码块里的 `# 注释行…` **不是**标题（`.jps` 注释就长这样，语法说明里到处都是）
    check(`adj876 ${doc}：目录里没有混进代码块内的 \`#\` 注释行`,
      !realToc.some((t) => t.text.startsWith('注释行')), realToc.filter((t) => t.text.startsWith('注释行')).map((t) => t.text).join('；'))
  }

  /**
   * ---- adj911（**用户反馈**）：手机端 ` ```jps ` 块被撑得很宽 ----
   *
   * 守的是**根因那两行**，不是 ` ```jps ` 组件本身：实测把 `.jps-block` 整块 `display:none`，
   * 页面宽度一个字都不变（4347 → 4347）⇒ 组件是**受害者**，宽度只是 100% 跟随了被撑宽的列。
   * 真凶是窄屏列定义退成了裸 `1fr`（自动下限 = 内容 min-content，被表格顶宽，实测 4327px）。
   * 手机视口的**实测**数字与判定归 `scripts/verify-site.mjs` 的同名断言（同样的负对照也在那边）。
   *
   * 为什么源码级还要再守一遍：这类"少写一个 `0`"的改动**在桌面上完全看不出来**
   * （桌面的列本来就是 `minmax(0, 1fr)`、有 `0` 下限），而 `npm run smoke` 不跑浏览器
   * ⇒ 至少把"这俩还在不在 860px 的媒体查询里"钉住，别等用户拿手机来报。
   */
  const docsCss = readSrc('src/docs/docs.css')
  /** 窄屏（860px）那一段里，"列有 0 下限" + "行内代码可断行" 是否都在 */
  const narrowDocsOk = (src: string) => {
    const block = /@media \(max-width: 860px\) \{[\s\S]*?\n\}/.exec(src)?.[0] ?? ''
    return (
      /\.doc-layout \{[^}]*grid-template-columns:\s*minmax\(0,\s*1fr\);/.test(block) &&
      /\.doc-body code \{[^}]*overflow-wrap:\s*anywhere;/.test(block)
    )
  }
  check('adj911 窄屏（860px）列定义是 `minmax(0, 1fr)` 且行内代码放开断行（裸 `1fr` 的自动下限会被表格 min-content 顶宽页面）',
    narrowDocsOk(docsCss),
    (docsCss.match(/@media \(max-width: 860px\) \{[\s\S]*?\n\}/)?.[0] ?? '(找不到窄屏媒体查询)').slice(0, 110).replace(/\n/g, '⏎'))
  // 负对照：判据必须真的在量这两条 —— 各自被改回去时都得判红（且先确认改动真的落到了文本上）
  const revertedCol = docsCss.replace(/grid-template-columns:\s*minmax\(0,\s*1fr\);/, 'grid-template-columns: 1fr;')
  const revertedWrap = docsCss.replace(/overflow-wrap:\s*anywhere;/, 'overflow-wrap: normal;')
  check('adj911 负对照：列改回裸 `1fr` ⇒ 判据为假；断行那条去掉 ⇒ 也为假（证明它真的在量这两条，而不是"文件里随便有没有"）',
    revertedCol !== docsCss && !narrowDocsOk(revertedCol) &&
      revertedWrap !== docsCss && !narrowDocsOk(revertedWrap))

  /**
   * ---- adj913（**用户实测**）：行内解析必须处理「反引号转义」 ----
   *
   * 由来：文档里要"在**句子中间**显示字面的三个反引号"，只能用转义写法
   * （源码里就是「反斜杠 + 反引号」，`docs/PLUGIN-GUIDE.md` 4 处 / `docs/SYNTAX.md` 2 处）。
   * Obsidian 自己的渲染器认这个转义，而站点渲染器**原来不认** ⇒ 网页上把反斜杠原样显示出来、
   * 后面再跟一个代码片（同一个写法在 Obsidian 与应用内帮助里正常、在官网文档页里不对）。
   *
   * 这里守**渲染器行为**（可在 Node 里直接断言）；"页面上真的长对了"由
   * `scripts/verify-site.mjs` 的同名断言在真浏览器里端到端验（含负对照）。
   * ⚠ 判据与负对照都**不许**用三连反引号字面量——本文件是 `.mts`，用 charCode 拼最省事。
   */
  const TICK = String.fromCharCode(96)
  const TICKS3 = TICK.repeat(3)
  /** 「反斜杠 + 反引号」——渲染器不做转义处理时，页面上就会出现它 */
  const BSLASH_TICK = '\\' + TICK
  /** 判据①：渲染结果里有**字面**的三个反引号 + jps，且没有「反斜杠 + 反引号」残留 */
  const literalFenceJps = (html: string) => html.includes(TICKS3 + 'jps') && !html.includes(BSLASH_TICK)
  /**
   * adj914（顺带收紧）：**不按页写死** —— 三份文档里凡源码含「反斜杠 + 反引号」的**行**全部纳入判据
   * （原来是 `find('代码块就渲染成简谱')` / `find('可以整段粘进编辑器')` 两行写死）。
   * 将来 `/manual/`（`docs/USER-GUIDE.md`）或新文档用了转义写法，**不用回来改断言**就自动被守住。
   */
  const DOC_MD = ['docs/USER-GUIDE.md', 'docs/SYNTAX.md', 'docs/PLUGIN-GUIDE.md']
  const escapedTickLines = DOC_MD.flatMap((f) => readSrc(f).split('\n').filter((l) => l.includes(BSLASH_TICK)))
  /** 其中**真的写了字面围栏**的那些（转义写法是"每个反引号前各有一个反斜杠"）：渲染后必须出现字面围栏 */
  const fenceLines = escapedTickLines.filter((l) => l.includes(BSLASH_TICK.repeat(3)))

  check('adj913 渲染器里有转义保护（`\\`` / `\\\\` 各一个占位符常量，先占位后还原）',
    mdSrc.includes('ESCAPED_TICK') && mdSrc.includes('ESCAPED_BSLASH') &&
      mdSrc.includes('hideInlineEscapes') && mdSrc.includes('showInlineEscapes'))
  check('adj913 inlineMd：`\\`` 还原成**字面反引号**（句子中间写三个 ⇒ 三个都还原）',
    inlineMd('写一个 \\`\\`\\`jps 代码块') === '写一个 ' + TICKS3 + 'jps 代码块',
    JSON.stringify(inlineMd('写一个 \\`\\`\\`jps 代码块')))
  check('adj913 inlineMd：`\\\\` 还原成**字面反斜杠**（顺带，别漏）',
    inlineMd('反斜杠：\\\\ 结束') === '反斜杠：\\ 结束',
    JSON.stringify(inlineMd('反斜杠：\\\\ 结束')))
  check('adj913 inlineMd：**真实文档**里凡含「反斜杠+反引号」的行（自动发现，不按页写死）渲染后都不残留',
    escapedTickLines.length >= 6 && escapedTickLines.every((l) => !inlineMd(l).includes(BSLASH_TICK)),
    `${escapedTickLines.length} 行；仍有残留的 ${escapedTickLines.filter((l) => inlineMd(l).includes(BSLASH_TICK)).length} 行`)
  check('adj913 inlineMd：其中写了**字面围栏**（三个反引号 + jps）的那几行，渲染后都真的出现字面围栏',
    fenceLines.length >= 6 && fenceLines.every((l) => literalFenceJps(inlineMd(l))),
    `${fenceLines.length} 行；样本 ${JSON.stringify(inlineMd(fenceLines[0] ?? '').slice(0, 60))}`)
  /**
   * 保守性（用户口径）：**只**处理 `\`` 与 `\\`，不许把反斜杠的转义扩散到所有字符 ——
   * 否则别人的 `\n`、`\d`、`C:\new` 这类**真实文本**会被吃掉。
   */
