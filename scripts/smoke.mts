  check('adj409 纯函数：不修改入参', JSON.stringify(src) === JSON.stringify(mk()), JSON.stringify(src))
  check('adj409 平移后的起点恒 ≥ 0', shiftEventsFrom(src, 1700).every((e) => e.atMs >= 0))
