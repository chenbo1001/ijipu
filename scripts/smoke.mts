/**
 * adj651（用户要求）：**连音线跨跳房子**。
 *
 * 用户口径：`(5/ |["1." 5/)` 这条"起点在跳房子 1 小节线之前、终点是房子 1 首音"的连音线，
 * 在后面的房子里用**孤立 `)`**（前面没有未闭合的 `(`）延续——三条线共用**同一个起音**
 * （用户原话：「跳房子 2、结束句和跳房子 1 的第一个 5 都是与跳房子 1 的小节线前面的 5 连音」）。
 * 渲染上延续线只画「房子起始小节线 → 首音」这半条右弧（上半条由房子 1 的显式连线表达）。
 */
function runAdj651Tests() {
  console.log('[152] 连音线跨跳房子（adj651）')
  const H651 = 'V: 1.0\nB: t\nD: C\nP: 4/4\n'
  /** 用户原谱：两行——房子 1 与跨线连音在上一行，房子 2 / 结束句在下一行 */
  const USER651 =
    H651 +
    "Q: 1'. 3'/ 3'/ 1'/ 1'/ (5/ |[++\"1.\" 5/) (6/ 6)-\n" +
    'Q: 0/ 2/ :|["2." 5) (6/ 6)- 3/ 5/ ||/&ds]["结束句" 5/) (6/ 6)\n'
  const lay651 = layoutScore(parseJps(USER651), defaultPageConfig)
  const p651 = lay651.pages[0]
  const rowYs = [...new Set(p651.notes.map((n) => n.y))].sort((a, b) => a - b)
  check('adj651 用例成立：两行谱（房子 1 在上一行、房子 2 / 结束句在下一行）',
    rowYs.length === 2, JSON.stringify(rowYs))
  const [rowA651, rowB651] = rowYs
  const barOn651 = (y: number, comment: string) =>
    p651.barlines.find((b) => Math.abs(b.yTop - (y - BAR_TOP)) < 1 && b.voltaStart?.comment === comment)
  const v1 = barOn651(rowA651, '1.')
  const v2 = barOn651(rowB651, '2.')
  const v3 = barOn651(rowB651, '结束句')
  check('adj651 用例成立：三根房子起始小节线都在（`|` 1. / `:|` 2. / `||/` 结束句）',
    v1 !== undefined && v2 !== undefined && v3 !== undefined,
    JSON.stringify([v1?.x, v2?.x, v3?.x]))
  const notesOn = (y: number) => p651.notes.filter((n) => Math.abs(n.y - y) < 0.01).sort((a, b) => a.x - b.x)
  const src5 = notesOn(rowA651).filter((n) => n.x < (v1?.x ?? 0)).pop() // 房子 1 小节线**前面**的 5
  const h1 = notesOn(rowA651).find((n) => n.x > (v1?.x ?? 0)) // 房子 1 首音
  const h2 = notesOn(rowB651).find((n) => n.x > (v2?.x ?? 0)) // 房子 2 首音
  const h3 = notesOn(rowB651).find((n) => n.x > (v3?.x ?? 0)) // 结束句首音
  check('adj651 用例成立：三个房子首音都是 `5`、跨线连音的起音也是 `5`',
    [src5, h1, h2, h3].every((n) => n?.token.kind === 'note' && String(n.token.pitch) === '5'),
    JSON.stringify([src5, h1, h2, h3].map((n) => (n && n.token.kind === 'note' ? n.token.pitch : null))))

  // ① 三条连音线（房子 1 的显式连线 + 房子 2 / 结束句的延续线）与两条 `(6/ 6)` 共 6 条
  check('adj651 连音线总数 = 6（`(5 |[1. 5)` + `(6 6)` ×3 各房子 + 房子 2 / 结束句两条延续线）',
    p651.slurs.length === 6, JSON.stringify(p651.slurs.map((s) => [s.x1, s.x2, s.half])))
  const halfL = p651.slurs.filter((s) => s.half === 'l')
  /**
   * adj689 口径变更：连音线基准 y 从"**本条覆盖的区间**的最大高八度点/修饰符层"
   * 改为"**整行**的最大值"（同一视觉行内所有连音线齐平，用户报「同一行连音线垂直错位」）。
   *
   * 本用例第 1 行里：房子 1 的 `(5/ … 5/)` 区间含高八度 `5'/` ⇒ 抬过 1 个高八度点；
   * `(6/ 6)` 不含 ⇒ 按行基准也一起被抬到同一高度。于是"这一行有连线"的判据不再依赖
   * 写死的 `rowA651 − 12.1`，改为"行内连线**同高**且位于该行音符之上"。
   */
  const row1Slurs = p651.slurs.filter((s) => s.y < rowA651)
  /**
   * adj723i（用户口径）：「**以元素墨迹不重叠、不覆盖为原则，让层级间保持适当间距即可**」
   * ⇒ 连音线只需避开**自己下方**的元素、**能低就低**。
   *
   * 故 `adj689` 的"同一行内所有连音线**必须同高**"已被取代：本用例第 1 行里
   * `(5/ … 5/)` 区间含高八度 `5'/` ⇒ 抬一个高音点层；`(6/ 6)` 区间不含 ⇒ **可以更低**
   * （正是用户要的"离音符近"）。断言改为"两条都在该行之上、且高度差不超过一个高音点层"。
   */
  check('adj723i（原 adj651）**不画左半部**：上一行不因延续线多出一截短线（房子 1 那条弧保持干净）',
    halfL.length === 0 &&
      row1Slurs.length === 2 &&
      row1Slurs.every((s) => s.y < rowA651) &&
      Math.abs(row1Slurs[0].y - row1Slurs[1].y) <= 3.7, // 至多差一个高八度点层
    JSON.stringify({ halfL: halfL.map((s) => [s.x1, s.x2]), row1: row1Slurs.map((s) => s.y), rowA: rowA651 }))
  const contOf = (bar: typeof v1, note: typeof h2) =>
    p651.slurs.find(
      (s) => s.half === 'r' && Math.abs(s.x1 - (bar?.x ?? 0)) < 0.6 &&
        Math.abs(s.x2 - ((note?.x ?? 0) + halfDig - NS_S)) < 0.6,
    )
  const cont2 = contOf(v2, h2)
  const cont3 = contOf(v3, h3)
  check('adj651 房子 2 首音：延续线从**该房子的起始小节线**（`:|`）接进来、落在首音上',
    cont2 !== undefined, JSON.stringify(p651.slurs.map((s) => [s.x1, s.x2, s.half])))
  check('adj651 结束句首音：延续线从**该房子的起始小节线**（`||/`）接进来、落在首音上',
    cont3 !== undefined, JSON.stringify(p651.slurs.map((s) => [s.x1, s.x2, s.half])))
  check('adj651 延续线是**平顶半弧**（跨行连线统一平顶，与既有跨行口径一致）',
    cont2?.style === 'flat' && cont3?.style === 'flat', JSON.stringify([cont2?.style, cont3?.style]))
  check('adj651 房子 2 / 结束句两条延续线**锚点不同**（各自的房子线），但同为右半弧',
    cont2 !== undefined && cont3 !== undefined && Math.abs(cont2.x1 - cont3.x1) > 100, '')

  // ② 起音归属：单行用例里延续线与显式连线 **x1 完全相等** ⇒ 同一条连音线的同一起音
  const SAME651 = H651 + 'Q: 1 2 (5 |["1." 5) 6 7 |]["2." 5) 1 2 ||\n'
  const laySame = layoutScore(parseJps(SAME651), defaultPageConfig)
  const pSame = laySame.pages[0]
  const expl = pSame.slurs[0]
  const cont = pSame.slurs[1]
  check('adj651 同起音：延续线的起点与显式连线**逐像素相同**（连回的是同一条连音线的起音，不是"最近闭合的那条"）',
    pSame.slurs.length === 2 && expl !== undefined && cont !== undefined && Math.abs(expl.x1 - cont.x1) < 0.01 &&
      cont.x2 > expl.x2 + 50,
    JSON.stringify(pSame.slurs.map((s) => [s.x1, s.x2, s.style])))

  // ③ 不误伤：没有跨跳房子连音线时，孤立 `)` 照旧什么都不画
  const noTie = layoutScore(parseJps(H651 + 'Q: 1 2 5 |["1." 5) 6 7 |]["2." 5) 1 2 ||\n'), defaultPageConfig)
  check('adj651 没有跨跳房子连音线时，孤立 `)` 不产生任何连线（老谱面零影响）',
    noTie.pages[0].slurs.length === 0, JSON.stringify(noTie.pages[0].slurs))

  // ④ 不误伤：普通跨行连音线仍是"左半 + 右半"两截（右半起点仍按行首小节线/左边距，未被房子锚点改掉）
  const plain = layoutScore(parseJps('V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 1 2 ( 3 4 | 5 6 1 2 |\nQ: 3 4 ) 5 6 | 7 1 2 3 |\n'), DUR_CFG)
  const pl = plain.pages[0].slurs.find((s) => s.half === 'l')
  const pr = plain.pages[0].slurs.find((s) => s.half === 'r')
  check('adj651 普通跨行连音线：左半照画、右半仍从左边距起（锚点改动只对"落在房子首音"的连线生效）',
    pl !== undefined && pr !== undefined && Math.abs(pr.x1 - ML) < 0.5,
    JSON.stringify({ l: pl?.x2, r: pr?.x1, ml: ML }))

  // ⑤ 文档示例（`docs/SYNTAX.md` §2.7）逐字可跑：三根房子三条线共用同一个起音
  const doc651 = layoutScore(
    parseJps(H651 + 'Q: 1 2 (5 |["1." 5) 6 |]["2." 5) 7 |]["结束句" 5) 1 ||\n'),
    defaultPageConfig,
  )
  const dSl = doc651.pages[0].slurs
  check('adj651 文档示例逐字可跑：三条线共用同一个起音（`(5 |["1." 5) … |]["2." 5) … |]["结束句" 5)`）',
    dSl.length === 3 && new Set(dSl.map((s) => s.x1)).size === 1,
    JSON.stringify(dSl.map((s) => [s.x1, s.x2])))

  /**
   * ⑥ adj651b（**用户真实原谱**，3 行）：房子 1 的跨线连音在**第 1 个视觉行**，
   * 房子 2 / 结束句的首音在**第 3 个视觉行**——中间还隔着整行音符。
   *
   * 旧实现把跨行连线限制在「相邻两行」（`rowB === rowA + 1`，隔多行按"误输入"不渲染）
   * ⇒ 用户这条谱子上**两条延续线一条都没画**（用户："我并不能看到这两条一半的连音线"）。
   * 延续线的语义本来就是"从前面接过来"，不需要两行紧邻 ⇒ 允许跨任意行，只在终点行画右半弧。
   */
  const REAL651 =
    H651 +
    "Q: 1'. 3'/ 3'/ 1'/ 1'/ (5/ |[++\"1.\" 5/) (6/ 6)- &zkh 6,/ 7,/ | 1- 0 0/ 6,/ |]/ 7,- 5,- | 6,-- 0/ 1/ |\n" +
    'Q: 3-- 0/ 7/ | 6 5/ 1\'/ 7 1\'/ 2\'/ | 1\' 7 6 0/ 7// 1\'// | 1\' 7/ 6/ 7 5 |\n' +
    'Q: 6-- &ykh 0/ 2/ :|[+++"2." 5/) (6/ 6)- 3/ 5/ ||/&ds][+++"结束句" 5/) (6/ 6)- &hx 6/ 7/ | ' +
    "1'. 3'/ 3'/ 1'/ 1'/ 5/ | 6--- ||]\n"
  const pReal = layoutScore(parseJps(REAL651), defaultPageConfig).pages[0]
  const rowsReal = [...new Set(pReal.notes.map((n) => n.y))].sort((a, b) => a - b)
  const rowYOfBar = (bar: { yTop: number } | undefined) =>
    bar === undefined ? undefined : rowsReal.find((y) => Math.abs(bar.yTop - (y - BAR_TOP)) < 1)
  const bar651 = (comment: string) => pReal.barlines.find((b) => b.voltaStart?.comment === comment)
  const v1r = bar651('1.')
  const v2r = bar651('2.')
  const v3r = bar651('结束句')
  const rowOfBar = (bar: typeof v1r) => {
    const y = rowYOfBar(bar)
    return y === undefined ? -1 : rowsReal.indexOf(y)
  }
  const firstNoteAfter = (bar: typeof v1r) => {
    const y = rowYOfBar(bar)
    if (y === undefined || bar === undefined) return undefined
    return pReal.notes.filter((n) => Math.abs(n.y - y) < 0.01 && n.x > bar.x).sort((a, b) => a.x - b.x)[0]
  }
  const srcReal =
    v1r && rowYOfBar(v1r) !== undefined
      ? pReal.notes.filter((n) => Math.abs(n.y - rowYOfBar(v1r)!) < 0.01 && n.x < v1r.x).sort((a, b) => b.x - a.x)[0]
      : undefined
  check('adj651b 用例成立：原谱 3 个视觉行，跨线连音的起音在第 1 行、两个房子首音在第 3 行（**中间隔整行**）',
    rowsReal.length === 3 && rowOfBar(v1r) === 0 && rowOfBar(v2r) === 2 && rowOfBar(v3r) === 2 &&
      srcReal !== undefined && srcReal.token.kind === 'note' && String(srcReal.token.pitch) === '5',
    JSON.stringify({ rows: rowsReal.length, v1: rowOfBar(v1r), v2: rowOfBar(v2r), v3: rowOfBar(v3r) }))
  const halvesReal = pReal.slurs.filter((s) => s.half === 'r')
  const contReal = (bar: typeof v1r, note: typeof srcReal) =>
    pReal.slurs.find(
      (s) => s.half === 'r' && Math.abs(s.x1 - (bar?.x ?? 0)) < 0.6 &&
        Math.abs(s.x2 - ((note?.x ?? 0) + halfDig - NS_S)) < 0.6,
    )
  const h2r = firstNoteAfter(v2r)
  const h3r = firstNoteAfter(v3r)
  check('adj651b **隔多行也照画**：房子 2 首音从 `:|` 接进来、结束句首音从 `||/` 接进来（各半条平顶弧）',
    halvesReal.length === 2 && contReal(v2r, h2r) !== undefined && contReal(v3r, h3r) !== undefined,
    JSON.stringify(pReal.slurs.map((s) => [s.x1, s.x2, s.half])))
  check('adj651b 两条延续线都落在**终点那一行**（y = 第 3 行的连音线基准，不在起点行）',
    halvesReal.length === 2 && halvesReal.every((s) => s.y > rowsReal[1]),
    JSON.stringify(halvesReal.map((s) => s.y)))
  check('adj723i（原 adj651b）起点行**不多画**任何半条弧（左半部仍不画，第 1 行保持干净）',
    pReal.slurs.filter((s) => s.half === 'l').length === 0 &&
      /**
       * adj723i：起点行的连线**各按自己区间**取高度（不再强制同高，见上一条说明）
       * ⇒ 判据改为"两条都在该行之上、且高度差不超过一个高八度点层"。
       */
      (() => {
        const row1 = pReal.slurs.filter((s) => s.y < rowsReal[1] - 40)
        return (
          row1.length === 2 &&
          row1.every((s) => s.y < rowsReal[0]) &&
          Math.abs(row1[0].y - row1[1].y) <= 3.7
        )
      })(),
    JSON.stringify(pReal.slurs.map((s) => [s.y, s.half])))

  /**
   * ⑦ adj651c（用户报「`(5/|5/)` 只演奏一次音符 5、时值相加 1 拍，而不是两个半拍；
   * 跳房子 1 因为谱子连在一起所以是对的，但**跳房子 2 和结束句**因为跨了小节或行，却是按两个半拍演奏」）：
   *
   * 排版端把**延续类连音线**（孤立 `)` 那条）随 `ScoreLayout.continuationTies` 交给播放端；
   * 播放端据此把"演奏顺序相邻、源码顺序隔很远"的两端并成**一个长音**（只起奏一次）。
   *
   * adj723aa（2026-10，**用户调整后的最终谱**）：用户把行首补上 `|/&hs`、并去掉了非必要的一行，
   * 「现在测试三个跳房子都正常了」。**本条用这份谱**——它让三个房子的延续线**都**落在
   * 「起音之后紧邻该房子首音」的走查顺序上（起音事件三遍各一次、各 1 拍）。
   * 上面那份三行原谱仍保留给 `adj651b`/`adj723i` 的**跨行视觉**断言（那两条测的是"隔整行也照画"）。
   */
  const REAL651C =
    H651 +
    "Q: |/&hs 1'. 3'/ 3'/ 1'/ 1'/ (5/ |[++\"1.\" 5/) (6/ 6)- &zkh 6,/ 7,/ | 1- 0 0/ 6,/ |]/ 7,- 5,- | 6,-- 0/ 1/ |\n" +
    'Q: 6-- &ykh 0/ 2/ :|[+++"2." 5/) (6/ 6)- 3/ 5/ ||/]&ds[+++"结束句" 5/) (6/ 6)- &hx 6/ 7/ | 1\'. 3\'/ 3\'/ 1\'/ 1\'/ 5/ | 6--- ||]\n'
  const rReal651 = parseJps(REAL651C)
  const lReal651 = layoutScore(rReal651, defaultPageConfig)
  const seqReal651 = buildPlaySequence(rReal651, lReal651, 60)
  const contTies651 = lReal651.continuationTies ?? []
  check('adj651c 排版端带出延续类连音线清单（两条：同一起音 → 房子 2 / 结束句首音）',
    contTies651.length === 2 && contTies651[0].start === contTies651[1].start &&
      contTies651[0].end !== contTies651[1].end,
    JSON.stringify(contTies651))
  const srcEv651 = seqReal651.events.filter(
    (e) => e.pitched !== false && e.placed.id.index === contTies651[0]?.start,
  )
  check('adj651c 演奏：**三遍**都把「起音 + 房子首音」并成一个 **1 拍长音**（只起奏一次；此前房子 2/结束句各半拍）',
    srcEv651.length === 3 && srcEv651.every((e) => Math.round(e.durationMs) === 1000) &&
      srcEv651.every((e) => (e.playheadSegs ?? []).reduce((a, s) => a + s.beats, 0) === 1),
    JSON.stringify(srcEv651.map((e) => [e.atMs, Math.round(e.durationMs), (e.playheadSegs ?? []).length])))
  check('adj651c 演奏：被并进来的两个房子首音**不再单独发声**（事件列表里没有它们）',
    contTies651.length === 2 &&
      seqReal651.events.every(
        (e) => e.placed.id.index !== contTies651[0].end && e.placed.id.index !== contTies651[1].end,
      ),
    JSON.stringify(seqReal651.events.filter((e) => e.placed.id.index === contTies651[1]?.end).map((e) => e.atMs)))
  check('adj651c 起音仍按**普通口径**与房子 1 合并（每遍都是 2 个拍段 = 起音 + 房子 1 首音，时值不叠加变长）',
    srcEv651.length === 3 && srcEv651.every((e) => (e.playheadSegs ?? []).length === 2),
    JSON.stringify(srcEv651.map((e) => (e.playheadSegs ?? []).map((s) => s.beats))))
  // 护栏：延续线**不进** `slurOf`（那套按源码区间铺满）——否则区间内相邻同音会被误判成连线而合并。
  const guardCode = H651 + 'Q: 1 (5 |["1." 5) 6 6 |]["2." 5) 7 ||\n'
  const guardSeq = buildPlaySequence(parseJps(guardCode), layoutScore(parseJps(guardCode), defaultPageConfig), 60)
  const a4 = guardSeq.events.filter((e) => e.pitched !== false && (e.pitch ?? e.placed.audioPitch) === 'A4')
  check('adj651c 护栏：延续线区间内的**相邻同音**（非连线）照旧不合并（两个 `6` 各自发声）',
    a4.length === 2, JSON.stringify(a4.map((e) => [e.atMs, Math.round(e.durationMs)])))
}

/**
 * adj689b（用户报「连音线错位问题」仍未完全解决）：**同一视觉行内所有连音线必须齐平**。
 *
 * 两个根因（都在本用例里被钉住）：
 *  ① 基准 y 曾按"本条覆盖的区间"取 `max(高八度点数)`——同一行里含高八度点的区间与不含的
 *     会一高一低（`(1'// 7// 6//)` vs `(6// 6/)`）；
 *  ② 同一行可能有**多段 `{dsb}`**、各段下移量由"该段内容多密"决定而**互不相同**
 *     （实测 15.77 / 16.74 / 15.77），连音线按各自段落下移 ⇒ 行内又岔开。
 * 现在：基准按**整行**取，且**一行只认一个下移量**（`alignRowSlurBaselines`）。
 */
function runAdj689bTests() {
  console.log('[154] 同一行连音线齐平（adj689b）')
  const H = 'V: 1.0\nB: t\nD: C\nP: 4/4\n'
  /**
   * 用户原谱的第 3 行：一行里**三段 `{dsb}`，密度各不相同**（第 3 段最疏），
   * 外加两处包络**之外**的连线 ⇒ 三个下移量并存。
   */
  const CODE =
    H +
    "Q: |/[-" +
    '"3." {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (1\'// 7// 6//) (6// 6/) 5/ 6- |"p:2/4" 0 0/ 3\'/ ' +
    '|]/"p:4/4" 6 0/ 3/ 7, {dsb 0/ 1// 2// } 0/ 6// 7// |"p:2/4" {dsb (3// 2// 1//) 1// } (1\'// 7// 6//) 6// 0/ 5/ |"p:4/4" 6--- ||\n' +
    'C: 绿@@肥@@红瘦@@"男."知否\n'
  const lay = layoutScore(parseJps(CODE), defaultPageConfig)
  const p = lay.pages[0]
  /**
   * 行顶 = 未被 `{dsb}` 下移的主旋律音符的 y（带 `parentY` 的是下层声部）。
   * 这里用**段层音符的 `parentY`** 收行顶集合（段层是叠加层，它的 `parentY` 就是行顶）。
   */
  const rowTops = [...new Set(p.notes.map((n) => n.parentY).filter((v): v is number => v !== undefined))]
  check('adj689b 用例成立：本行存在多个互不相同的段层下移量',
    (p.rowSlides?.size ?? 0) >= 1 && rowTops.length >= 1,
    JSON.stringify({ rowSlides: [...(p.rowSlides ?? new Map()).entries()], rowTops }))
  /**
   * adj723o/adj723q：按**区间**认"主旋律线"（不再用 `layerBase` 区分来源——
   * 段内连音线现在只由段层路径建，主路径不再重复建线）。
   */
  const segSpans = []
  for (const n of p.notes) {
    if (n.segment === undefined) continue
    segSpans.push([n.x, n.x + n.width])
  }
  const inSeg = (s: (typeof p.slurs)[number], pad = 3): boolean =>
    segSpans.some(([a, b]) => Math.min(s.x1, s.x2) >= a - pad && Math.max(s.x1, s.x2) <= b + pad)
  const mainSlurs = p.slurs.filter((s) => !inSeg(s))
  const bases = [...new Set(mainSlurs.map((s) => s.baseYNoRaise ?? s.y))]
  check('adj723o（原 adj689b）每条连线**只按自己区间**定高：`baseYNoRaise` 不因同行其它线被抹平',
    mainSlurs.length >= 2 && bases.length >= 2,
    `基础高度=[${bases.join(',')}]`)
  /**
   * ⚠ adj723o **未覆盖**：`{dsb}` 行里那几条线的 `y`（183.8/187.4/182.9）**低于段层墨迹顶**
   * （155.7/156.6）。逐条打印证实：这些线的 `baseYNoRaise` 是**段层坐标系**的值（167.1），
   * 却被 `shiftEnvelopeDown()`（只按 x + 行号筛）当成"下层内容"又下移了 16.7px。
   *
   * 这是**既有缺陷**（`adj689b` 的"同行齐平"此前把线拉回 182.9 而掩盖了它），
   * 与本轮"各按自己区间定高"无关 ⇒ 本轮**不为它改口径**，留待专项修复
   * （候选：主旋律路径不该为**段内 token** 再建线，段层路径已有 `layerBase` 的那套）。
   * 详见 `docs/ERRORS-LOG.md`。
   */
  /**
   * 且齐平之后仍在"该行最高的元素顶"之上：取该行最低声部处的连线为基准——
   * 行内连线 y 必须**高于**该行最低声部的数字顶（否则线会横穿音符）。
   */
  const rowTop0 = rowTops[0]
  /** adj723q：该行的**全部**线（含段内线——它们现在也是唯一的那份） */
  const slurs0 = p.slurs.filter((s) => {
    const xa = Math.min(s.x1, s.x2)
    const xb = Math.max(s.x1, s.x2)
    return p.notes.some(
      (n) => n.parentY !== undefined && Math.abs(n.parentY - rowTop0) < 0.5 && n.x + n.width >= xa - 5 && n.x <= xb + 5,
    )
  })
  let lowVoice = rowTop0
  for (const n of p.notes) {
    if (n.parentY !== undefined && Math.abs(n.parentY - rowTop0) < 0.5) lowVoice = Math.max(lowVoice, n.y)
  }
  check('adj689b 齐平后的连线仍**高于**该行所有音符（不与数字/减时线交叉）',
    slurs0.length > 0 && slurs0.every((s) => s.y < lowVoice - defaultPageConfig.note_size * 0.8),
    JSON.stringify({ y: slurs0.map((s) => s.y), lowVoice }))
  /**
   * 两条布局路径都要覆盖（AGENTS 铁律 5）：时值优先（`duration`）下**同样各按自己区间定高**。
   */
  const durLay = layoutScore(parseJps(CODE), { ...defaultPageConfig, noteSpaceLayout: 'duration' })
  const durPage = durLay.pages[0]
  const durSegSpans: [number, number][] = []
  for (const n of durPage.notes) {
    if (n.segment === undefined) continue
    durSegSpans.push([n.x, n.x + n.width])
  }
  const durMain = durPage.slurs.filter(
    (s) =>
      !durSegSpans.some(([a, b]) => Math.min(s.x1, s.x2) >= a - 3 && Math.max(s.x1, s.x2) <= b + 3),
  )
  const durBases = [...new Set(durMain.map((s) => s.baseYNoRaise ?? s.y))]
  check('adj723o（原 adj689b）时值优先（`noteSpaceLayout: duration`）路径同样**各按自己区间**定高',
    durMain.length >= 2 && durBases.length >= 2, `基础高度=[${durBases.join(',')}]`)
  /**
   * 护栏：**没有 `{dsb}` 的谱面零位移**（老谱面连音线位置一字不动）。
   */
  const plain = 'V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 1 2 (3 4) 5 6 | 1 2 3 4 |\n'
  const plainLay = layoutScore(parseJps(plain), defaultPageConfig)
  check('adj689b 护栏：不含 `{dsb}` 的谱面不产生任何行下移（连音线零位移）',
    (plainLay.pages[0].rowSlides?.size ?? 0) === 0, JSON.stringify([...(plainLay.pages[0].rowSlides ?? new Map())]))
  /**
   * adj714（用户主规则，见 `AGENTS.md` 五·10）：**修饰符层级栈的机器闸门**。
   *
   * 层级（由音符往上）：`① 高八度点 → ② 本音符修饰符（波音/顿音/颤音/注释）→
   * ③ 跨音符修饰符（连音线、渐强渐弱）→ ④ 跨小节修饰符（跳房子）`；
   * 由音符往下：`① 减时线 → ② 低八度点 → ③ 其它`。
   * 判据：**上一层墨迹底 ≥ 下一层墨迹顶 + `LAYER_GAP`**（按墨迹，弧线用**弧顶**）。
   *
   * 这两条断言把"层级顺序 + 净空"钉住——它是**跨元素**的正确性，
   * 靠人眼看图极易漏（本轮连音线垂度就是这么漏掉的：只按弦留 `LAYER_GAP`，
   * 弧顶却随跨度上拱，实际净空从 4.2px 涨到 12.7px）。
   */
  {
    const src714 = "V: 1.0\nB: t\nD: C\nP: 4/4\nQ: (1' 2 3) 4 - | 6,// 5,// 4,// 3,// 2, - |\n"
    const lay714 = layoutScore(parseJps(src714), defaultPageConfig)
    const pg714 = lay714.pages[0]
    const ns714 = defaultPageConfig.note_size
    const s714 = noteScaleOf(ns714)
    const gap714 = LAYER_GAP * s714
    const octN = pg714.notes.find((n) => (n.token as { octaveShift?: number }).octaveShift === 1 && !n.segment)
    check('adj714 ① 高八度点层在数字顶之上（点底 ≤ 数字顶 − LAYER_GAP）',
      octN !== undefined &&
        octaveDotY(octN.y, 0, ns714) + DOT_R * s714 <= digitTopY(octN.y, ns714) - gap714 + 0.01,
      octN ? `点底=${(octaveDotY(octN.y, 0, ns714) + DOT_R * s714).toFixed(2)} 数字顶=${digitTopY(octN.y, ns714).toFixed(2)}` : '缺高八度音符')
    /**
     * ③ 跨音符修饰符（连音线）必须在 ① 高八度点层之上：
     * 用**弧顶**（`slurApexY` = 弦 − 常量弧顶高，adj929）比，不能再拿弦 `y` 比（那正是本轮的 bug）。
     */
    {
      const sl714 = pg714.slurs[0]
      const span714 = Math.abs(sl714.x2 - sl714.x1)
      const apex714 = slurApexY(sl714.y)
      const covered714 = pg714.notes.filter((n) => n.x >= sl714.x1 - 2 && n.x <= sl714.x2 + 2 && !n.segment)
      const top714 = Math.min(...covered714.map((n) => {
        const oct = (n.token as { octaveShift?: number }).octaveShift ?? 0
        return oct > 0 ? octaveTopY(n.y, oct, ns714) : digitTopY(n.y, ns714)
      }))
      check('adj714 ③ 连音线弧顶在 ① 高八度点层之上（弧顶 ≤ 层顶 − LAYER_GAP）',
        Number.isFinite(top714) && apex714 <= top714 - gap714 + 0.01,
        `弧顶=${apex714.toFixed(2)} 层顶=${top714.toFixed(2)} 跨度=${span714.toFixed(1)}`)
    }
    /** 往下：① 减时线 → ② 低八度点（先减时线、后低八度点，顺序硬性） */
    {
      const dcN = pg714.notes.find((n) => ((n.token as { diminishCount?: number }).diminishCount ?? 0) >= 1 && !n.segment)
      check('adj714 ① 减时线在数字底之下（线顶 ≥ 数字底 + LAYER_GAP）',
        dcN !== undefined && beamY(dcN.y, 1, ns714) >= digitBottomY(dcN.y, ns714) + gap714 - 0.01,
        dcN ? `线顶=${beamY(dcN.y, 1, ns714).toFixed(2)} 数字底=${digitBottomY(dcN.y, ns714).toFixed(2)}` : '缺减时线音符')
    }
    check('adj714 层级顺序表与「往下」顺序固定（`AGENTS.md` 五·10 的唯一表述）',
      MODIFIER_LAYERS_ABOVE.join('>') === 'octave>noteMark>spanMark>section' &&
        MODIFIER_LAYERS_BELOW.join('>') === 'beam>lowDot>belowMark',
      `${MODIFIER_LAYERS_ABOVE.join('>')} / ${MODIFIER_LAYERS_BELOW.join('>')}`)
  }
  /**
   * ============================================================
   * adj929（用户口径）：**连音线弧顶 = 常量**（短弧不塌、长弧曲度小）
   * ============================================================
   *
   * 覆盖要求（`AGENTS` 六之二·5）：
   *  · **两条布局路径**（`noteSpaceLayout: 'space'` / `'duration'`）；
   *  · **多声部**（含 `{dsb}` 段层——它的连音线走**另一套构造代码**）。
   *
   * 判据全部按**墨迹**（`AGENTS` 五·9）：连音线的墨迹顶 = **弧顶** `slurApexY(y)`。
   * 每条都带**负对照**（把旧的"随跨度"口径喂进同一个判据 ⇒ 必须判假）。
   */
  {
    const NS929 = defaultPageConfig.note_size
    const S929 = noteScaleOf(NS929)
    const GAP929 = LAYER_GAP * S929
    /** 判据：一组数的极差——"是否与跨度无关"的正负对照**共用同一个函数** */
    const spreadOf = (a: number[]): number => (a.length === 0 ? Number.NaN : Math.max(...a) - Math.min(...a))
    /** 旧口径弧顶高度（`clamp(跨度 × 0.28, 2.5, 9) ÷ 2`）——只作负对照 */
    const legacyApexH = (span: number): number => Math.max(2.5, Math.min(9, span * 0.28)) / 2
    /** 点的**墨迹顶**（高八度点层顶 / 数字顶取最上者） */
    const inkTopOf = (n: { y: number; token: unknown }): number => {
      const oct = (n.token as { octaveShift?: number }).octaveShift ?? 0
      return oct > 0 ? octaveTopY(n.y, oct, NS929) : digitTopY(n.y, NS929)
    }
    /**
     * 该线"自己区间内"音符的**墨迹顶**：
     *  · x 判据与布局 `spanSlurY` 同源（槽中心落在 `[x1−4.5, x2+4.5]`）；
     *  · **只要弦 y 下方的音符**（`n.y > sl.y + 1`）——多声部 `{dsb}` 里上层的段层音符
     *    在同一 x 区间里、但不在本线下方，混进来会把"下方墨迹顶"算成别人的层（实测会得负间距）。
     */
    const coveredInkTop = (pg: ScorePage, sl: { x1: number; x2: number; y: number }): number => {
      const lo = Math.min(sl.x1, sl.x2) - 4.5
      const hi = Math.max(sl.x1, sl.x2) + 4.5
      const tops = pg.notes
        .filter((n) => n.x + n.width / 2 >= lo && n.x + n.width / 2 <= hi && n.y > sl.y + 1)
        .map(inkTopOf)
      return tops.length > 0 ? Math.min(...tops) : Number.NaN
    }
    /**
     * **从渲染端真实产物**里读出该线的弧顶 y（不信任任何布局侧公式）：
     * `M x1 y Q midX ctrlY x2 y` 的顶点 `B(0.5) = (y + ctrlY) / 2`。
     */
    const renderedApexYOf = (sl: ScorePage['slurs'][number]): number => {
      const d = renderSlurForTest(sl, NS929)
      const m = /Q [\d.]+ ([\d.]+)/.exec(d)
      return m === null ? Number.NaN : (sl.y + Number(m[1])) / 2
    }
    const CODE929 =
      "V: 1.0\nB: t\nD: C\nP: 4/4\n" +
      "Q: 1/ (2/ 3/) 4/ 5 - |\n" +
      "Q: 6// 7// (1'// 7// 6//) 5/ 6- |\n" +
      "Q: {dsb (3// 2// 1//) (1// 1/) 7,/ 1- } (2// 4// (3/. 3)) 5/ 6- |\n"
    const CFGS929: [string, typeof defaultPageConfig][] = [
      ['时值优先（duration）', { ...defaultPageConfig, noteSpaceLayout: 'duration' as const }],
      ['空间优先（space）', { ...defaultPageConfig, noteSpaceLayout: 'space' as const }],
    ]
    /** 弧顶到下方音符墨迹顶的间距；`apexYOf` 供负对照换成旧口径 */
    const gapsOf = (
      pg: ScorePage,
      arcs: ScorePage['slurs'],
      apexYOf: (sl: ScorePage['slurs'][number]) => number,
    ): number[] =>
      arcs.map((s) => {
        const top = coveredInkTop(pg, s)
        return Number.isFinite(top) ? top - apexYOf(s) : Number.NaN
      })
    for (const [pathName, cfg] of CFGS929) {
      const pg = layoutScore(parseJps(CODE929), cfg).pages[0]
      /** 只看**圆弧**（平顶线没有弧顶）且**没有跨行半条**（半条弧顶点另有硬编码，不属本口径） */
      const arcs = pg.slurs.filter((s) => s.style === 'arc' && s.half === undefined && s.below !== true)
      const spans = arcs.map((s) => Math.abs(s.x2 - s.x1))
      /** 判据①（**端到端**）：从**渲染产物**读出的弧顶高度必须逐条 = `SLUR_APEX_H`、极差 ≤ 1px */
      const realApexH = arcs.map((s) => s.y - renderedApexYOf(s))
      check(
        `adj929 ${pathName}：**不同跨度的连音线弧顶高度相同**（±1px；逐条 = \`SLUR_APEX_H\`=${SLUR_APEX_H}）`,
        arcs.length >= 3 && spreadOf(spans) >= 5 && realApexH.every((h) => Math.abs(h - SLUR_APEX_H) < 1e-6) && spreadOf(realApexH) <= 1,
        `弧度数=${arcs.length} 跨度=[${spans.map((v) => v.toFixed(1)).join(',')}] 实弧顶高=[${realApexH.map((v) => v.toFixed(2)).join(',')}] 极差=${spreadOf(realApexH).toFixed(2)}`,
      )
      /** 负对照：把**旧口径**（随跨度）的弧顶高度喂进**同一个判据** ⇒ 必须判假 */
      const legacyApexHOf = arcs.map((s) => legacyApexH(Math.abs(s.x2 - s.x1)))
      check(
        `adj929 ${pathName} 负对照：旧的"弧顶随跨度"口径在同一判据下**判假**`,
        spreadOf(legacyApexHOf) > 1 && legacyApexHOf.some((h) => Math.abs(h - SLUR_APEX_H) > 1e-6),
        `旧弧顶高=[${legacyApexHOf.map((v) => v.toFixed(2)).join(',')}] 极差=${spreadOf(legacyApexHOf).toFixed(2)}`,
      )
      /** 判据②：**弧顶**（渲染产物）到下方音符墨迹顶的间距 ≥ `LAYER_GAP`，且与跨度无关（≤ 1px） */
      const gaps = gapsOf(pg, arcs, renderedApexYOf)
      check(
        `adj929 ${pathName}：连音线**弧顶**到下方音符墨迹顶 ≥ \`LAYER_GAP\`(${GAP929.toFixed(2)}px)，且各跨度同值（±1px）`,
        gaps.length > 0 && gaps.every((g) => Number.isFinite(g) && g >= GAP929 - 0.01) && spreadOf(gaps) <= 1,
        `弧顶→音符=[${gaps.map((g) => g.toFixed(2)).join(',')}] 极差=${spreadOf(gaps).toFixed(2)} 下限=${GAP929.toFixed(2)}`,
      )
      /** 负对照 A：旧口径（弧顶随跨度）⇒ 同一批间距极差 > 1px、最短那条明显更小 ⇒ 判假 */
      const legacyGaps = gapsOf(pg, arcs, (s) => s.y - legacyApexH(Math.abs(s.x2 - s.x1)))
      check(
        `adj929 ${pathName} 负对照：旧口径的弧顶间距在同一判据下**判假**（极差 > 1px）`,
        spreadOf(legacyGaps) > 1,
        `旧弧顶→音符=[${legacyGaps.map((g) => g.toFixed(2)).join(',')}] 极差=${spreadOf(legacyGaps).toFixed(2)}`,
      )
      /**
       * 负对照 B：若弧顶只拱到**弦下方 1px**（等于不拱、弧线朝下）⇒ 弧顶离数字只剩约 0.7px
       * `< LAYER_GAP` ⇒ 同一判据**判假**（证明这条判据真的在量"弧顶"而不是空跑）。
       */
      const sunkGaps = gapsOf(pg, arcs, (s) => s.y + 1)
      check(
        `adj929 ${pathName} 负对照：弧顶若低于弦（不拱）⇒ 同一判据**判假**（弧顶离数字 < \`LAYER_GAP\`）`,
        sunkGaps.some((g) => Number.isFinite(g) && g < GAP929 - 0.01) && gaps.some((g) => g >= GAP929 - 0.01),
        `不拱时=[${sunkGaps.map((g) => g.toFixed(2)).join(',')}] 实际=[${gaps.map((g) => g.toFixed(2)).join(',')}] 下限=${GAP929.toFixed(2)}`,
      )
      /**
       * 判据③：**极短弧不再塌**——最短那条（两个八分音符）的弧顶也必须比其音符墨迹顶
       * 高出 ≥ `SLUR_APEX_H`；旧口径下它明显更矮（负对照）。
       */
      const iShort = spans.indexOf(Math.min(...spans))
      check(
        `adj929 ${pathName}：**极短弧不塌**（最短跨度 ${spans[iShort].toFixed(1)}px 的弧顶→音符 = ${gaps[iShort].toFixed(2)}px ≥ ${SLUR_APEX_H}；旧口径只有 ${legacyGaps[iShort].toFixed(2)}px）`,
        gaps[iShort] >= SLUR_APEX_H - 0.01 && legacyGaps[iShort] < gaps[iShort] - 0.5,
        `新=${gaps[iShort].toFixed(2)} 旧=${legacyGaps[iShort].toFixed(2)} 跨度=${spans[iShort].toFixed(1)}`,
      )
    }
    /**
     * 多声部 / `{dsb}` 段层（**另一套构造代码**）：段层自己的连音线也必须是常量弧顶，
     * 且按**整层纵向压缩比**折算出**视觉**弧顶（`{dsb}` 段层 `layerScale = 1`；
     * `{bz}`/`{tp}` 整层压扁到 `SEGMENT_LAYER_YSCALE`）——两套代码不许各算一套。
     */
    {
      const pg = layoutScore(parseJps(CODE929), CFGS929[0][1]).pages[0]
      const segSlurs = pg.slurs.filter((s) => s.layerBase !== undefined && s.style === 'arc' && s.below !== true)
      const segSpans = segSlurs.map((s) => Math.abs(s.x2 - s.x1))
      const segRealH = segSlurs.map((s) => s.y - renderedApexYOf(s))
      const segVisualH = segSlurs.map((s, i) => segRealH[i] * (s.layerScale ?? 1))
      check(
        'adj929 多声部（`{dsb}` 段层路径）：段层连音线的实弧顶也是同一常量、与跨度无关（±1px）',
        segSlurs.length >= 2 && spreadOf(segSpans) >= 1 && segRealH.every((h) => Math.abs(h - SLUR_APEX_H) < 1e-6) && spreadOf(segVisualH) <= 1,
        `段层弧度数=${segSlurs.length} 跨度=[${segSpans.map((v) => v.toFixed(1)).join(',')}] 实弧顶=[${segRealH.map((v) => v.toFixed(2)).join(',')}] 视觉弧顶=[${segVisualH.map((v) => v.toFixed(2)).join(',')}]`,
      )
      /** 负对照：旧"随跨度"口径在同一判据下**判假** */
      const segLegacyH = segSpans.map(legacyApexH)
      check(
        'adj929 多声部（`{dsb}` 段层路径）负对照：旧的"随跨度"口径在该判据下**判假**',
        spreadOf(segLegacyH) > 0.5,
        `旧弧顶高=[${segLegacyH.map((v) => v.toFixed(2)).join(',')}] 极差=${spreadOf(segLegacyH).toFixed(2)}`,
      )
      /** 两套构造代码**同源**：主旋律与段层的弧顶都用渲染端同一个函数算出来（都是常量） */
      const mainSlurs = pg.slurs.filter((s) => s.layerBase === undefined && s.style === 'arc' && s.below !== true)
      check(
        'adj929 两套路径同源：主旋律与 `{dsb}` 段层的弧顶都 = `弦 − SLUR_APEX_H`（不各算一套）',
        mainSlurs.length > 0 &&
          segSlurs.length > 0 &&
          [...mainSlurs, ...segSlurs].every((s) => Math.abs(s.y - renderedApexYOf(s) - SLUR_APEX_H) < 1e-6),
        `主旋律=${mainSlurs.length} 段层=${segSlurs.length}`,
      )
    }
    /** 渲染产物端到端：SVG 里的控制点必须与常量一致（不许渲染端自己现算） */
    {
      const svg = renderScoreToSvg(layoutScore(parseJps(CODE929), CFGS929[0][1]))[0]
      const ctrl = [...svg.matchAll(/<path d="M ([\d.]+) ([\d.]+) Q [\d.]+ ([\d.]+) [\d.]+ \2" fill="none"/g)].map((m) => ({
        y: Number(m[2]),
        ctrl: Number(m[3]),
      }))
      check(
        'adj929 渲染端：SVG 里每条弧的控制点偏移都 = `SLUR_SAG`（= 2×弧顶高），弧顶 = 常量',
        ctrl.length >= 3 && ctrl.every((c) => Math.abs(c.y - c.ctrl - SLUR_SAG) < 0.06) && ctrl.every((c) => Math.abs((c.y - c.ctrl) / 2 - SLUR_APEX_H) < 0.03),
        `控制点偏移=[${ctrl.map((c) => (c.y - c.ctrl).toFixed(2)).join(',')}]`,
      )
    }
  }
  /**
   * adj692（用户口径）：「临时多声部块**两端各留 2 倍大括号宽度的墨迹留白**
   * （即与两端的小节线 / 临时节拍符 / 音符等元素的墨迹间距），大括号**在留白中居中**」。
   *
   * 判据（对每个 `{dsb}` 段，用**该段自己的**下层声部墨迹边界为内容边界——
   * 上下两层同一拍位逐音符对齐，故与上层等价）：
   *  · 括号与**段内容**的净距 ≥ `w/2 − 0.5`（允许浮点/槽宽的极小溢出，绝不真压字）；
   *  · 括号与**左邻居**（小节线/拍号/音符墨迹）的净距 ≥ `w/2 − 0.5`。
   * 右端空间被"下行邻居"完全占满时（可用宽 < 0）允许贴住内容，故只判左侧外侧。
   */
  {
    const ns2 = defaultPageConfig.note_size
    const segBrackets = (p.segmentBrackets ?? []).filter((b) => b.type === 'dsb' && b.inkW !== undefined)
    /** 按 `blockLeft` 排序 ⇒ 相邻两段的 `blockLeft` 之间就是本段内容（精确切分，不靠固定窗口） */
    const sortedB = [...segBrackets].sort((a, c) => (a.blockLeft ?? a.x1) - (c.blockLeft ?? c.x1))
    const bad: string[] = []
    for (const [bi, b] of sortedB.entries()) {
      const w = b.inkW as number
      /**
       * 该段的下层声部（包络内的主旋律）。
       *
       * ⚠️ adj709：**不能靠固定 x 窗口猜"哪一段"**——两段括号挨得近时窗口会罩住邻段
       * （实测 `contentR` 取到 318.7 的邻段音符、"右内侧"算出 −145 的假红灯）。
       * 括号记录自己带 `blockLeft`（= 段内容左界）⇒ 本段内容 = `[blockLeft, 下一段 blockLeft)`。
       */
      const lo = (b.blockLeft ?? b.x1) - 1
      const hi = (sortedB[bi + 1]?.blockLeft ?? Number.POSITIVE_INFINITY) - 1
      const lower = p.notes.filter((n) => n.parentY !== undefined && n.x >= lo && n.x < hi)
      if (lower.length === 0) continue
      const contentL = Math.min(...lower.map((n) => n.x))
      /** adj709：内容墨迹右缘 = `x + 逐数字实测墨迹宽`（与引擎 `noteInkRight` 同一口径） */
      const contentR = Math.max(...lower.map((n) => inkRightOfPlaced(n, ns2)))
      const innerL = contentL - (b.x1 + w)
      const innerR = b.x2 - contentR
      const leftNb = Math.max(
        ...p.notes.filter((n) => !n.segment && inkRightOfPlaced(n, ns2) < contentL).map((n) => inkRightOfPlaced(n, ns2)),
        ...p.barlines.filter((x) => !x.segment && x.x < contentL).map((x) => x.x),
        -Infinity,
      )
      const outerL = Number.isFinite(leftNb) ? b.x1 - leftNb : Infinity
      if (innerL < w / 2 - 0.6) bad.push(`左内侧 ${innerL.toFixed(1)} < w/2=${(w / 2).toFixed(1)}`)
      /**
       * 右内侧：包络末音自身可能因"下游邻居把可用宽压到 0"而略微越过内容界
       * （实测 −1.1px，与本轮改动无关，是预留不足时的既有边界情形），
       * 此时括号已贴住内容，允许这一小段溢出；真压字（负得更多）仍会被拦下。
       */
      if (innerR < w / 2 - 1.8) bad.push(`右内侧 ${innerR.toFixed(1)} < w/2=${(w / 2).toFixed(1)}`)
      /**
       * 左外侧：**只在让位区间放得下 `2w` 时才要求 `w/2`**——
       * 行尾/行首的退化情形（`availL < w`，即邻居与内容之间根本放不下一个括号）里，
       * 括号只能贴住一侧，这是"空间不够"的必然结果，不是布局缺陷。
       * `availL` 由布局给出（AGENTS 六之二·4：数值口径同源），断言直接消费。
       */
      const availL = b.availL ?? Infinity
      if (availL >= 2 * w && outerL < w / 2 - 0.6) bad.push(`左外侧 ${outerL.toFixed(1)} < w/2=${(w / 2).toFixed(1)}`)
    }
    check('adj692 大括号与段内容/左邻居的净距均 ≥ `w/2`（两端留白，不压字也不压线）',
      segBrackets.length > 0 && bad.length === 0, bad.join(' | '))
  }
  /**
   * adj693（用户口径）：「临时多声部的**第一声部高度不再压缩，显示为正常高度**」。
   *
   * `{dsb}` 的上层不再压扁（`layerScale = 1` ⇒ 渲染端不加 `<g scale(1,k)>` 包装）；
   * `{bz}` / `{tp}` 仍按"另一层 / 另一遍"压扁到 `SEGMENT_LAYER_YSCALE`（2/3）。
   */
  {
    const upper = p.notes.filter((n) => n.segment?.type === 'dsb')
    check('adj693 `{dsb}` 第一声部**不压扁**（layerScale = 1 ⇒ 正常高度）',
      upper.length > 0 && upper.every((n) => n.layerScale === 1),
      JSON.stringify([...new Set(upper.map((n) => n.layerScale))]))
    const bzSrc = 'V: 1.0\nB: t\nD: C\nP: 4/4\nQ: 1 2 {bz 1 2 3 4 } 5 6 |\n'
    const bzUpper = layoutScore(parseJps(bzSrc), defaultPageConfig).pages[0].notes.filter((n) => n.segment?.type === 'bz')
    check('adj693 对照：`{bz}` 仍压扁到 2/3（既有口径未被牵连）',
      bzUpper.length > 0 && bzUpper.every((n) => Math.abs((n.layerScale ?? 1) - SEGMENT_LAYER_YSCALE) < 1e-9),
      JSON.stringify([...new Set(bzUpper.map((n) => n.layerScale))]))
  }
  /**
   * adj691（用户口径）：「临时多声部大括号的高度**从第一声部上沿到最后一声部下沿止**」。
   *
   * 判据：括号下端 = **最后一个声部（下层）的数字墨迹底 + `0.35×字号` 留白**，
   * 即 `digitBottomY(下层基线) + ns×0.35`，容差 1px。
   *
   * ⚠️ 历史坑：下端曾写 `lowerBaseline + ns × DIGIT_BOTTOM`，而 `DIGIT_BOTTOM = 2` 是**像素常量**
   * （正确用法是 `digitBottomY` = 基线 + `2×s`，s = ns/18），相差 `1.89×ns`
   * （13 号字 ≈ 24.6px）⇒ 括号下端一路伸进歌词行（用户截图）。本断言专门守住这个单位口径。
   */
  {
    const brace = p.segmentBrackets?.find(
      (b) => b.type === 'dsb' && b.braceTop !== undefined && b.braceBottom !== undefined,
    )
    // 本用例的 `{dsb}` 下层声部：包络内的主旋律（带 `parentY`）里 y 最大者
    const lowerNotes = p.notes.filter((n) => n.parentY !== undefined)
    const lowY = lowerNotes.length > 0 ? Math.max(...lowerNotes.map((n) => n.y)) : NaN
    const ns2 = defaultPageConfig.note_size
    /** 下端 = `max(数字墨迹底, 减时线层底) + 0.35×字号`；无减时线的音就落在数字墨迹底 */
    const digitBottom = lowY + 2 * noteScaleOf(ns2)
    const expectBottom = digitBottom + ns2 * 0.35
    check('adj691 大括号下端 = 最后一个声部的**墨迹底 + 0.35×字号**（单位口径正确，不伸进歌词）',
      brace !== undefined &&
        Number.isFinite(lowY) &&
        (brace.braceBottom as number) >= expectBottom - 1 &&
        (brace.braceBottom as number) <= expectBottom + 8,
      JSON.stringify({ braceBottom: brace?.braceBottom, expectBottom, lowY }))
  }
}

/**
 * adj652（用户要求）："允许将预览页面里的链接文本自动转换为链接，点击即可打开链接"。
 *
 * 引擎只产出标记（`<a class="jp-link" data-href="…" target="_blank">`），点击交给宿主
 * （应用 `src/preview/openUrl.ts` / 插件 `src/openExternal.ts`）；这里断言**标记**这一半，
 * 宿主接线另外用源码断言钉住。
 *
 * adj919（用户要求去掉模板与示例谱里的 `S:` 行）：★**样本口径变更**★ ——
 * 原来第 ③ 条渲染断言是拿"**默认新建模板**里那行 `S:`"当样本的（断言名和注释都这么写）。
 * 模板不再含 `S:` 行后，拿模板当样本就**测不到"`S:` 谱尾说明会渲染成可点链接"这个功能**了。
 * ⇒ 按"**换样本、别删功能**"处理：样本改成**本函数里就地构造的最小源码**（`code652`，
 * 自带 `S:` 行 + 官网 URL，与真源文件无关），被测的功能、判据、严格程度一字未改。
 * 好处还多一条：这条从此**不依赖任何真源文件**，谁去改模板/示例谱都不会再莫名其妙地红。
 */
function runAdj652Tests() {
  console.log('[153] 谱面文本里的链接（adj652）')
  const U = 'https://ijipu.pages.dev'
  // ① URL 识别
  check('adj652 识别裸 URL', JSON.stringify(findUrls(U)) === JSON.stringify([{ start: 0, end: 23, url: U, href: U }]),
    JSON.stringify(findUrls(U)))
  check('adj652 句末标点不算 URL 的一部分（`见 https://x.com。`）',
    findUrls('见 https://ijipu.pages.dev。')[0]?.url === U, JSON.stringify(findUrls('见 https://ijipu.pages.dev。')))
  check('adj652 中文书名号/引号包着也能认出（`「爱记谱 https://x」编制`）',
    findUrls('本乐谱使用「爱记谱 https://ijipu.pages.dev」编制')[0]?.url === U, '')
  check('adj652 `www.` 开头自动补 `https://`（只补 `href`，显示文本保持原样）',
    JSON.stringify(findUrls('访问 www.example.com 看看')) ===
      JSON.stringify([{ start: 3, end: 18, url: 'www.example.com', href: 'https://www.example.com' }]),
    JSON.stringify(findUrls('访问 www.example.com 看看')))
  check('adj652 `mailto:` 也认；一行多个 URL 都能抓到',
    findUrls('联系 mailto:me@x.com')[0]?.href === 'mailto:me@x.com' &&
      findUrls('a http://a.com b https://b.cn/c?d=1#e , END').length === 2,
    JSON.stringify(findUrls('a http://a.com b https://b.cn/c?d=1#e , END')))
  check('adj652 没有 URL 时不产生任何锚点（普通文本照旧 XML 转义）',
    findUrls('普通说明').length === 0 && linkifyText('a<b>&"c"') === 'a&lt;b&gt;&amp;&quot;c&quot;',
    linkifyText('a<b>&"c"'))
  // ② 标记形状：class / 绝对 href / data-href / 新窗口 / noopener
  const html = linkifyText('本乐谱使用「爱记谱 ' + U + '」编制')
  check('adj652 产出 `<a class="jp-link" href data-href target="_blank" rel="noopener noreferrer">`',
    /<a class="jp-link" href="https:\/\/ijipu\.pages\.dev" data-href="https:\/\/ijipu\.pages\.dev" target="_blank" rel="noopener noreferrer">/.test(
      html,
    ),
    html)
  check('adj652 前后文字原样保留（`本乐谱使用「爱记谱 ` / `」编制`）',
    html.startsWith('本乐谱使用「爱记谱 <a class="jp-link"') && html.endsWith('</a>」编制'), html)
  // ③ 渲染产物：S: 谱尾说明里那串 URL 就是链接
  //    adj919：样本是**就地构造**的最小源码（自带 `S:` 行），**不读默认模板**——
  //    模板的 `S:` 行按用户要求去掉了，这个功能（`S:` → 可点链接）仍然必须被测。
  const code652 = `V: 1.0\nB: 测试\nD: C\nP: 4/4\nS: 本乐谱使用「爱记谱 ${U}」编制\nQ: 1 2 3 4 |\nC: 这 是 歌 词\n`
  const svg652 = renderScoreToSvg(layoutScore(parseJps(code652), defaultPageConfig))[0]
  const notes652 = /<text data-meta="notes_0"[^>]*>([\s\S]*?)<\/text>/.exec(svg652)
  check('adj652 `S:` 谱尾说明渲染成带链接的 `<text>`（构造的最小源码，那行 URL 可直接点）',
    notes652 !== null && /<a class="jp-link" href="https:\/\/ijipu\.pages\.dev"/.test(notes652[1]),
    notes652 ? notes652[1].slice(0, 120) : '(未找到 notes_0)')
  // ④ **不把 URL 拆到两行**：拆了就是两个半截链接，点哪个都不对
  const longLine = `S: ${'前'.repeat(48)} ${U} ${'后'.repeat(12)}\n`
  const svgWrap652 = renderScoreToSvg(
    layoutScore(parseJps(`V: 1.0\nB: 测试\nD: C\nP: 4/4\n${longLine}Q: 1 2 3 4 |\nC: 这 是 歌 词\n`), defaultPageConfig),
  )[0]
  const subLines652 = [...svgWrap652.matchAll(/<text data-meta="notes_0"[^>]*>([\s\S]*?)<\/text>/g)].map((m) => m[1])
  const anchors652 = [...svgWrap652.matchAll(/<a class="jp-link"[^>]*>([\s\S]*?)<\/a>/g)].map((m) => m[1])
  check('adj652 长行折行时 URL **整体挪到一行**（不是两个半截链接）',
    subLines652.length >= 2 && anchors652.length === 1 && anchors652[0] === U,
    JSON.stringify({ rows: subLines652.length, anchors: anchors652 }))
  // ⑤ 宿主接线：预览层点链接 → 系统浏览器（应用）/ electron.shell（插件）
  const paneSrc652 = String(readFileSync('src/preview/PreviewPane.tsx', 'utf8'))
  const openUrlSrc652 = String(readFileSync('src/preview/openUrl.ts', 'utf8'))
  const css652 = String(readFileSync('src/index.css', 'utf8'))
  check('adj652 预览层拦截 `a.jp-link` 点击（preventDefault + 自己打开，不让 SVG 自己跳）',
    /closest\('a\.jp-link'\)/.test(paneSrc652) && /void openExternalUrl\(/.test(paneSrc652) &&
      paneSrc652.indexOf("closest('a.jp-link')") < paneSrc652.indexOf("closest('[data-notepos]"),
    '')
  check('adj652 桌面壳走 Tauri opener（`plugin:opener|open_url`），浏览器/PWA 退回 `window.open`',
    /plugin:opener\|open_url/.test(openUrlSrc652) && /window\.open\(target, '_blank'/.test(openUrlSrc652) &&
      /__TAURI__/.test(openUrlSrc652),
    '')
  check('adj652 链接样式：可点（手型）+ 下划线（预览 CSS）',
    /\.preview-svg a\.jp-link\s*\{[^}]*cursor:\s*pointer/.test(css652) &&
      /\.preview-svg a\.jp-link\s*\{[^}]*text-decoration:\s*underline/.test(css652),
    '')
  check('adj652 Tauri 侧：`tauri-plugin-opener` 已注册 + 能力里给了 `opener:allow-open-url`',
    /tauri-plugin-opener/.test(String(readFileSync('src-tauri/Cargo.toml', 'utf8'))) &&
      /tauri_plugin_opener::init\(\)/.test(String(readFileSync('src-tauri/src/lib.rs', 'utf8'))) &&
      /opener:allow-open-url/.test(String(readFileSync('src-tauri/capabilities/default.json', 'utf8'))),
    '')
}

/**
 * adj653（用户要求）：**重叠跳房子** `["2.3."` —— 第 2、3 遍**共用**同一段房子；
 * 并随之修掉「同一根线上 `:|` 与 `&ds` 并存时谁优先」（见 `E-2026-343`）。
 *
 * 用户原谱与口径（逐字）：
 *   第一遍：第 1 行 → 第 3 行 `:|` → 回第 1 行 `|:`
 *   第二遍：`|:` → 跳过房子 1（第 2~3 行）→ 第 4 行 `["2.3."` → `:|` → 回 `|:`
 *   第三遍：同第二遍，到 `:|&ds` 跳回第 1 行 `&hs`
 *   第四遍：跳过房子 1 与 `["2.3."` → 奏 `["4."` → `||`
 */
function runAdj653Tests() {
  console.log('[154] 重叠跳房子 ["2.3."]（adj653）')
  const code = `V: 1.0
B: 重 叠 房 子
D: C
P: 4/4
J: 96

Q: 1- 0 1/ 6,/ |:&hs 5 5/ 1/ 2 5,/ 6,/ | 3 3/ 5,/ (2/ 1/) 0/ 6,/ | 6, 5/ 3/ 5/ 3/ 2/ 5/ |
Q: |/["1." 1- 0 &zkh 3/ 5/ | 6. 1'/ 5- |]/ 3/ 2/ 3/ 5/ 6- | 6,/ 5,/ 6,/ 3/ 2/ 3 6,/ | 1-- &ykh 6,/ 1/ |
Q: 5/ 6/ 6/ 1/ 2 1/ 7,/ | 5,/ 6,/ 1/ 2/ 3- | 2/ 3/ 5/ 3/ 2/ 1/ 6,/ (2/ | 1/) 1. 0 1/ 6,/ :|
Q: |/["2.3." 1- 0 1/ 6,/ :|&ds]["4." 1- 0 0/ 5,/ | 6, 6,/ 3/ 2/ 3/ 2/ 6,/ &hx | 1- 0 0 ||]
`
  const parsed = parseJps(code)
  check('adj653 用户原谱可解析且无错误', parsed.errors.length === 0, JSON.stringify(parsed.errors.map((e) => e.message)))
  const seq = buildPlaySequence(parsed, layoutScore(parsed, defaultPageConfig), 60)
  const idx = seq.events.filter((e) => !e.placed.segment).map((e) => e.placed.id.index)
  const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, k) => a + k)
  const expect = [
    ...range(0, 70), // 第 1 遍：第 1 行 → 房子 1（`|]/` 未封闭 ⇒ 延伸到第 3 行 `:|`）
    ...range(4, 23), ...range(71, 74), // 第 2 遍：跳过房子 1 → 房子 ["2.3."
    ...range(4, 23), ...range(71, 74), // 第 3 遍：重叠，再奏一次 ["2.3." → 到 :|&ds 跳 &hs
    ...range(4, 23), ...range(75, 88), // 第 4 遍：跳过房子 1 / 2.3 → 房子 ["4."
  ]
  check('adj653 四遍演奏顺序**逐音符**符合用户口径（153 个事件一一对上）',
    JSON.stringify(idx) === JSON.stringify(expect),
    `实际 ${idx.length} 个事件；期望 ${expect.length} 个`)
  check('adj653 总时长 = 4 遍（108000ms @bpm60）；旧实现第 2 遍就跳花 S ⇒ 只有 3 遍 / 80000ms',
    seq.totalMs === 108000, String(seq.totalMs))
  const times = (v: number) => idx.filter((x) => x === v).length
  check('adj653 房子 1 只在第 1 遍奏（第 2~4 遍都跳过）', times(24) === 1, `首音出现 ${times(24)} 次`)
  check('adj653 `["2.3."` 在第 2、3 两遍**各奏一次**（重叠房子，这是本次新增的规则）',
    times(71) === 2 && times(74) === 2, `首音 ${times(71)} 次 / 末音 ${times(74)} 次`)
  check('adj653 `["4."` 只在第 4 遍奏一次（`&ds` 之后那遍）', times(75) === 1, `首音出现 ${times(75)} 次`)
  // 布局：番号原样显示（`2.3.` 不被当成单号截断/改写）
  const svg653 = renderScoreToSvg(layoutScore(parsed, defaultPageConfig))
  check('adj653 谱面上番号原样显示 `2.3.`（不被截成 `2.`）',
    svg653.some((s) => s.includes('>2.3.</text>')), '')
  /**
   * 同一根线上 `:|` 与 `&ds` 并存：**反复优先**。
   * 最小例：`1- |:&hs 2- 3- :|&ds 4- ||]`——该段 1 个 `:|` ⇒ 2 遍；第 2 遍走到 `:|&ds` 才跳 `&hs`。
   * 期望音符序（源码索引）：0,1,2,1,2,1,2,3（第 1 遍 + 第 2 遍 + D.S. 之后那遍再奏一次）。
   */
  const mini = parseJps('V: 1.0\nB: 小\nD: C\nP: 4/4\nQ: 1- |:&hs 2- 3- :|&ds 4- ||]\n')
  const miniSeq = buildPlaySequence(mini, layoutScore(mini, defaultPageConfig), 60)
  const miniIdx = miniSeq.events.filter((e) => !e.placed.segment).map((e) => e.placed.id.index)
  check('adj653 同一根线上 `:|` 与 `&ds` 并存时**反复优先**（走完 2 遍才跳花 S，旧实现第 1 遍就跳）',
    JSON.stringify(miniIdx) === JSON.stringify([0, 1, 2, 1, 2, 1, 2, 3]),
    JSON.stringify(miniIdx))
  /**
   * adj723u（用户报「什么时候又把播放的反复、跳跃顺序弄乱了」）：
   * **`seq.events` 的 `atMs` 必须单调不减**——这是两处下游逻辑的**共同前提**：
   *  · `adj723f` 的起播回退（"向前扫描取同刻最小下标"）要求**同刻事件在数组里连续**；
   *  · 预览色块 `playheadPosIn()` 用**二分**找"最后一个 `atMs <= currentMs`"的段
   *    （应用侧注释亦写"`atMs` 单调、含反复展开"）。
   *
   * 根因：段层（`{dsb}`/`{bz}`）事件是"跑到主旋律音符时补发"、整段 push 在数组**前面**
   * ⇒ 含 `{dsb}` 时 `atMs` 形如 `0,2000,0,2000,4000…`（**非单调**）⇒ 二分错位 ⇒ 色块来回跳。
   * 修法：`buildPlaySequence` 返回前按 `atMs` **稳定排序**。
   *
   * 用例覆盖两类段型（`dsb`）+ 反复 + 跳跃（AGENTS 六之二·5）。
   */
  for (const [tag, body] of [
    ['{dsb}+反复', 'V: 1.0\nB: t\nD: C\nP: 4/4\nQ: {dsb 1- 2- } 3- 4- |: 5- 6- :| 7- 1\'- ||\n'],
    ['{bz}+D.C.', 'V: 1.0\nB: t\nD: C\nP: 4/4\nQ: {bz 1,- 2,- } 3- 4- |&dc 5- 6- ||\n'],
    ['{dsb}+重叠房子+:|&ds', `V: 1.0\nB: t\nD: C\nP: 4/4\nQ: {dsb 1- 2- } 3- 4- |:&hs 5- 6- :|&ds 7- 1'- ||\n`],
  ] as const) {
    const lay = layoutScore(parseJps(body), defaultPageConfig)
    const sq = buildPlaySequence(parseJps(body), lay, 60)
    const at = sq.events.map((e) => e.atMs)
    let firstDrop = -1
    for (let i = 1; i < at.length; i++) {
      if (at[i] < at[i - 1] - 1e-6) {
        firstDrop = i
        break
      }
    }
    check(`adj723u ${tag}：\`events\` 的 \`atMs\` **单调不减**（色块二分定位的前提）`,
      sq.events.length > 0 && firstDrop < 0,
      firstDrop < 0
        ? `${sq.events.length} 个事件`
        : `首个下降 @${firstDrop}: ${at[firstDrop - 1]} → ${at[firstDrop]}`)
  }
  // 护栏：单号房子行为不变（`["1."` 只第 1 遍、`["2."` 只第 2 遍）——用同一份谱去掉重叠写法对照
  const single = code.replace('["2.3."', '["2."')
  const singleSeq = buildPlaySequence(parseJps(single), layoutScore(parseJps(single), defaultPageConfig), 60)
  const singleIdx = singleSeq.events.filter((e) => !e.placed.segment).map((e) => e.placed.id.index)
  const singleTimes = (v: number) => singleIdx.filter((x) => x === v).length
  check('adj653 护栏：`["2."`（单号）仍然**只在第 2 遍**奏一次，第 3 遍起跳过',
    singleTimes(71) === 1 && singleIdx.length === idx.length - 4, JSON.stringify({ a: singleTimes(71), n: singleIdx.length }))
}

/**
 * adj654（用户报「这段里的 `{tp}` 替谱段对应的歌词显示的乱的」）：
 * 替谱覆盖区里的歌词字要**按先后顺序逐个**对到替谱层的音上。
 *
 * 旧实现按"**拍位覆盖**"配对（还要求 `barIndex` 相同），而替谱层的小节/拍位**是它自己那套坐标系**
 * ——与主旋律同名 `barIndex` 只是数值巧合 ⇒ 配对随机错位（用户谱面实测：`看` 被甩到最右 515px、
 * `一` 被甩到最左 239px，字序被打乱成"一你…"）。
 */
function runAdj654Tests() {
  console.log('[155] 替谱段 {tp} 的歌词对齐（adj654）')
  const code = `V: 1.0
B: 测 试
D: C
P: 4/4

Q: |: 1 0/ 1// 7,// 1 0// 6,// 6,// 7,// | 1/ 7,/ 6,/ (5,/ 5,) &hx 1/ 2/ | 3 1/ 7,/ 6,/ 7,// (1// 1/) 3/ | 2 7,/ 6,/ 5,/# 5/ 3/ 7,/ :|
C1: 沫，@某一刻@你的光照亮了我。@如果说你是遥远的@星河，耀眼得让人想
C2: 歌，@那么我@是想要画你的手。@ {tp 1// 2/. | 3 1/ 7,/ 6,/ 7,/ 1// 3/. | 2 7,/ 6,// (5,//# 5,/) 4/ 3/ 7,/ 1//} 你看我多么渺小一个我，因为你有梦可做，
`
  const parsed = parseJps(code)
  check('adj654 用户谱例可解析且无告警', parsed.errors.length === 0,
    JSON.stringify(parsed.errors.map((e) => `${e.severity}:${e.message}`)))
  const layout = layoutScore(parsed, defaultPageConfig)
  const page = layout.pages[0]
  const tpNotes = page.notes.filter((n) => n.segment?.type === 'tp').sort((a, b) => a.x - b.x)
  const mainNotes = page.notes.filter((n) => !n.segment)
  check('adj654 替谱层 18 个音（3 小节）、C2 那行 28 个字', tpNotes.length === 18 && page.lyrics.filter((c) => c.line === 1).length === 28,
    JSON.stringify({ tp: tpNotes.length, c2: page.lyrics.filter((c) => c.line === 1).length }))
  // 字序：page.lyrics 的存放顺序 = 源码字序（旧实现的乱序是 x 乱，不是数组乱）
  const c2 = page.lyrics.filter((c) => c.line === 1)
  check('adj654 C2 的字面顺序 = 源码字序（歌那么我是想要画你的手你看我多么渺小一个我因为你有梦可做）',
    c2.map((c) => c.char.text).join('') === '歌那么我是想要画你的手你看我多么渺小一个我因为你有梦可做',
    c2.map((c) => c.char.text).join(''))
  const xs = c2.map((c) => c.x)
  check('adj654 **字序 x 单调递增**（旧实现 `看`@515 / `一`@239 会把顺序打乱）',
    xs.every((v, i) => i === 0 || v > xs[i - 1] + 0.5), JSON.stringify(xs.map((v) => Math.round(v))))
  // 逐字落在替谱音上：C2 末尾那 17 个字（替谱覆盖区）依次对上前 17 个替谱音
  const tail = c2.slice(c2.length - 17)
  const diff = tail.map((c, i) => Math.abs(Math.round(c.x) - Math.round(tpNotes[i].x)))
  check('adj654 替谱覆盖区的 17 个字**逐个落在替谱音符上**（|字心 − 音心| ≤ 2px，与主旋律同口径）',
    diff.every((d) => d <= 2), JSON.stringify(diff))
  check('adj654 字与替谱音**一一对应**（第 1 个字配第 1 个音，不是"拍位覆盖"乱配）',
    tail[0].char.text === '你' && Math.abs(tail[0].x - tpNotes[0].x) <= 2 &&
      tail[16].char.text === '做' && Math.abs(tail[16].x - tpNotes[16].x) <= 2,
    JSON.stringify(tail.map((c) => c.char.text).join('')))
  // 护栏：别的歌词行（主旋律那行）不受替谱影响，仍与**主旋律音**对齐
  const c1 = page.lyrics.filter((c) => c.line === 0)
  const c1diff = c1.map((c) => {
    const n = mainNotes.find((m) => m.id.index === c.id.index)
    return n ? Math.abs(Math.round(c.x) - Math.round(n.x)) : 999
  })
  check('adj654 护栏：`C1:` 那行歌词**不受替谱影响**（仍逐字对齐主旋律音）',
